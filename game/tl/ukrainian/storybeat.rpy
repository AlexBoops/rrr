    # pro "Haha yeah."
    pro "Ха-ха так."

# game/storybeat.rpy:2164
translate ukrainian story_beat6_8315f04d:

    # pro "What do you think a romantic relationship with me would look like?"
    pro "Як ти думаєш, як виглядатимуть романтичні стосунки зі мною?"

# game/storybeat.rpy:2166
translate ukrainian story_beat6_3a756f9a:

    # robin "Um... I guess it would involve a lot of kissing and holding hands... stuff like that."
    robin "Гм... Я припускаю, що це включатиме багато поцілунків і тримання за руки... такі речі."

# game/storybeat.rpy:2167
translate ukrainian story_beat6_bcc942c3:

    # pro "That's cute."
    pro "Це мило."

# game/storybeat.rpy:2169
translate ukrainian story_beat6_cffc2b31:

    # robin "I'd want us to be exclusive too..."
    robin "Я хотів би, щоб ми теж були ексклюзивними..."

# game/storybeat.rpy:2170
translate ukrainian story_beat6_1c3a72ce:

    # pro "That makes sense."
    pro "Це має сенс."

# game/storybeat.rpy:2171
translate ukrainian story_beat6_00727c28:

    # pro "What about a friendship with me? What would that look like to you?"
    pro "А як щодо дружби зі мною? Як би це виглядало для вас?"

# game/storybeat.rpy:2172
translate ukrainian story_beat6_48ee1f66:

    # robin "A friendship? Well..."
    robin "Дружба? добре..."

# game/storybeat.rpy:2173
translate ukrainian story_beat6_f90b3ea8:

    # robin "We would just hang out, I guess... and play video games, and stuff..."
    robin "Ми б просто тусувалися, я думаю... і грали у відеоігри, і таке інше..."

# game/storybeat.rpy:2174
translate ukrainian story_beat6_6c637a4d:

    # pro "That's pretty standard."
    pro "Це досить стандартно."

# game/storybeat.rpy:2175
translate ukrainian story_beat6_dabec664:

    # pro "But we do all that already, right?"
    pro "Але ми вже все це робимо, правда?"

# game/storybeat.rpy:2176
translate ukrainian story_beat6_fbe6a5e9_1:

    # robin "Yeah..."
    robin "так..."

# game/storybeat.rpy:2177
translate ukrainian story_beat6_8380a882:

    # pro "What do you think about having sex while we figure things out?"
    pro "Що ти думаєш про секс, поки ми все вирішуємо?"

# game/storybeat.rpy:2178
translate ukrainian story_beat6_c9776b5c:

    # pro "Does that scare you or bother you?"
    pro "Вас це лякає чи турбує?"

# game/storybeat.rpy:2180
translate ukrainian story_beat6_fcdc0159:

    # robin "Not at all... I really like it, actually."
    robin "Зовсім ні... Насправді мені це дуже подобається."

# game/storybeat.rpy:2181
translate ukrainian story_beat6_4c5222e7:

    # robin "The way you make love to me makes me feel wanted..."
    robin "Те, як ти кохаєшся зі мною, змушує мене відчувати себе бажаною..."

# game/storybeat.rpy:2183
translate ukrainian story_beat6_6027082e:

    # robin "And honestly, it makes me feel like... I deserve it, like I deserve to be loved and cherished like that."
    robin "І, чесно кажучи, це змушує мене відчувати, що... я заслуговую цього, ніби я заслуговую на те, щоб мене так любили і плекали."

# game/storybeat.rpy:2184
translate ukrainian story_beat6_6da23113:

    # robin "It's new to me, but I like it y'know?"
    robin "Для мене це нове, але мені подобається, знаєте?"

# game/storybeat.rpy:2185
translate ukrainian story_beat6_c859f3ad:

    # pro "I do know what you mean."
    pro "Я знаю, що ви маєте на увазі."

# game/storybeat.rpy:2187
translate ukrainian story_beat6_3bf08b9a:

    # robin "I really want to keep having sex with you, that's for sure..."
    robin "Я дійсно хочу продовжувати займатися з тобою сексом, це точно..."

# game/storybeat.rpy:2189
translate ukrainian story_beat6_b44ea85d:

    # robin "You make me feel things I didn't even know were possible."
    robin "Ти змушуєш мене відчувати речі, про які я навіть не здогадувався."

# game/storybeat.rpy:2190
translate ukrainian story_beat6_7c77e711:

    # robin "It's hard to put it into words..."
    robin "Це важко передати словами..."

# game/storybeat.rpy:2191
translate ukrainian story_beat6_4ab710ca:

    # pro "So then why is it hard for you to put a label on it?"
    pro "Тоді чому вам важко наклеїти на нього ярлик?"

# game/storybeat.rpy:2192
translate ukrainian story_beat6_f2d4b95b:

    # pro "Why put a label on it at all?"
    pro "Навіщо взагалі наклеювати ярлик?"

# game/storybeat.rpy:2194
translate ukrainian story_beat6_cbb7b812:

    # robin "I don't know..."
    robin "я не знаю..."

# game/storybeat.rpy:2195
translate ukrainian story_beat6_199c2028:

    # robin "I want a label, but if we have something tangible then it means it can also end."
    robin "Я хочу лейбл, але якщо у нас є щось відчутне, це означає, що це також може закінчитися."

# game/storybeat.rpy:2196
translate ukrainian story_beat6_241b5a5e:

    # pro "What do you mean?"
    pro "Що ви маєте на увазі?"

# game/storybeat.rpy:2197
translate ukrainian story_beat6_7f01b5bd:

    # pro "You're afraid if we have a title it can all end, but it can also end without one too, you know?"
    pro "Ти боїшся, що якщо у нас буде титул, усе може закінчитися, але все може закінчитися і без нього, розумієш?"

# game/storybeat.rpy:2198
translate ukrainian story_beat6_5bf0f336:

    # robin "Yes... I'm just..."
    robin "Так... я просто..."

# game/storybeat.rpy:2200
translate ukrainian story_beat6_8a30c806:

    # robin "I guess it just doesn't seem real to me that I can have a happy ending."
    robin "Мені здається нереальним, що я можу мати щасливий кінець."

# game/storybeat.rpy:2201
translate ukrainian story_beat6_240abb13:

    # pro "That doesn't sound like someone who wants to take it slow to me."
    pro "Мені це не схоже на те, хто хоче йти повільно."

# game/storybeat.rpy:2202
translate ukrainian story_beat6_d082c1f9:

    # robin "It's not about taking it slow or anything..."
    robin "Справа не в тому, щоб повільно діяти чи щось інше..."

# game/storybeat.rpy:2203
translate ukrainian story_beat6_0ed9e481:

    # robin "It's about..."
    robin "Йдеться про..."

# game/storybeat.rpy:2204
translate ukrainian story_beat6_ad7938cc:

    # robin "It's about not wanting to lose something that's good."
    robin "Йдеться про те, щоб не хотіти втратити щось хороше."

# game/storybeat.rpy:2205
translate ukrainian story_beat6_3551d047:

    # robin "Something that makes me happy..."
    robin "Щось, що робить мене щасливим..."

# game/storybeat.rpy:2206
translate ukrainian story_beat6_cedc0e57:

    # pro "I get that."
    pro "Я розумію це."

# game/storybeat.rpy:2207
translate ukrainian story_beat6_0e86dad3:

    # robin "I don't want to lose you."
    robin "Я не хочу тебе втратити."

# game/storybeat.rpy:2208
translate ukrainian story_beat6_8f30591d:

    # robin "If we had sex without defining anything... that could be scary, but at least there's a safety net, you know?"
    robin "Якби ми займалися сексом, нічого не визначаючи... це могло б бути страшно, але принаймні є сітка безпеки, розумієш?"

# game/storybeat.rpy:2209
translate ukrainian story_beat6_41dc26ca:

    # robin "There's no risk of getting my heart broken, just... getting my feelings hurt."
    robin "Немає ризику розбити моє серце, просто... завдати болю своїм почуттям."

# game/storybeat.rpy:2211
translate ukrainian story_beat6_a043a5f4:

    # robin "But that's still scary, even if it's less than the other."
    robin "Але це все одно страшно, навіть якщо менше, ніж інше."

# game/storybeat.rpy:2212
translate ukrainian story_beat6_9059f0e6:

    # robin "I've never had a boyfriend... or even a romantic partner."
    robin "У мене ніколи не було хлопця... чи навіть романтичного партнера."

# game/storybeat.rpy:2213
translate ukrainian story_beat6_fb51e802:

    # pro "I understand where you're coming from. Really, I do."
    pro "Я розумію, звідки ти. Дійсно, я так."

# game/storybeat.rpy:2214
translate ukrainian story_beat6_248e7eb2:

    # pro "It sounds like you're really torn between the two."
    pro "Здається, ти справді розриваєшся між ними."

# game/storybeat.rpy:2215
translate ukrainian story_beat6_877f3731:

    # pro "Like, you're trying to weigh the pros and cons and decide what would be the least risky."
    pro "Мовляв, ви намагаєтеся зважити всі «за» і «проти» і вирішити, що буде найменш ризикованим."

# game/storybeat.rpy:2217
translate ukrainian story_beat6_3a761f5b:

    # robin "I don't want to mess up."
    robin "Я не хочу зіпсуватись."

# game/storybeat.rpy:2218
translate ukrainian story_beat6_60e2d1ae:

    # robin "Like, maybe we shouldn't even have sex anymore until we figure this out..."
    robin "Можливо, нам більше не варто займатися сексом, поки ми не розберемося з цим..."

# game/storybeat.rpy:2219
translate ukrainian story_beat6_589be0eb:

    # robin "That might be the best course of action..."
    robin "Можливо, це найкращий спосіб дій..."

# game/storybeat.rpy:2220
translate ukrainian story_beat6_55e8d32f:

    # robin "Then, maybe we can get to know each other better and-"
    robin "Тоді, можливо, ми зможемо краще пізнати один одного і..."

# game/storybeat.rpy:2221
translate ukrainian story_beat6_fc2d0705:

    # pro "Hey, it's okay."
    pro "Гей, все гаразд."

# game/storybeat.rpy:2222
translate ukrainian story_beat6_41d18703:

    # pro "You're being really sweet and trying to protect both of us from getting hurt."
    pro "Ти дуже милий і намагаєшся захистити нас обох від травм."

# game/storybeat.rpy:2223
translate ukrainian story_beat6_5abecd56:

    # pro "That's something I really appreciate and love about you."
    pro "Це те, що я дійсно ціную і люблю в тобі."

# game/storybeat.rpy:2224
translate ukrainian story_beat6_0befbe11:

    # pro "But, I also think you're putting too much pressure on yourself to make a decision."
    pro "Але я також вважаю, що ти занадто тиснеш на себе, щоб прийняти рішення."

# game/storybeat.rpy:2225
translate ukrainian story_beat6_eebfe0f4:

    # robin "How so?"
    robin "Як так?"

# game/storybeat.rpy:2226
translate ukrainian story_beat6_4531aa45:

    # pro "I mean... you're already feeling anxious and stressed out about this, aren't you?"
    pro "Я маю на увазі... ти вже відчуваєш тривогу та стрес через це, чи не так?"

# game/storybeat.rpy:2227
translate ukrainian story_beat6_eeb1fbd4:

    # pro "And that's not good. That's going to lead to an unhappy decision, regardless of which path you choose."
    pro "І це недобре. Це призведе до невдалого рішення, незалежно від того, який шлях ви оберете."

# game/storybeat.rpy:2228
translate ukrainian story_beat6_af6d63ea:

    # robin "But what else can I do..."
    robin "Але що ще я можу зробити..."

# game/storybeat.rpy:2229
translate ukrainian story_beat6_1ed9ea77:

    # pro "Well, I think it's important for you to take the time to think things through."
    pro "Що ж, я вважаю, що для вас важливо знайти час, щоб усе обдумати."

# game/storybeat.rpy:2230
translate ukrainian story_beat6_b672c8ca:

    # pro "Take the time to figure out what's best for you."
    pro "Знайдіть час, щоб зрозуміти, що для вас найкраще."

# game/storybeat.rpy:2231
translate ukrainian story_beat6_b378fd1a:

    # pro "And... I want to help you with that, too."
    pro "І... я теж хочу тобі в цьому допомогти."

# game/storybeat.rpy:2233
translate ukrainian story_beat6_0385e187:

    # robin "You do?"
    robin "Ви робите?"

# game/storybeat.rpy:2234
translate ukrainian story_beat6_9ac09d66:

    # pro "Of course..."
    pro "звичайно..."

# game/storybeat.rpy:2235
translate ukrainian story_beat6_e65efcc8:

    # pro "Let me take care of you Robin."
    pro "Дозволь мені подбати про тебе, Робін."

# game/storybeat.rpy:2236
translate ukrainian story_beat6_091d683a:

    # pro "Let me love you and show you how wonderful it can be."
    pro "Дозволь мені любити тебе і показати тобі, наскільки це чудово."

# game/storybeat.rpy:2237
translate ukrainian story_beat6_3fd36189:

    # robin "B-but how?"
    robin "Б-але як?"

# game/storybeat.rpy:2239
translate ukrainian story_beat6_7c844f3d:

    # pro "You said you didn't want to have any more sex until we figured things out, right?"
    pro "Ти сказав, що більше не хочеш займатися сексом, поки ми не розберемося, так?"

# game/storybeat.rpy:2240
translate ukrainian story_beat6_a99ed122:

    # pro "That means you've already chosen your answer, haven't you?"
    pro "Це означає, що ви вже вибрали відповідь, чи не так?"

# game/storybeat.rpy:2241
translate ukrainian story_beat6_9f2551cd:

    # pro "You've just chosen the harder option to avoid taking a leap of faith."
    pro "Ви щойно вибрали важчий варіант, щоб уникнути стрибка віри."

# game/storybeat.rpy:2242
translate ukrainian story_beat6_9e97e6cb:

    # pro "But you need to understand that there are no right answers, only the answers that are right for us."
    pro "Але ви повинні розуміти, що немає правильних відповідей, є лише відповіді, які підходять нам."

# game/storybeat.rpy:2243
translate ukrainian story_beat6_190031a7:

    # pro "I'm not trying to pressure you into a relationship, but I think it would be good for both of us to give it a try."
    pro "Я не намагаюся спонукати вас до стосунків, але я думаю, що нам обом було б добре спробувати."

# game/storybeat.rpy:2244
translate ukrainian story_beat6_93e9dc11:

    # pro "We can go as slow or as fast as you want, I'm not in a rush either."
    pro "Ми можемо йти так повільно чи так швидко, як вам заманеться, я теж не поспішаю."

# game/storybeat.rpy:2245
translate ukrainian story_beat6_46a65d19:

    # pro "But if you want to take a risk, and you want to try for a happy ending, then I think it's worth taking a leap of faith."
    pro "Але якщо ви хочете ризикнути, і ви хочете спробувати щасливий кінець, то я думаю, що варто зробити стрибок віри."

# game/storybeat.rpy:2246
translate ukrainian story_beat6_a1ba2e62:

    # pro "I'll catch you. I'll be there for you."
    pro "Я вас спіймаю. Я буду поруч з тобою."

# game/storybeat.rpy:2247
translate ukrainian story_beat6_7bd462e9:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2248
translate ukrainian story_beat6_531cbf7d:

    # robin "Okay..."
    robin "гаразд..."

# game/storybeat.rpy:2249
translate ukrainian story_beat6_2920f75f:

    # pro "Okay?"
    pro "гаразд"

# game/storybeat.rpy:2250
translate ukrainian story_beat6_5b527369:

    # pro "What's okay?"
    pro "Що нормально?"

# game/storybeat.rpy:2252
translate ukrainian story_beat6_4b973700:

    # robin "Let's do it..."
    robin "Давайте зробимо це..."

# game/storybeat.rpy:2253
translate ukrainian story_beat6_0a1bdcaf:

    # robin "I'm willing to try."
    robin "Я готовий спробувати."

# game/storybeat.rpy:2254
translate ukrainian story_beat6_05d819c8:

    # robin "You're right. There's no use in worrying about it."
    robin "Ви маєте рацію. Немає сенсу хвилюватися про це."

# game/storybeat.rpy:2255
translate ukrainian story_beat6_79c95fa9:

    # robin "I just have to have a little courage."
    robin "Мені просто потрібно набратися трохи сміливості."

# game/storybeat.rpy:2256
translate ukrainian story_beat6_c5e6dd3b:

    # robin "If we're meant to be, we're meant to be, and if we're not then we can move on without hurting each other."
    robin "Якщо нам судилося бути, ми повинні бути, а якщо ні, ми можемо йти далі, не завдаючи один одному шкоди."

# game/storybeat.rpy:2257
translate ukrainian story_beat6_7017fd2a:

    # pro "I'm so proud of you, Robin."
    pro "Я так пишаюся тобою, Робін."

# game/storybeat.rpy:2258
translate ukrainian story_beat6_84762869:

    # pro "This is a big step for you, and I'm glad that we can do this together."
    pro "Це великий крок для вас, і я радий, що ми можемо зробити це разом."

# game/storybeat.rpy:2259
translate ukrainian story_beat6_78b2f91d:

    # robin "Yeah, it's kind of scary, but I'm excited."
    robin "Так, це трохи страшно, але я схвильований."

# game/storybeat.rpy:2260
translate ukrainian story_beat6_0c67d249:

    # robin "I've never been this close with someone before, it feels nice."
    robin "Я ніколи раніше не був з кимось таким близьким, це приємно."

# game/storybeat.rpy:2261
translate ukrainian story_beat6_17a73ef9:

    # "I still feel like he's unsure..."
    "Я все ще відчуваю, що він не впевнений..."

# game/storybeat.rpy:2262
translate ukrainian story_beat6_e68f4459:

    # "Maybe he doesn't know how devoted I am to him... how much I want this to work."
    "Можливо, він не знає, наскільки я йому віддана... як сильно я хочу, щоб це спрацювало."

# game/storybeat.rpy:2263
translate ukrainian story_beat6_9fa56461:

    # "Maybe I should just..."
    "Можливо, мені варто просто..."

# game/storybeat.rpy:2265
translate ukrainian story_beat6_c282c949:

    # pro "Hey, Robin?"
    pro "Гей, Робін?"

# game/storybeat.rpy:2267
translate ukrainian story_beat6_51813b74:

    # robin "Yeah?"
    robin "так?"

# game/storybeat.rpy:2268
translate ukrainian story_beat6_a59ba08c:

    # pro "I..."
    pro "я..."

# game/storybeat.rpy:2269
translate ukrainian story_beat6_c29f95ca:

    # pro "I love-"
    pro "я люблю-"

# game/storybeat.rpy:2272
translate ukrainian story_beat6_2ebe7057:

    # "Before the words can leave my mouth, I hear a loud pounding on the front door."
    "Не встигаючи слова покинути мої уста, як я чую гучний стукіт у вхідні двері."

# game/storybeat.rpy:2273
translate ukrainian story_beat6_ffc4e12a:

    # robin "EEH!"
    robin "ЕЕХ!"

# game/storybeat.rpy:2274
translate ukrainian story_beat6_39166dcf:

    # pro "Who is that..."
    pro "Хто це..."

# game/storybeat.rpy:2276
translate ukrainian story_beat6_fe839abf:

    # "I go to the front door and check through the peephole."
    "Підходжу до вхідних дверей і перевіряю в вічко."

# game/storybeat.rpy:2277
translate ukrainian story_beat6_9dcd2c29:

    # pro "Hm, there's nobody there..."
    pro "Хм, там нікого..."

# game/storybeat.rpy:2278
translate ukrainian story_beat6_195626ba:

    # robin "W-what..."
    robin "Ч-що..."

# game/storybeat.rpy:2279
translate ukrainian story_beat6_a6aa8850:

    # pro "Weird..."
    pro "Дивно..."

# game/storybeat.rpy:2282
translate ukrainian story_beat6_bea6f56b:

    # "I open the door and look around, but there is nobody there."
    "Відчиняю двері, озираюся, але нікого немає."

# game/storybeat.rpy:2283
translate ukrainian story_beat6_89a2d431:

    # robin "Whats that..."
    robin "Що це..."

# game/storybeat.rpy:2284
translate ukrainian story_beat6_e9143e8b:

    # "I look down and see a note."
    "Я дивлюся вниз і бачу записку."

# game/storybeat.rpy:2285
translate ukrainian story_beat6_7278c67b:

    # pro "What the fuck..."
    pro "Що за біса..."

# game/storybeat.rpy:2287
translate ukrainian story_beat6_d9773b9d:

    # "I bend down and pick it up."
    "Я нахиляюся і піднімаю його."

# game/storybeat.rpy:2288
translate ukrainian story_beat6_de8b4b67:

    # pro "This is..."
    pro "Це..."

# game/storybeat.rpy:2289
translate ukrainian story_beat6_ef4d91be:

    # pro "A note addressed to Robin..."
    pro "Записка, адресована Робіну..."

