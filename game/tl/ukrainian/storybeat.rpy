# game/storybeat.rpy:1092
translate ukrainian story_beat3_17e44e10:

    # pro "Jesus fucking Christ."
    pro "Ісус Христос."

# game/storybeat.rpy:1093
translate ukrainian story_beat3_cce5a599:

    # pro "Did you call the cops?"
    pro "Ви викликали поліцію?"

# game/storybeat.rpy:1094
translate ukrainian story_beat3_13f66967:

    # robin "No, I couldn't."
    robin "Ні, я не міг."

# game/storybeat.rpy:1095
translate ukrainian story_beat3_99d7f078:

    # robin "He threatened to tell everyone where I lived and..."
    robin "Він погрожував розповісти всім, де я живу і..."

# game/storybeat.rpy:1096
translate ukrainian story_beat3_cd6e7200:

    # robin "I didn't want to risk it."
    robin "Я не хотів ризикувати."

# game/storybeat.rpy:1099
translate ukrainian story_beat3_08898ad9:

    # pro "Oh my god, Robin..."
    pro "Боже мій, Робін..."

# game/storybeat.rpy:1100
translate ukrainian story_beat3_0eb0f0f7:

    # pro "That's horrible, I'm so sorry."
    pro "Це жахливо, мені дуже шкода."

# game/storybeat.rpy:1103
translate ukrainian story_beat3_f81922f9:

    # robin "It's okay, I just..."
    robin "Все гаразд, я просто..."

# game/storybeat.rpy:1104
translate ukrainian story_beat3_4342c269:

    # robin "I had to get out of there."
    robin "Мені довелося вибратися звідти."

# game/storybeat.rpy:1105
translate ukrainian story_beat3_af3a8aec:

    # robin "That's why I came here."
    robin "Ось чому я прийшов сюди."

# game/storybeat.rpy:1108
translate ukrainian story_beat3_9f244daa:

    # robin "I figured it would be a smaller town, and nobody would bother me."
    robin "Я думав, що це буде менше місто, і ніхто мене не турбуватиме."

# game/storybeat.rpy:1109
translate ukrainian story_beat3_010bc1b8:

    # pro "I'm so sorry you had to go through that, Robin."
    pro "Мені дуже шкода, що тобі довелося через це пройти, Робін."

# game/storybeat.rpy:1110
translate ukrainian story_beat3_6ae03e37:

    # pro "No one should ever have to go through that."
    pro "Нікому ніколи не доведеться проходити через це."

# game/storybeat.rpy:1111
translate ukrainian story_beat3_1c5043fa:

    # robin "It's fine, really."
    robin "Це добре, справді."

# game/storybeat.rpy:1112
translate ukrainian story_beat3_8d0fa7f5:

    # robin "It's kind of nice getting it off my chest..."
    robin "Якось приємно знімати це з грудей..."

# game/storybeat.rpy:1113
translate ukrainian story_beat3_17c9c130:

    # robin "I just hate being..."
    robin "Я просто ненавиджу бути..."

# game/storybeat.rpy:1114
translate ukrainian story_beat3_f1fe2452:

    # robin "So weak."
    robin "Такий слабкий."

# game/storybeat.rpy:1118
translate ukrainian story_beat3_cbb7b812:

    # robin "I don't know..."
    robin "я не знаю..."

# game/storybeat.rpy:1119
translate ukrainian story_beat3_fd49e948:

    # robin "I'm just worried that the stalker will eventually find me again..."
    robin "Я просто хвилююся, що сталкер зрештою знову знайде мене..."

# game/storybeat.rpy:1120
translate ukrainian story_beat3_c413cfa0:

    # robin "And that if he does, I won't be able to get away."
    robin "І якщо він це зробить, я не зможу втекти."

# game/storybeat.rpy:1123
translate ukrainian story_beat3_27f13eb3:

    # pro "Robin, I'll protect you."
    pro "Робін, я захищатиму тебе."

# game/storybeat.rpy:1124
translate ukrainian story_beat3_cfe2a155:

    # pro "If the stalker or anyone else comes after you, I'll be there."
    pro "Якщо сталкер або хтось інший прийде за тобою, я буду поруч."

# game/storybeat.rpy:1125
translate ukrainian story_beat3_dc6a7198:

    # robin "I..."
    robin "я..."

# game/storybeat.rpy:1127
translate ukrainian story_beat3_02747ec1:

    # robin "That means a lot to me, thank you."
    robin "Це багато для мене означає, дякую."

# game/storybeat.rpy:1129
translate ukrainian story_beat3_315bc637:

    # system "Robin {color=#918fff}trusts{/color} you a {color=#8AFF59}little bit{/color} more now."
    system "Тепер Робін {color=#918fff}довіряє{/color} вам {color=#8AFF59}трохи{/color} більше."

# game/storybeat.rpy:1134
translate ukrainian story_beat3_6846f444:

    # "I want to hug him."
    "Я хочу його обійняти."

# game/storybeat.rpy:1135
translate ukrainian story_beat3_d1f38b56:

    # "I want to hold him and tell him that everything will be okay."
    "Я хочу обійняти його і сказати йому, що все буде добре."

# game/storybeat.rpy:1136
translate ukrainian story_beat3_e246420e:

    # robin "Um..."
    robin "Гм..."

# game/storybeat.rpy:1137
translate ukrainian story_beat3_8e078ddb:

    # robin "I'm kind of tired, so if you want to go back that's fine."
    robin "Я трохи втомився, тому, якщо ти хочеш повернутися, це добре."

# game/storybeat.rpy:1138
translate ukrainian story_beat3_2b31c75a:

    # pro "Oh, right."
    pro "О, правильно."

# game/storybeat.rpy:1139
translate ukrainian story_beat3_93d5acac:

    # pro "Yeah, we should definitely go back."
    pro "Так, ми точно повинні повернутися."

# game/storybeat.rpy:1140
translate ukrainian story_beat3_1c380cc3:

    # robin "Okay, let's pack up and go."
    robin "Гаразд, збираймо речі та їдьмо."

# game/storybeat.rpy:1142
translate ukrainian story_beat3_2bffde70:

    # robin "Thanks for listening and letting me talk about this."
    robin "Дякую, що вислухали та дозволили мені поговорити про це."

# game/storybeat.rpy:1144
translate ukrainian story_beat3_cbf3d343:

    # "We pack up and head back to the car."
    "Збираємо речі та повертаємось до машини."

# game/storybeat.rpy:1145
translate ukrainian story_beat3_7d12e478:

    # robin "This was a good day, wasn't it?"
    robin "Це був хороший день, чи не так?"

# game/storybeat.rpy:1146
translate ukrainian story_beat3_677d0104:

    # pro "Definitely, one of the best days we've had."
    pro "Безперечно, один із найкращих днів, які ми мали."

# game/storybeat.rpy:1147
translate ukrainian story_beat3_a5ac5a61:

    # robin "Yeah, I'm glad I decided to come here."
    robin "Так, я радий, що вирішив приїхати сюди."

# game/storybeat.rpy:1148
translate ukrainian story_beat3_5082b2c1:

    # "I'm glad he came here."
    "Я радий, що він прийшов сюди."

# game/storybeat.rpy:1149
translate ukrainian story_beat3_f9dff4cb:

    # "We drive back, the radio playing softly in the background."
    "Ми їдемо назад, на тлі тихо грає радіо."

# game/storybeat.rpy:1150
translate ukrainian story_beat3_1aeb4c2b:

    # "I'm still processing what Robin told me."
    "Я все ще обробляю те, що мені сказав Робін."

# game/storybeat.rpy:1151
translate ukrainian story_beat3_eff7bc22:

    # "God, what a fucking asshole."
    "Боже, який довбаний мудак."

# game/storybeat.rpy:1152
translate ukrainian story_beat3_3b4179f0:

    # "I can't believe someone would do that to him."
    "Я не можу повірити, що хтось зробив би це з ним."

# game/storybeat.rpy:1153
translate ukrainian story_beat3_7052fe1a:

    # "Robin is so sweet and innocent, it makes me sick to think that people would prey on him like that."
    "Робін такий милий і невинний, що мене нудить від думки, що люди так на нього полюють."

# game/storybeat.rpy:1154
translate ukrainian story_beat3_c870ddbb:

    # "I need to protect him."
    "Мені потрібно його захистити."

# game/storybeat.rpy:1156
translate ukrainian story_beat3_c33f0da3:

    # "After a short drive, we arrive home and head inside our apartment."
    "Після короткої їзди ми приїжджаємо додому та йдемо до нашої квартири."

# game/storybeat.rpy:1158
translate ukrainian story_beat3_af480cf8:

    # robin "Well, I'm going to take a shower and then head to bed."
    robin "Ну, я збираюся прийняти душ, а потім піду спати."

# game/storybeat.rpy:1159
translate ukrainian story_beat3_f241d8fd:

    # robin "Today was a lot of fun, thanks again for everything."
    robin "Сьогодні було дуже весело, ще раз дякую за все."

# game/storybeat.rpy:1160
translate ukrainian story_beat3_c4b65fe1:

    # pro "Of course, I'm glad we got to spend the day together."
    pro "Звичайно, я радий, що ми провели день разом."

# game/storybeat.rpy:1161
translate ukrainian story_beat3_1c7aa342:

    # robin "Me too, goodnight."
    robin "Я теж добраніч."

# game/storybeat.rpy:1162
translate ukrainian story_beat3_44d8b4ac:

    # pro "Goodnight."
    pro "на добраніч"

# game/storybeat.rpy:1164
translate ukrainian story_beat3_5ab325d5:

    # "I watch him walk into the bathroom and hear the shower turn on."
    "Я дивлюся, як він заходить у ванну кімнату, і чую, як увімкнувся душ."

# game/storybeat.rpy:1166
translate ukrainian story_beat3_419d1b09:

    # "I enter my room and pass out immediately after I lay down on my bed."
    "Я входжу в свою кімнату і втрачаю свідомість одразу після того, як лягаю на ліжко."

# game/storybeat.rpy:1167
translate ukrainian story_beat3_d2b847d3:

    # "Today was fun but exhausting."
    "Сьогодні було весело, але виснажливо."

# game/storybeat.rpy:1172
translate ukrainian story_beat3_17b738de:

    # system "{color=#FF5454}Progression Level{/color} has increased"
    system "{color=#FF5454}Рівень прогресу{/color} підвищився"

# game/storybeat.rpy:1190
translate ukrainian story_beat4_aa0d0ae2:

    # "Fuck, there's a really bad thunderstorm outside..."
    "Бля, надворі сильна гроза..."

# game/storybeat.rpy:1191
translate ukrainian story_beat4_9526ab0f:

    # "I'm sitting at my desk, trying to focus on my work, but the lights keep flickering."
    "Я сиджу за своїм столом, намагаючись зосередитися на своїй роботі, але світло продовжує мерехтіти."

# game/storybeat.rpy:1192
translate ukrainian story_beat4_2cb73df8:

    # pro "What if the power goes out...?"
    pro "А якщо вимкнеться електрика...?"

# game/storybeat.rpy:1193
translate ukrainian story_beat4_fc3f0bec:

    # pro "Honestly I'm not even going to risk this..."
    pro "Чесно кажучи, я навіть не збираюся цим ризикувати..."

# game/storybeat.rpy:1194
translate ukrainian story_beat4_49178709:

    # "I turn off my computer and unplug it from the outlets to prevent a sudden power surge."
    "Я вимикаю комп’ютер і від’єдную його від розетки, щоб запобігти раптовому стрибку напруги."

# game/storybeat.rpy:1195
translate ukrainian story_beat4_f599b714:

    # pro "I guess if I can't do work, I could try chilling in the living room..."
    pro "Гадаю, якщо я не можу працювати, я міг би спробувати відпочити у вітальні..."

# game/storybeat.rpy:1197
translate ukrainian story_beat4_7a3e8f69:

    # "I leave my room and see Robin already sitting on the couch."
    "Я виходжу зі своєї кімнати і бачу, як Робін уже сидить на дивані."

# game/storybeat.rpy:1199
translate ukrainian story_beat4_24394ad0:

    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "Гей, цей шторм справді починає наростати, а..."

# game/storybeat.rpy:1200
translate ukrainian story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "Так, там, безумовно, дуже погано."

# game/storybeat.rpy:1201
translate ukrainian story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "як ти тримаєшся"

# game/storybeat.rpy:1202
translate ukrainian story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "Я в порядку, просто не хотів бути замкненим у своїй кімнаті, якщо вимкнеться електрика..."

# game/storybeat.rpy:1203
translate ukrainian story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "Ах, у мене була така сама ідея."

# game/storybeat.rpy:1204
translate ukrainian story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "Ми все одно не можемо щось зробити, чи не так?"

# game/storybeat.rpy:1206
translate ukrainian story_beat4_64a8ddb7:

    # robin "Well, at least it gives us a chance to hang out together."
    robin "Ну, принаймні, це дає нам можливість тусуватися разом."

# game/storybeat.rpy:1207
translate ukrainian story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "Не проти, якщо я сяду з тобою?"

# game/storybeat.rpy:1208
translate ukrainian story_beat4_b4dcea1a:

    # robin "Not at all, go ahead."
    robin "Зовсім ні, давай."

# game/storybeat.rpy:1210
translate ukrainian story_beat4_8f6120d3:

    # "I plop down on the couch next to Robin and get comfortable."
    "Я плюхнувся на диван біля Робін і влаштувався зручніше."

# game/storybeat.rpy:1212
translate ukrainian story_beat4_9d413682:

    # robin "So, do you think the power is going to go out?"
    robin "Отже, ви думаєте, що електроенергія вимкнеться?"

# game/storybeat.rpy:1214
translate ukrainian story_beat4_94a704f7:

    # pro "Considering the way this storm is going, it's likely."
    pro "Враховуючи те, як йде цей шторм, це ймовірно."

# game/storybeat.rpy:1216
translate ukrainian story_beat4_7d0ca308:

    # robin "Hopefully not for long, though..."
    robin "Сподіваюся, ненадовго, але..."

# game/storybeat.rpy:1217
translate ukrainian story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "У вас є свічки чи ліхтарики?"

# game/storybeat.rpy:1219
translate ukrainian story_beat4_7590b815:

    # pro "Nope..."
    pro "ні..."

# game/storybeat.rpy:1220
translate ukrainian story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "Але в квартирі є один або два резервних світильника, які підключені до генератора."

# game/storybeat.rpy:1221
translate ukrainian story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "Навіть якщо вимкнеться електрика, у нас має бути світло, доки воно знову не засвітиться."

# game/storybeat.rpy:1223
translate ukrainian story_beat4_9546838f:

    # robin "That's good..."
    robin "це добре..."

# game/storybeat.rpy:1224
translate ukrainian story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "Знаєш, останнім часом я про щось думав."

# game/storybeat.rpy:1226
translate ukrainian story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "о? Що це?"

# game/storybeat.rpy:1228
translate ukrainian story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "Ну, гм... можливо, зараз саме час запитати вас про це, оскільки ми вже розмовляємо."

# game/storybeat.rpy:1230
translate ukrainian story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "Ага, що саме ви маєте на увазі?"

# game/storybeat.rpy:1232
translate ukrainian story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "Пам'ятаєте, як я розповідав вам про того сталкера на моєму старому місці..."

# game/storybeat.rpy:1233
translate ukrainian story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "Знаєте, під час пляжної подорожі."

# game/storybeat.rpy:1235
translate ukrainian story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "Звичайно пам'ятаю. Ви бачили його тут чи що?"

# game/storybeat.rpy:1237
translate ukrainian story_beat4_fcb99189:

    # robin "No, but..."
    robin "Ні, але..."

# game/storybeat.rpy:1238
translate ukrainian story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "Того вечора я почув, як хтось постукав у двері нашої квартири."

# game/storybeat.rpy:1240
translate ukrainian story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "Що за біса?"

# game/storybeat.rpy:1241
translate ukrainian story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "Ви подивилися на них?"

# game/storybeat.rpy:1243
translate ukrainian story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "Ні, але я був дуже наляканий."

# game/storybeat.rpy:1244
translate ukrainian story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "А якщо це той самий хлопець?"

# game/storybeat.rpy:1245
translate ukrainian story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "Що, якби він зміг мене знайти, і він просто..."

# game/storybeat.rpy:1247
translate ukrainian story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "Гей, все гаразд."

# game/storybeat.rpy:1248
translate ukrainian story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "Навіть якщо це він, я буду тут, щоб захистити вас."

# game/storybeat.rpy:1253
translate ukrainian story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "Але що, якщо він приведе з собою інших?"

# game/storybeat.rpy:1258
translate ukrainian story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "Або намагається силою проникнути в нашу квартиру?"

# game/storybeat.rpy:1263
translate ukrainian story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "Гей, повільніше, Робін..."

# game/storybeat.rpy:1264
translate ukrainian story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "Я обіцяю, що цього не станеться."

# game/storybeat.rpy:1265
translate ukrainian story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "Вони не знають, що ти тут живеш..."

# game/storybeat.rpy:1266
translate ukrainian story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "І я теж тут, я тебе захищатиму."

# game/storybeat.rpy:1268
translate ukrainian story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "Він дивиться на мене і посміхається."

# game/storybeat.rpy:1269
translate ukrainian story_beat4_531cbf7d:

    # robin "Okay..."
    robin "гаразд..."

# game/storybeat.rpy:1273
translate ukrainian story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "Раптом у кімнаті стає темно."

# game/storybeat.rpy:1276
translate ukrainian story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "Я відчуваю, як Робін хапає мене за груди й падає на мене."

# game/storybeat.rpy:1277
translate ukrainian story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "Боже мій, пропала електрика!"

# game/storybeat.rpy:1279
translate ukrainian story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "Він тремтить. Я відчуваю, як його серце калатає в моїх грудях."

# game/storybeat.rpy:1280
translate ukrainian story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "Все гаразд, Робін. Я прямо тут."

# game/storybeat.rpy:1284
translate ukrainian story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "Через кілька секунд включається резервний генератор і вмикається тьмяне світло над диваном."

# game/storybeat.rpy:1285
translate ukrainian story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "Р-робін..."

# game/storybeat.rpy:1286
translate ukrainian story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "Він усе ще стискає мою сорочку, дихає важко й панічно."

# game/storybeat.rpy:1287
translate ukrainian story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "Вибачте, я просто..."

# game/storybeat.rpy:1288
translate ukrainian story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "Я не люблю бути в темряві."

# game/storybeat.rpy:1289
translate ukrainian story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "Гей, все гаразд. Ти в безпеці, гаразд?"

# game/storybeat.rpy:1290
translate ukrainian story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "Я не дозволю, щоб з тобою трапилося щось погане, я обіцяю."

# game/storybeat.rpy:1291
translate ukrainian story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "Я відчуваю, як його тіло повільно розслабляється, поки він звикає до тьмяного світла."

# game/storybeat.rpy:1292
translate ukrainian story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "Нічого страшного, нам просто потрібно почекати, поки живлення відновиться."

# game/storybeat.rpy:1293
translate ukrainian story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "П-вибач, що я так впав на тебе..."

# game/storybeat.rpy:1294
translate ukrainian story_beat4_af94f9cb:

    # pro "No worries..."
    pro "Нічого страшного..."

# game/storybeat.rpy:1297
translate ukrainian story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "Він повільно відривається від мене і знову сідає."

# game/storybeat.rpy:1301
translate ukrainian story_beat4_294c5cbd:

    # "Robin looks so scared."
    "Робін виглядає таким наляканим."

# game/storybeat.rpy:1302
translate ukrainian story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "Його обличчя бліде і він трохи тремтить."

# game/storybeat.rpy:1303
translate ukrainian story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "Гей, все гаразд."

# game/storybeat.rpy:1304
translate ukrainian story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "Я впевнений, що електроенергія скоро відновиться."

# game/storybeat.rpy:1305
translate ukrainian story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "І пам'ятайте, я тут, з вами."

# game/storybeat.rpy:1306
translate ukrainian story_beat4_052f66f1:

    # robin "It's just..."
    robin "Це просто..."

# game/storybeat.rpy:1307
translate ukrainian story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "Стукіт у двері тієї ночі... здавалося, що я знову залишився наодинці з тим сталкером."

# game/storybeat.rpy:1309
translate ukrainian story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "Це звучить тупо, але я так відчуваю..."

# game/storybeat.rpy:1311
translate ukrainian story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "Це не тупо, Робін. Ви маєте повне право боятися."

# game/storybeat.rpy:1312
translate ukrainian story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "Цей досвід був справді травматичним, і ви все ще його обробляєте."

# game/storybeat.rpy:1313
translate ukrainian story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "Просто знай, що я тут для тебе, гаразд?"

# game/storybeat.rpy:1314
translate ukrainian story_beat4_425b462e:

    # robin "Right..."
    robin "правильно..."

# game/storybeat.rpy:1315
translate ukrainian story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "Що ти зазвичай робиш, коли тебе щось лякає?"

# game/storybeat.rpy:1316
translate ukrainian story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "Гадаю, я просто намагаюся відволіктися."

# game/storybeat.rpy:1317
translate ukrainian story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "Подивіться телевізор, пограйте у відеогру чи щось інше."

# game/storybeat.rpy:1318
translate ukrainian story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "Це те, що я зараз не можу зробити..."

# game/storybeat.rpy:1320
translate ukrainian story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "Хочете замість цього просто поговорити? Можливо, це допоможе мені трохи заспокоїтися."

# game/storybeat.rpy:1322
translate ukrainian story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "Звичайно, про що ти хочеш поговорити?"

# game/storybeat.rpy:1323
translate ukrainian story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "Ну, ми могли б говорити про все, що завгодно."

# game/storybeat.rpy:1324
translate ukrainian story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "Як щодо... наших планів на майбутнє?"

# game/storybeat.rpy:1325
translate ukrainian story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "Наші плани на майбутнє?"

# game/storybeat.rpy:1326
translate ukrainian story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "Так, де ми бачимо себе через рік чи два."

# game/storybeat.rpy:1327
translate ukrainian story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "Я можу піти першим, якщо хочеш."

# game/storybeat.rpy:1328
translate ukrainian story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "гаразд..."

# game/storybeat.rpy:1329
translate ukrainian story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "Ну, як ви знаєте, я інді-розробник ігор."

# game/storybeat.rpy:1330
translate ukrainian story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "Я сподіваюся, що перша версія мого проекту буде випущена до кінця цього року."

# game/storybeat.rpy:1331
translate ukrainian story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "Якщо все піде добре, я, сподіваюся, зможу дозволити собі орендувати студію, де я зможу найняти команду, яка допоможе мені робити мої ігри!"

# game/storybeat.rpy:1333
translate ukrainian story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "Ого, це справді амбітно!"

# game/storybeat.rpy:1334
translate ukrainian story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "Так, але я працював над цією грою протягом тривалого часу, тож дуже приємно бачити, як вона реалізується."

# game/storybeat.rpy:1335
translate ukrainian story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "Це так круто, я в захваті за вас."

# game/storybeat.rpy:1336
translate ukrainian story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "дякую Так, це те, що я планую зробити."

# game/storybeat.rpy:1339
translate ukrainian story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "Добре, моя черга."

# game/storybeat.rpy:1340
translate ukrainian story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "Ну, я не знаю, як це сказати, але..."

# game/storybeat.rpy:1341
translate ukrainian story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "Нічого страшного, не поспішай."

# game/storybeat.rpy:1342
translate ukrainian story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "Я думаю, що Робін {color=#918fff}довіряє{/color} мені достатньо, щоб довіряти мені."

# game/storybeat.rpy:1343
translate ukrainian story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "Я хочу знайти когось..."

# game/storybeat.rpy:1344
translate ukrainian story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "Хтось, хто любитиме мене за мене."

# game/storybeat.rpy:1345
translate ukrainian story_beat4_a67d8108:

    # pro "Robin..."
    pro "Робін..."

# game/storybeat.rpy:1346
translate ukrainian story_beat4_160fe2a1:

    # robin "Maybe that's a little too far ahead for me to be thinking about, but..."
    robin "Можливо, це занадто далеко, щоб я про це думав, але..."

# game/storybeat.rpy:1347
translate ukrainian story_beat4_a1839a3e:

    # robin "It's always been a dream of mine to find someone, find a partner."
    robin "Моєю мрією завжди було знайти когось, знайти партнера."

# game/storybeat.rpy:1348
translate ukrainian story_beat4_f205592d:

    # robin "Someone who really loves me and isn't just using me..."
    robin "Той, хто справді любить мене, а не просто використовує мене..."

# game/storybeat.rpy:1349
translate ukrainian story_beat4_a30fb4c2:

    # robin "Since I'm a streamer, I rarely leave the house..."
    robin "Оскільки я стример, я рідко виходжу з дому..."

# game/storybeat.rpy:1350
translate ukrainian story_beat4_dbc99b84:

    # robin "It's hard to meet people."
    robin "Важко зустрічатися з людьми."

# game/storybeat.rpy:1351
translate ukrainian story_beat4_91ce40d6:

    # robin "Being sexualized all the time online also hasn't been good for my self-worth issues..."
    robin "Постійний секс в Інтернеті також не сприяв моїм проблемам із самооцінкою..."

# game/storybeat.rpy:1354
translate ukrainian story_beat4_a972e603:

    # robin "It comes with the job, I guess."
    robin "Гадаю, це йде з роботою."

# game/storybeat.rpy:1355
translate ukrainian story_beat4_6ffbb649:

    # robin "But it's still hard to deal with."
    robin "Але все одно з цим важко впоратися."

# game/storybeat.rpy:1356
translate ukrainian story_beat4_4c3c3006:

    # pro "People online are horny idiots, don't let them get to you."
    pro "Люди в Інтернеті - запеклі ідіоти, не дозволяйте їм до вас добратися."

# game/storybeat.rpy:1357
translate ukrainian story_beat4_e5bde556:

    # robin "I try not to, but it's hard."
    robin "Я намагаюся не робити цього, але це важко."

# game/storybeat.rpy:1358
translate ukrainian story_beat4_2097a78b:

    # robin "I just want to find someone who sees me for me."
    robin "Я просто хочу знайти когось, хто бачить мене замість мене."

# game/storybeat.rpy:1361
translate ukrainian story_beat4_3e312a5b:

    # robin "I don't know... they just make me feel like I'm not worth anything."
    robin "Я не знаю... вони просто змушують мене відчувати, що я нічого не вартий."

# game/storybeat.rpy:1362
translate ukrainian story_beat4_2d902c07:

    # robin "Like I'm just a piece of meat to them."
    robin "Ніби я для них лише шматок м’яса."

# game/storybeat.rpy:1363
translate ukrainian story_beat4_606646c1:

    # pro "Wow, that's really fucked up."
    pro "Ого, це справді біса."

# game/storybeat.rpy:1364
translate ukrainian story_beat4_fbe6a5e9:

    # robin "Yeah..."
    robin "так..."

# game/storybeat.rpy:1366
translate ukrainian story_beat4_00875e63:

    # robin "A career on the internet has always been my dream, but now that it's become a reality..."
    robin "Кар'єра в Інтернеті завжди була моєю мрією, але тепер, коли це стало реальністю..."

# game/storybeat.rpy:1367
translate ukrainian story_beat4_e54b5eed:

    # robin "I guess I'm just kind of lost."
    robin "Здається, я просто заблукав."

# game/storybeat.rpy:1368
translate ukrainian story_beat4_d1b429f7:

    # robin "I don't know what I want to do anymore."
    robin "Я більше не знаю, що я хочу робити."

# game/storybeat.rpy:1369
translate ukrainian story_beat4_11c213ee:

    # pro "Hey, if you ever want to talk about anything like this..."
    pro "Гей, якщо ти колись захочеш поговорити про щось подібне..."

# game/storybeat.rpy:1370
translate ukrainian story_beat4_1e05d98d:

    # pro "I'm always here for you, okay?"
    pro "Я завжди тут для вас, гаразд?"

# game/storybeat.rpy:1371
translate ukrainian story_beat4_e1baa4f9:

    # robin "Th-thanks. It means a lot to me."
    robin "Т-дякую. Це дуже багато для мене означає."

# game/storybeat.rpy:1372
translate ukrainian story_beat4_918aae24:

    # pro "You don't need to have your entire future figured out you know..."
    pro "Вам не потрібно продумувати все своє майбутнє, ви знаєте..."

# game/storybeat.rpy:1373
translate ukrainian story_beat4_a507a988:

    # pro "Sometimes things just happen unexpectedly."
    pro "Іноді все трапляється просто несподівано."

# game/storybeat.rpy:1374
translate ukrainian story_beat4_e92b6384:

    # pro "Like us, we were complete strangers when you first moved in."
    pro "Як і ми, ми були абсолютно незнайомими людьми, коли ви вперше переїхали."

# game/storybeat.rpy:1375
translate ukrainian story_beat4_7464c56d:

    # pro "Now, you're one of the closest friends I have."
    pro "Тепер ти один із найближчих моїх друзів."

# game/storybeat.rpy:1376
translate ukrainian story_beat4_68d7b9aa:

    # robin "Yeah, that's true."
    robin "Так, це правда."

# game/storybeat.rpy:1378
translate ukrainian story_beat4_970ac64e:

    # robin "I'm glad we became friends."
    robin "Я радий, що ми стали друзями."

# game/storybeat.rpy:1379
translate ukrainian story_beat4_4a8af8d0:

    # robin "You make me feel so... comfortable."
    robin "Ти змушуєш мене відчувати себе так... комфортно."

# game/storybeat.rpy:1380
translate ukrainian story_beat4_e7c88bc3:

    # robin "I don't know how you do it."
    robin "Я не знаю, як ти це робиш."

# game/storybeat.rpy:1381
translate ukrainian story_beat4_e82f048d:

    # pro "It's a gift."
    pro "Це подарунок."

# game/storybeat.rpy:1382
translate ukrainian story_beat4_fad03f8a:

    # "We laugh together, and for a moment the fear of the dark subsides."
    "Ми разом сміємося, і на мить страх перед темрявою вщухає."

# game/storybeat.rpy:1385
translate ukrainian story_beat4_776782d0:

    # robin "Can I... ask you for something?"
    robin "Чи можу я... попросити вас про щось?"

# game/storybeat.rpy:1386
translate ukrainian story_beat4_087f9b10:

    # pro "Of course, what is it?"
    pro "Звичайно, що це?"

# game/storybeat.rpy:1387
translate ukrainian story_beat4_0f0aad54:

    # robin "If you wouldn't mind, can I sleep in your room tonight?"
    robin "Якщо ви не заперечуєте, я можу спати у вашій кімнаті сьогодні ввечері?"

# game/storybeat.rpy:1388
translate ukrainian story_beat4_d5239721:

    # robin "If the power doesn't come back on, of course!"
    robin "Звичайно, якщо живлення не відновиться!"

# game/storybeat.rpy:1391
translate ukrainian story_beat4_3fb05efa:

    # "His face flushes with embarrassment. It's adorable."
    "Його обличчя червоніє від збентеження. Це чарівно."

# game/storybeat.rpy:1392
translate ukrainian story_beat4_653a0356:

    # pro "Sure, you can sleep in my room with me."
    pro "Звичайно, ти можеш спати зі мною в моїй кімнаті."

# game/storybeat.rpy:1393
translate ukrainian story_beat4_03b2370e:

    # robin "Are you sure it isn't weird?"
    robin "Ви впевнені, що це не дивно?"

# game/storybeat.rpy:1394
translate ukrainian story_beat4_bf6fade1:

    # pro "Not at all!"
    pro "Зовсім ні!"

# game/storybeat.rpy:1395
translate ukrainian story_beat4_d1d174a4:

    # pro "I just want you to feel safe."
    pro "Я просто хочу, щоб ти відчував себе в безпеці."

# game/storybeat.rpy:1397
translate ukrainian story_beat4_c791b29e:

    # robin "Right... thank you. That means a lot to me."
    robin "Правильно... дякую. Це для мене дуже багато значить."

# game/storybeat.rpy:1398
translate ukrainian story_beat4_ff1acfe7:

    # robin "You're the best."
    robin "ти найкращий"

# game/storybeat.rpy:1399
translate ukrainian story_beat4_a6855880:

    # robin "Anyway, let's try and pass the time until the power comes back on!"
    robin "У будь-якому випадку, давайте спробуємо згаяти час, поки живлення не відновиться!"

# game/storybeat.rpy:1401
translate ukrainian story_beat4_88861444:

    # "We the next few hours the night chatting and joking around."
    "Ми наступні кілька годин уночі балакали й жартували."

# game/storybeat.rpy:1402
translate ukrainian story_beat4_e6c427fb:

    # "I know he's still afraid, but I'm glad Robin feels comfortable enough to talk and laugh with me."
    "Я знаю, що він усе ще боїться, але я радий, що Робін відчуває себе достатньо комфортно, щоб розмовляти та сміятися зі мною."

# game/storybeat.rpy:1403
translate ukrainian story_beat4_d87aa449:

    # pro "Hey, it's starting to get really late..."
    pro "Гей, починає ставати дуже пізно..."

# game/storybeat.rpy:1404
translate ukrainian story_beat4_ae625479:

    # pro "I say we call it and head to bed, don't think the power is going to come back anytime soon."
    pro "Я кажу, що ми дзвонимо та лягаємо спати, не думай, що електроенергія скоро відновиться."

# game/storybeat.rpy:1405
translate ukrainian story_beat4_919f61cb:

    # robin "Oh, okay..."
    robin "О, гаразд..."

# game/storybeat.rpy:1406
translate ukrainian story_beat4_6b8abdd1:

    # robin "I guess I'm sleeping in your room tonight then, huh..."
    robin "Здається, я буду спати сьогодні вночі у твоїй кімнаті, га..."

# game/storybeat.rpy:1407
translate ukrainian story_beat4_a0164f5c:

    # "He seems nervous."
    "Він здається нервовим."

# game/storybeat.rpy:1408
translate ukrainian story_beat4_74a83be0:

    # pro "If you want, I can sleep on the floor or something-"
    pro "Якщо хочеш, я можу спати на підлозі чи щось таке..."

# game/storybeat.rpy:1409
translate ukrainian story_beat4_5f3c5ddc:

    # robin "If you don't mind... I'd actually like to sleep next to you."
    robin "Якщо ви не проти... я б хотів спати поруч з вами."

# game/storybeat.rpy:1410
translate ukrainian story_beat4_153fc70a:

    # robin "Your presence is really reassuring..."
    robin "Ваша присутність справді заспокоює..."

# game/storybeat.rpy:1411
translate ukrainian story_beat4_88ba291b:

    # "I'm blushing furiously."
    "Я люто червонію."

# game/storybeat.rpy:1412
translate ukrainian story_beat4_2afaa221:

