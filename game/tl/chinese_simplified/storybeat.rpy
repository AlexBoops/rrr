# game/storybeat.rpy:1341
translate chinese_simplified story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "没关系，慢慢来。"

# game/storybeat.rpy:1342
translate chinese_simplified story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "我认为罗宾{color=#918fff}信任{/color}我，可以向我吐露心声。"

# game/storybeat.rpy:1343
translate chinese_simplified story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "我想找一个人..."

# game/storybeat.rpy:1344
translate chinese_simplified story_beat4_b3ddb68b:

