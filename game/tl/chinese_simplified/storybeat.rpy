    # robin "But I don't want you to get hurt... or worse..."
    robin "但我不想让你受伤……或者更糟……"

# game/storybeat.rpy:2387
translate chinese_simplified story_beat6_89568f5e:

    # robin "I'm scared."
    robin "我很害怕。"

# game/storybeat.rpy:2388
