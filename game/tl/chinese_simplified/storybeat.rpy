    # pro "Sure, you can sleep in my room with me."
    pro "当然，你可以和我一起睡在我的房间里。"

# game/storybeat.rpy:1393
translate chinese_simplified story_beat4_03b2370e:

    # robin "Are you sure it isn't weird?"
    robin "你确定这不奇怪吗？"

# game/storybeat.rpy:1394
translate chinese_simplified story_beat4_bf6fade1:

    # pro "Not at all!"
    pro "一点也不！"

# game/storybeat.rpy:1395
translate chinese_simplified story_beat4_d1d174a4:

    # pro "I just want you to feel safe."
    pro "我只是想让你感到安全。"

# game/storybeat.rpy:1397
translate chinese_simplified story_beat4_c791b29e:

    # robin "Right... thank you. That means a lot to me."
    robin "对了……谢谢。这对我来说意义重大。"

# game/storybeat.rpy:1398
translate chinese_simplified story_beat4_ff1acfe7:

    # robin "You're the best."
    robin "你是最棒的。"

# game/storybeat.rpy:1399
translate chinese_simplified story_beat4_a6855880:

    # robin "Anyway, let's try and pass the time until the power comes back on!"
    robin "无论如何，让我们试着打发时间，直到电源恢复！"

# game/storybeat.rpy:1401
translate chinese_simplified story_beat4_88861444:

    # "We the next few hours the night chatting and joking around."
    "接下来的几个小时我们晚上聊天、开玩笑。"

# game/storybeat.rpy:1402
translate chinese_simplified story_beat4_e6c427fb:

    # "I know he's still afraid, but I'm glad Robin feels comfortable enough to talk and laugh with me."
    "我知道他仍然害怕，但我很高兴罗宾感到很舒服，可以和我说说笑笑。"

# game/storybeat.rpy:1403
translate chinese_simplified story_beat4_d87aa449:

    # pro "Hey, it's starting to get really late..."
    pro "哎呀，开始已经晚了……"

# game/storybeat.rpy:1404
translate chinese_simplified story_beat4_ae625479:

    # pro "I say we call it and head to bed, don't think the power is going to come back anytime soon."
    pro "我说我们打电话去睡觉吧，我认为电力不会很快恢复。"

# game/storybeat.rpy:1405
translate chinese_simplified story_beat4_919f61cb:

    # robin "Oh, okay..."
    robin "哦好的..."

# game/storybeat.rpy:1406
translate chinese_simplified story_beat4_6b8abdd1:

    # robin "I guess I'm sleeping in your room tonight then, huh..."
    robin "我想今晚我会睡在你的房间里，嗯..."

# game/storybeat.rpy:1407
translate chinese_simplified story_beat4_a0164f5c:

    # "He seems nervous."
    "他看起来很紧张。"

# game/storybeat.rpy:1408
translate chinese_simplified story_beat4_74a83be0:

    # pro "If you want, I can sleep on the floor or something-"
    pro "如果你愿意的话，我可以睡在地板上什么的——"

# game/storybeat.rpy:1409
translate chinese_simplified story_beat4_5f3c5ddc:

    # robin "If you don't mind... I'd actually like to sleep next to you."
    robin "如果你不介意的话...我其实很想睡在你旁边。"

# game/storybeat.rpy:1410
translate chinese_simplified story_beat4_153fc70a:

    # robin "Your presence is really reassuring..."
    robin "有你的存在，真的让人安心……"

# game/storybeat.rpy:1411
translate chinese_simplified story_beat4_88ba291b:

    # "I'm blushing furiously."
    "我气得满脸通红。"

# game/storybeat.rpy:1412
translate chinese_simplified story_beat4_2afaa221:

    # pro "Y-yeah, I can sleep next to you if you want."
    pro "是的，如果你愿意的话，我可以睡在你旁边。"

# game/storybeat.rpy:1413
translate chinese_simplified story_beat4_93e42cf0:

    # robin "Thank you..."
    robin "谢谢..."

# game/storybeat.rpy:1414
translate chinese_simplified story_beat4_5d37e9ed:

    # robin "All right then, let's go to bed."
    robin "好吧，我们去睡觉吧。"

# game/storybeat.rpy:1415
