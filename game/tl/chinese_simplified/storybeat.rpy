    # pro "Trust me, I may look a bit scrawny but I can take care of myself."
    pro "相信我，我可能看起来有点骨瘦如柴，但我可以照顾自己。"

# game/storybeat.rpy:2509
translate chinese_simplified ending1_4585dad3:

    # robin "I hope so..."
    robin "我希望如此..."

# game/storybeat.rpy:2510
