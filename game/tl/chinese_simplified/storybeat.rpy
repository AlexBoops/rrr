# game/storybeat.rpy:1357
translate chinese_simplified story_beat4_e5bde556:

    # robin "I try not to, but it's hard."
    robin "我尽量不这么做，但这很难。"

# game/storybeat.rpy:1358
translate chinese_simplified story_beat4_2097a78b:

    # robin "I just want to find someone who sees me for me."
    robin "我只是想找一个能替我看我的人。"

# game/storybeat.rpy:1361
translate chinese_simplified story_beat4_3e312a5b:

    # robin "I don't know... they just make me feel like I'm not worth anything."
    robin "我不知道……他们只是让我觉得我一文不值。"

# game/storybeat.rpy:1362
translate chinese_simplified story_beat4_2d902c07:

    # robin "Like I'm just a piece of meat to them."
    robin "就像我对他们来说只是一块肉一样。"

# game/storybeat.rpy:1363
translate chinese_simplified story_beat4_606646c1:

