    # pro "Don't hesitate to come to me if you need me, okay?"
    pro "如果你需要我，请不要犹豫来找我，好吗？"

# game/storybeat.rpy:3289
translate chinese_simplified ending3_b6d44cb0:

    # robin "Of course."
    robin "当然。"

# game/storybeat.rpy:3290
translate chinese_simplified ending3_f9d47bbf:

    # pro "Goodnight, Robin."
    pro "晚安，罗宾。"

# game/storybeat.rpy:3293
translate chinese_simplified ending3_e425161f:

    # "I exit Robin's room and enter mine."
    "我离开罗宾的房间，进入我的房间。"

# game/storybeat.rpy:3295
translate chinese_simplified ending3_31a81e73:

    # "I lay in bed for a few moments, thinking about the situation."
    "我在床上躺了一会儿，思考着现在的情况。"

# game/storybeat.rpy:3296
translate chinese_simplified ending3_23809f57:

    # "I feel useless. I can't do anything to help him right now, except just be there for him."
    "我觉得没用。我现在无法做任何事来帮助他，只能陪在他身边。"

# game/storybeat.rpy:3297
translate chinese_simplified ending3_1fcc620c:

    # pro "Maybe I should have been more proactive... he seems pretty freaked out."
    pro "也许我应该更主动一些……他看起来很害怕。"

# game/storybeat.rpy:3298
translate chinese_simplified ending3_0d7f16f7:

    # "But I don't know what to do... I've never been in this kind of situation before..."
    "但我不知道该怎么办……我从来没有遇到过这种情况……"

# game/storybeat.rpy:3299
translate chinese_simplified ending3_ae4991da:

    # "I should be doing something... but what?"
    "我应该做点什么……但是做什么？"

# game/storybeat.rpy:3300
translate chinese_simplified ending3_ab95e301:

    # pro "I need to be strong, I need to be his rock."
    pro "我需要坚强，我需要成为他的支柱。"

# game/storybeat.rpy:3301
translate chinese_simplified ending3_56d695b7:

    # pro "He needs someone to lean on, and I have to be that person for him. If not me, then who else?"
    pro "他需要有人依靠，而我必须成为他的依靠。如果不是我，那还有谁？"

# game/storybeat.rpy:3302
translate chinese_simplified ending3_a5d99406:

    # pro "I have to protect him, no matter what. He's too precious to lose."
    pro "我必须保护他，无论如何。他太珍贵了，不能失去。"

# game/storybeat.rpy:3303
translate chinese_simplified ending3_e62d2c13:

    # pro "I'm the only person who can help him through this, and I have to be strong enough for the both of us."
    pro "我是唯一能帮助他渡过难关的人，我必须足够坚强才能支持我们俩。"

# game/storybeat.rpy:3304
translate chinese_simplified ending3_5e97ec88:

    # pro "I can't let him down. Not again."
    pro "我不能让他失望。不会再有。"

# game/storybeat.rpy:3306
translate chinese_simplified ending3_fe264a5e:

    # "I drift off to sleep, my mind still swimming with thoughts of what I can do..."
    "我迷迷糊糊地睡着了，脑子里仍然想着我能做什么……"

# game/storybeat.rpy:3307
translate chinese_simplified ending3_a20cefa7:

    # "..."
    "..."

# game/storybeat.rpy:3308
translate chinese_simplified ending3_a20cefa7_1:

    # "..."
    "..."

# game/storybeat.rpy:3309
translate chinese_simplified ending3_a20cefa7_2:

    # "..."
    "..."

# game/storybeat.rpy:3310
translate chinese_simplified ending3_75d24cb1:

    # robin "AH!"
    robin "啊！"

# game/storybeat.rpy:3315
translate chinese_simplified ending3_e9db462a:

    # "I jolt awake."
    "我猛地惊醒。"

# game/storybeat.rpy:3316
translate chinese_simplified ending3_06295e90:

    # pro "Robin."
    pro "罗宾."

# game/storybeat.rpy:3329
translate chinese_simplified ending3_d2cf240f:

    # "I run out of my room and see Robin pinned to the ground by his stalker."
    "我跑出房间，看到罗宾被跟踪者按在地上。"

# game/storybeat.rpy:3330
translate chinese_simplified ending3_6107699d:

    # "Robin is kicking and screaming, but he can't seem to fight him off."
    "罗宾又踢又叫，但他似乎无法击退他。"

# game/storybeat.rpy:3331
translate chinese_simplified ending3_950b7f5c:

    # pro "HEY, WHAT THE FUCK!"
    pro "嘿，他妈的是什么！"

# game/storybeat.rpy:3333
translate chinese_simplified ending3_43427c86:

    # "Before I can reach him, he dashes into Robin's room and locks the door behind him."
    "在我找到他之前，他冲进罗宾的房间并锁上了门。"

# game/storybeat.rpy:3334
translate chinese_simplified ending3_ea74d06f:

    # pro "SHIT, NO!"
    pro "SHIT, NO!"

# game/storybeat.rpy:3336
translate chinese_simplified ending3_022af4ed:

    # "I try to open the door, but it's locked."
    "我试图打开门，但门锁着。"

# game/storybeat.rpy:3337
translate chinese_simplified ending3_6f92533d:

    # "I can hear Robin crying out in pain on the other side of the door."
    "我能听到罗宾在门的另一边痛苦地哭泣。"

# game/storybeat.rpy:3338
translate chinese_simplified ending3_5919c7a1:

    # pro "ROBIN!"
    pro "罗宾！"

# game/storybeat.rpy:3339
translate chinese_simplified ending3_a194c958:

    # pro "LET HIM GO!"
    pro "让他走吧！"

# game/storybeat.rpy:3346
translate chinese_simplified ending3_7e56139d:

    # "I bang and kick on the door as much as I can, but it won't budge."
    "我用尽全力敲门、踢门，但门纹丝不动。"

# game/storybeat.rpy:3347
translate chinese_simplified ending3_5919c7a1_1:

    # pro "ROBIN!"
    pro "罗宾！"

# game/storybeat.rpy:3348
translate chinese_simplified ending3_0bd7a553:

    # pro "ROBIN, ARE YOU OKAY?"
    pro "罗宾，你还好吗？"

# game/storybeat.rpy:3349
translate chinese_simplified ending3_5919c7a1_2:

    # pro "ROBIN!"
    pro "罗宾！"

# game/storybeat.rpy:3350
translate chinese_simplified ending3_b42f83ac:

    # pro "GOD FUCKING DAMMIT! OPEN UP!"
    pro "该死的上帝！打开！"

# game/storybeat.rpy:3351
translate chinese_simplified ending3_2e1dfacd:

    # pro "OPEN THE DOOR! OPEN IT!"
    pro "开门！打开它！"

# game/storybeat.rpy:3352
translate chinese_simplified ending3_eebd0e9e:

    # "I take a step back and charge at the door, throwing all my weight against it."
    "我后退一步，冲向门口，用全身的重量抵住门。"

# game/storybeat.rpy:3353
translate chinese_simplified ending3_6a97d06c:

    # "I can feel it start to give way..."
    "我能感觉到它开始让位......"

# game/storybeat.rpy:3354
translate chinese_simplified ending3_5a8d4f07:

    # pro "COME ON!"
    pro "快点！"

# game/storybeat.rpy:3355
translate chinese_simplified ending3_2de705bc:

    # pro "OPEN THIS FUCKING DOOR!"
    pro "打开这该死的门！"

# game/storybeat.rpy:3356
translate chinese_simplified ending3_59f9123c:

    # "I continue ramming the door with my shoulder."
    "我继续用肩膀撞门。"

# game/storybeat.rpy:3357
translate chinese_simplified ending3_5919c7a1_3:

    # pro "ROBIN!"
    pro "罗宾！"

# game/storybeat.rpy:3358
translate chinese_simplified ending3_cdb142b8:

    # pro "HANG IN THERE!"
    pro "坚持住！"

# game/storybeat.rpy:3359
translate chinese_simplified ending3_7ee63005:

    # "I can hear him sobbing uncontrollably, and it sounds like he's begging to be let go."
    "我能听到他无法控制地抽泣，听起来像是在乞求放开他。"

# game/storybeat.rpy:3360
translate chinese_simplified ending3_86d2446b:

    # pro "I'M COMING, HANG ON ROBIN!"
    pro "我来了，罗宾，坚持住！"

# game/storybeat.rpy:3361
translate chinese_simplified ending3_1786ac41:

    # "I throw myself against the door as hard as I can, and finally..."
    "我用尽全身力气把自己撞到门上，最后……"

# game/storybeat.rpy:3363
translate chinese_simplified ending3_ba92ceff:

    # pro "FUCK!"
    pro "他妈的！"

# game/storybeat.rpy:3364
translate chinese_simplified ending3_1fc433b8:

    # "I break through the door, sending wood splintering across the room."
    "我破门而入，木头碎片飞过房间。"

# game/storybeat.rpy:3376
translate chinese_simplified ending3_c061014c:

    # "I see Robin's attacker standing over Robin's bed."
    "我看到袭击罗宾的人站在罗宾的床边。"

# game/storybeat.rpy:3377
translate chinese_simplified ending3_208de411:

    # robin "P-Please, I-"
    robin "拜-拜托，我-"

# game/storybeat.rpy:3378
translate chinese_simplified ending3_a35802ab:

    # pro "GET THE FUCK OFF OF HIM!"
    pro "滚开他！"

# game/storybeat.rpy:3380
translate chinese_simplified ending3_f2d1c63d:

    # "I sprint towards him, tackling him to the floor."
    "我冲向他，把他按倒在地。"

# game/storybeat.rpy:3383
translate chinese_simplified ending3_a2400c55:

    # pro "CALL THE POLICE ROBIN!"
    pro "打电话给警察罗宾！"

# game/storybeat.rpy:3384
translate chinese_simplified ending3_1e60ef1b:

    # "He tries to fight back, but I keep him pinned down."
    "他试图反击，但我把他压制住了。"

# game/storybeat.rpy:3387
translate chinese_simplified ending3_a286ae12:

    # pro "DON'T YOU FUCKING TOUCH HIM!"
    pro "你他妈别碰他！"

# game/storybeat.rpy:3388
translate chinese_simplified ending3_2aa036ce:

    # pro "DON'T YOU EVER FUCKING TOUCH HIM AGAIN!"
    pro "你他妈的别再碰他了！"

# game/storybeat.rpy:3389
translate chinese_simplified ending3_28c85b67:

    # pro "YOU FUCKING HEAR ME?"
    pro "你他妈听到我说话了吗？"

# game/storybeat.rpy:3390
translate chinese_simplified ending3_9f9ab749:

    # pro "DON'T FUCKING TOUCH HIM, EVER AGAIN!"
    pro "他妈的别再碰他了！"

# game/storybeat.rpy:3391
translate chinese_simplified ending3_6f684203:

    # "I can hear Robin's voice behind me on the phone with the police."
    "我可以听到罗宾在我身后与警察通电话的声音。"

# game/storybeat.rpy:3394
translate chinese_simplified ending3_be2444d3:

    # pro "YOU PIECE OF SHIT! HOW COULD YOU DO THAT TO HIM?"
    pro "你这个狗屎！你怎么能这样对他？"

# game/storybeat.rpy:3395
translate chinese_simplified ending3_24e58568:

    # "I'm seeing red."
    "我看到红色了"

# game/storybeat.rpy:3396
translate chinese_simplified ending3_6a087246:

    # "I don't know whats happening any more."
    "我不知道发生了什么了。"

# game/storybeat.rpy:3398
translate chinese_simplified ending3_10f29c2a:

    # "All of a sudden, my vision is completely red."
    "突然，我的视线完全变成红色。"

# game/storybeat.rpy:3400
translate chinese_simplified ending3_49339164:

    # "Then black."
    "然后是黑色。"

# game/storybeat.rpy:3402
translate chinese_simplified ending3_637fa4bd:

    # "And then..."
    "进而..."

# game/storybeat.rpy:3403
translate chinese_simplified ending3_149f6181:

    # cop "Sir..."
    cop "先生..."

# game/storybeat.rpy:3404
translate chinese_simplified ending3_7f3d54f7:

    # cop "..."
    cop "..."

# game/storybeat.rpy:3405
translate chinese_simplified ending3_efcc7e23:

    # cop "Sir, are you listening?"
    cop "先生，您在听吗？"

# game/storybeat.rpy:3407
translate chinese_simplified ending3_16ea8ef3:

    # "I snap out of the trance I was in."
    "我从恍惚状态中清醒过来。"

# game/storybeat.rpy:3408
translate chinese_simplified ending3_899398a1:

    # "What the fuck..."
    "搞什么鬼..."

# game/storybeat.rpy:3409
translate chinese_simplified ending3_4c7fe93b:

    # "We're in the living room now..."
    "我们现在在客厅..."

# game/storybeat.rpy:3410
translate chinese_simplified ending3_599a1a4e:

    # "And the cops are here."
    "警察也来了。"

# game/storybeat.rpy:3411
translate chinese_simplified ending3_9280a846:

    # cop "Sir, please sit down."
    cop "先生，请坐。"

# game/storybeat.rpy:3412
translate chinese_simplified ending3_b110fa5b:

    # cop "We need to get your statement."
    cop "我们需要得到你的陈述。"

# game/storybeat.rpy:3413
translate chinese_simplified ending3_2b73dc1d:

    # pro "My statement..."
    pro "我的声明..."

# game/storybeat.rpy:3414
translate chinese_simplified ending3_033f5306:

    # "The police ask me questions regarding what happened."
    "警察询问我有关发生的事情的问题。"

# game/storybeat.rpy:3415
translate chinese_simplified ending3_5ef0727a:

    # "Apparently, by the time they had arrived to the apartment, I had already beaten and knocked out the stalker."
    "显然，当他们到达公寓时，我已经殴打并击倒了跟踪者。"

# game/storybeat.rpy:3416
translate chinese_simplified ending3_7fb94011:

    # "I can barely remember anything, I feel like I blacked out."
    "我几乎什么都不记得了，我感觉我眼前一黑。"

# game/storybeat.rpy:3417
translate chinese_simplified ending3_8b6b99dd:

    # pro "And where is Robin?"
    pro "罗宾在哪里？"

# game/storybeat.rpy:3418
translate chinese_simplified ending3_dd25b953:

    # cop "We had a paramedic look him over, but he's okay."
    cop "我们请了一名护理人员检查了他，但他没事。"

# game/storybeat.rpy:3419
translate chinese_simplified ending3_fd769f77:

    # cop "Just shaken up, and bruised."
    cop "刚刚浑身发抖，遍体鳞伤。"

# game/storybeat.rpy:3420
translate chinese_simplified ending3_5706f683:

    # pro "Oh thank god..."
    pro "噢，感谢上帝..."

# game/storybeat.rpy:3421
translate chinese_simplified ending3_146eb2f0:

    # pro "I was so worried..."
    pro "我很担心..."

# game/storybeat.rpy:3422
translate chinese_simplified ending3_b9566204:

    # cop "We've arrested the man and he's on his way to jail, so he won't be able to harm Mr. Robin anymore."
    cop "我们已经逮捕了那个人，他正在入狱的路上，所以他不能再伤害罗宾先生了。"

# game/storybeat.rpy:3423
translate chinese_simplified ending3_8749b116:

    # pro "Can I see him?"
    pro "我可以见他吗？"

# game/storybeat.rpy:3424
translate chinese_simplified ending3_8bb367b8:

    # cop "Sure, I'll ask the paramedics to release him. We should be leaving right now any way."
    cop "当然，我会要求医护人员释放他。无论如何，我们现在就应该离开。"

# game/storybeat.rpy:3425
translate chinese_simplified ending3_c53debc1:

    # pro "Thank you, officer."
    pro "谢谢你，军官。"

# game/storybeat.rpy:3426
translate chinese_simplified ending3_3b2d9ebd:

    # "The police officer leaves."
    "警察离开。"

# game/storybeat.rpy:3428
translate chinese_simplified ending3_e4218824:

    # "A few minutes later, Robin comes back into the apartment."
    "几分钟后，罗宾回到公寓。"

# game/storybeat.rpy:3429
translate chinese_simplified ending3_4f294cc9:

    # pro "Robin, thank god you're-"
    pro "罗宾，感谢上帝，你是——"

# game/storybeat.rpy:3431
translate chinese_simplified ending3_9728cbae:

    # robin "Don't..."
    robin "不..."

# game/storybeat.rpy:3432
translate chinese_simplified ending3_a995c6f1:

    # robin "Don't talk to me..."
    robin "别跟我说话..."

# game/storybeat.rpy:3433
translate chinese_simplified ending3_cb40c0d2:

    # pro "What...?"
    pro "什么...？"

# game/storybeat.rpy:3434
translate chinese_simplified ending3_8b31e763:

    # pro "But-"
    pro "但-"

# game/storybeat.rpy:3436
translate chinese_simplified ending3_161e2c69:

    # robin "No..."
    robin "不..."

# game/storybeat.rpy:3437
translate chinese_simplified ending3_ae9d39d9:

    # robin "Just shut the fuck up..."
    robin "就他妈的闭嘴吧..."

# game/storybeat.rpy:3438
translate chinese_simplified ending3_a67d8108:

    # pro "Robin..."
    pro "罗宾..."

# game/storybeat.rpy:3439
translate chinese_simplified ending3_411384f8:

    # "I can see tears welling up in his eyes."
    "我可以看到他眼里涌出泪水。"

# game/storybeat.rpy:3440
translate chinese_simplified ending3_fa17b0a1:

    # robin "I trusted you..."
    robin "我信任你..."

# game/storybeat.rpy:3441
translate chinese_simplified ending3_0294e7e7:

    # robin "You told me everything would be okay if we just did nothing..."
    robin "你告诉我，如果我们什么都不做，一切都会好起来的……"

# game/storybeat.rpy:3442
translate chinese_simplified ending3_442a4a81:

    # robin "You fell asleep peacefully while I was fucking terrified!"
    robin "你却安稳地睡着了，而我却他妈的害怕极了！"

# game/storybeat.rpy:3443
translate chinese_simplified ending3_649402e9:

    # pro "But you said I could... I couldn't have known that-"
    pro "但你说我可以...我不可能知道-"

# game/storybeat.rpy:3444
translate chinese_simplified ending3_5c0f6f20:

    # robin "Then maybe I shouldn't have trusted you in the first place..."
    robin "那也许我一开始就不该相信你……"

# game/storybeat.rpy:3445
translate chinese_simplified ending3_8e4832b1:

    # robin "You could have gotten me killed..."
    robin "你本来可以害死我的..."

# game/storybeat.rpy:3446
translate chinese_simplified ending3_0351b29e:

    # robin "You could have gotten yourself killed..."
    robin "你可能会害死自己..."

# game/storybeat.rpy:3447
translate chinese_simplified ending3_7cd0ed14:

    # robin "And not to mention how violent you got with him..."
    robin "更不用说你对他有多暴力了......"

# game/storybeat.rpy:3448
translate chinese_simplified ending3_a593398b:

    # robin "You... your hands were all bloody."
    robin "你……你的双手都沾满了血。"

# game/storybeat.rpy:3449
translate chinese_simplified ending3_064835f3:

    # pro "I didn't mean to... I didn't even realize I was..."
    pro "我不是故意的……我什至没有意识到我是……"

# game/storybeat.rpy:3450
translate chinese_simplified ending3_443a072e:

    # pro "I blacked out and when I came to, the cops were-"
    pro "我眼前一黑，等我清醒过来时，警察们——"

# game/storybeat.rpy:3451
translate chinese_simplified ending3_2418ba72:

    # robin "I'm leaving."
    robin "我要走了。"

# game/storybeat.rpy:3453
translate chinese_simplified ending3_14e5965e:

    # robin "I'm moving out and going somewhere else."
    robin "我要搬出去去别的地方。"

# game/storybeat.rpy:3454
translate chinese_simplified ending3_cc59e536:

    # robin "I... I can't stay with you any more."
    robin "我……我不能再和你在一起了。"

# game/storybeat.rpy:3455
translate chinese_simplified ending3_5046e8ff:

    # robin "You broke my trust... I can't anymore."
    robin "你辜负了我的信任...我不能再这样了。"

# game/storybeat.rpy:3456
translate chinese_simplified ending3_5009e319:

    # robin "I'm sorry."
    robin "对不起。"

# game/storybeat.rpy:3457
translate chinese_simplified ending3_c4911750:

    # "I'm stunned. I don't know what to say."
    "我惊呆了。我不知道该说什么。"

# game/storybeat.rpy:3458
translate chinese_simplified ending3_05a42722:

    # robin "I'm going to stay at a motel tonight. Don't bother trying to contact me."
    robin "今晚我打算住在汽车旅馆。不用费心尝试联系我。"

# game/storybeat.rpy:3459
translate chinese_simplified ending3_a5c35f8d:

    # robin "I'll be back for my stuff tomorrow..."
    robin "明天我就回来取东西了..."

# game/storybeat.rpy:3460
translate chinese_simplified ending3_39e01fef:

    # robin "I can pay for the damages to the door you broke too."
    robin "我也可以赔偿你打破的门的损失。"

# game/storybeat.rpy:3461
translate chinese_simplified ending3_82353b83:

    # pro "Robin... no..."
    pro "Robin... no..."

# game/storybeat.rpy:3462
translate chinese_simplified ending3_ecd229c2:

    # pro "I was... I was just..."
    pro "我当时……我只是……"

# game/storybeat.rpy:3464
translate chinese_simplified ending3_ed23f47e:

    # "Without another word, he turns around and leaves."
    "他没有再说什么，转身离开。"

# game/storybeat.rpy:3465
translate chinese_simplified ending3_d0157b79:

    # "I'm alone... again..."
    "我又一个人了……"

# game/storybeat.rpy:3466
translate chinese_simplified ending3_f05b010b:

    # "And this time it's my fault..."
    "而这次是我的错..."

# game/storybeat.rpy:3467
translate chinese_simplified ending3_5aef4a4b:

    # "I failed him..."
    "我辜负了他..."

# game/storybeat.rpy:3468
