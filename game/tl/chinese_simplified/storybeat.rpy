translate chinese_simplified ending1_06295e90_1:

    # pro "Robin."
    pro "罗宾."

# game/storybeat.rpy:2516
translate chinese_simplified ending1_9a052b3a_1:

    # pro "Do you trust me?"
    pro "你相信我吗？"

# game/storybeat.rpy:2517
translate chinese_simplified ending1_7bd462e9_3:

    # robin "..."
    robin "..."

