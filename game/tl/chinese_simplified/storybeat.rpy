    pro "而且...我也想帮助你。"

# game/storybeat.rpy:2233
translate chinese_simplified story_beat6_0385e187:

    # robin "You do?"
    robin "你做？"

# game/storybeat.rpy:2234
translate chinese_simplified story_beat6_9ac09d66:

    # pro "Of course..."
    pro "当然..."

# game/storybeat.rpy:2235
translate chinese_simplified story_beat6_e65efcc8:

    # pro "Let me take care of you Robin."
    pro "让我来照顾你，罗宾。"

# game/storybeat.rpy:2236
translate chinese_simplified story_beat6_091d683a:

    # pro "Let me love you and show you how wonderful it can be."
    pro "让我爱你并向你展示它是多么美妙。"

# game/storybeat.rpy:2237
translate chinese_simplified story_beat6_3fd36189:

    # robin "B-but how?"
    robin "但、但是怎么办？"

# game/storybeat.rpy:2239
translate chinese_simplified story_beat6_7c844f3d:

    # pro "You said you didn't want to have any more sex until we figured things out, right?"
    pro "你说过在我们解决问题之前你不想再发生性行为，对吗？"

# game/storybeat.rpy:2240
translate chinese_simplified story_beat6_a99ed122:

    # pro "That means you've already chosen your answer, haven't you?"
    pro "这意味着你已经选择了答案，不是吗？"

# game/storybeat.rpy:2241
translate chinese_simplified story_beat6_9f2551cd:

    # pro "You've just chosen the harder option to avoid taking a leap of faith."
    pro "你只是选择了更困难的选择来避免信仰的飞跃。"

# game/storybeat.rpy:2242
translate chinese_simplified story_beat6_9e97e6cb:

    # pro "But you need to understand that there are no right answers, only the answers that are right for us."
    pro "但你需要明白，没有正确的答案，只有适合我们的答案。"

# game/storybeat.rpy:2243
translate chinese_simplified story_beat6_190031a7:

    # pro "I'm not trying to pressure you into a relationship, but I think it would be good for both of us to give it a try."
    pro "我并不是想强迫你建立关系，但我认为尝试一下对我们双方都有好处。"

# game/storybeat.rpy:2244
translate chinese_simplified story_beat6_93e9dc11:

    # pro "We can go as slow or as fast as you want, I'm not in a rush either."
    pro "我们可以按照你的意愿走得慢或快，我也不着急。"

# game/storybeat.rpy:2245
translate chinese_simplified story_beat6_46a65d19:

    # pro "But if you want to take a risk, and you want to try for a happy ending, then I think it's worth taking a leap of faith."
    pro "但如果你想冒险，并且想尝试一个幸福的结局，那么我认为值得迈出信心的一步。"

# game/storybeat.rpy:2246
translate chinese_simplified story_beat6_a1ba2e62:

    # pro "I'll catch you. I'll be there for you."
    pro "我会抓住你的。我会在那等你。"

# game/storybeat.rpy:2247
translate chinese_simplified story_beat6_7bd462e9:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2248
translate chinese_simplified story_beat6_531cbf7d:

    # robin "Okay..."
    robin "好的..."

# game/storybeat.rpy:2249
translate chinese_simplified story_beat6_2920f75f:

    # pro "Okay?"
    pro "好的？"

# game/storybeat.rpy:2250
translate chinese_simplified story_beat6_5b527369:

    # pro "What's okay?"
    pro "有什么问题吗？"

# game/storybeat.rpy:2252
translate chinese_simplified story_beat6_4b973700:

    # robin "Let's do it..."
    robin "我们开始做吧..."

# game/storybeat.rpy:2253
translate chinese_simplified story_beat6_0a1bdcaf:

    # robin "I'm willing to try."
    robin "我愿意尝试。"

# game/storybeat.rpy:2254
translate chinese_simplified story_beat6_05d819c8:

    # robin "You're right. There's no use in worrying about it."
    robin "你说得对。担心它是没有用的。"

# game/storybeat.rpy:2255
translate chinese_simplified story_beat6_79c95fa9:

    # robin "I just have to have a little courage."
    robin "我只需要有一点勇气。"

# game/storybeat.rpy:2256
translate chinese_simplified story_beat6_c5e6dd3b:

    # robin "If we're meant to be, we're meant to be, and if we're not then we can move on without hurting each other."
    robin "如果我们注定如此，我们就注定如此，如果我们不是，那么我们可以继续前进，而不会互相伤害。"

# game/storybeat.rpy:2257
translate chinese_simplified story_beat6_7017fd2a:

    # pro "I'm so proud of you, Robin."
    pro "我为你感到骄傲，罗宾。"

# game/storybeat.rpy:2258
translate chinese_simplified story_beat6_84762869:

    # pro "This is a big step for you, and I'm glad that we can do this together."
    pro "这对你来说是一大步，我很高兴我们能一起做到这一点。"

# game/storybeat.rpy:2259
translate chinese_simplified story_beat6_78b2f91d:

    # robin "Yeah, it's kind of scary, but I'm excited."
    robin "是的，这有点可怕，但我很兴奋。"

# game/storybeat.rpy:2260
translate chinese_simplified story_beat6_0c67d249:

    # robin "I've never been this close with someone before, it feels nice."
    robin "我从来没有和一个人如此亲密过，这种感觉真好。"

# game/storybeat.rpy:2261
translate chinese_simplified story_beat6_17a73ef9:

    # "I still feel like he's unsure..."
    "我还是感觉他不太确定..."

# game/storybeat.rpy:2262
translate chinese_simplified story_beat6_e68f4459:

    # "Maybe he doesn't know how devoted I am to him... how much I want this to work."
    "也许他不知道我对他有多忠诚……我有多希望这一切成功。"

# game/storybeat.rpy:2263
translate chinese_simplified story_beat6_9fa56461:

    # "Maybe I should just..."
    "也许我应该..."

# game/storybeat.rpy:2265
translate chinese_simplified story_beat6_c282c949:

    # pro "Hey, Robin?"
    pro "嘿，罗宾？"

# game/storybeat.rpy:2267
translate chinese_simplified story_beat6_51813b74:

    # robin "Yeah?"
    robin "是的？"

# game/storybeat.rpy:2268
translate chinese_simplified story_beat6_a59ba08c:

    # pro "I..."
    pro "我..."

# game/storybeat.rpy:2269
translate chinese_simplified story_beat6_c29f95ca:

    # pro "I love-"
    pro "我爱-"

# game/storybeat.rpy:2272
translate chinese_simplified story_beat6_2ebe7057:

    # "Before the words can leave my mouth, I hear a loud pounding on the front door."
    "话还没说完，我就听到前门被重重地敲击着。"

# game/storybeat.rpy:2273
translate chinese_simplified story_beat6_ffc4e12a:

    # robin "EEH!"
    robin "呃！"

# game/storybeat.rpy:2274
translate chinese_simplified story_beat6_39166dcf:

    # pro "Who is that..."
    pro "那是谁..."

# game/storybeat.rpy:2276
translate chinese_simplified story_beat6_fe839abf:

    # "I go to the front door and check through the peephole."
    "我走到前门，通过猫眼检查。"

# game/storybeat.rpy:2277
translate chinese_simplified story_beat6_9dcd2c29:

    # pro "Hm, there's nobody there..."
    pro "嗯，那里没人……"

# game/storybeat.rpy:2278
translate chinese_simplified story_beat6_195626ba:

    # robin "W-what..."
    robin "什、什么..."

# game/storybeat.rpy:2279
translate chinese_simplified story_beat6_a6aa8850:

    # pro "Weird..."
    pro "诡异的..."

# game/storybeat.rpy:2282
translate chinese_simplified story_beat6_bea6f56b:

    # "I open the door and look around, but there is nobody there."
    "我打开门，环顾四周，但空无一人。"

# game/storybeat.rpy:2283
translate chinese_simplified story_beat6_89a2d431:

    # robin "Whats that..."
    robin "那是什么..."

# game/storybeat.rpy:2284
translate chinese_simplified story_beat6_e9143e8b:

    # "I look down and see a note."
    "我低头看到一张纸条。"

# game/storybeat.rpy:2285
translate chinese_simplified story_beat6_7278c67b:

    # pro "What the fuck..."
    pro "搞什么鬼..."

# game/storybeat.rpy:2287
translate chinese_simplified story_beat6_d9773b9d:

    # "I bend down and pick it up."
    "我弯下腰把它捡起来。"

# game/storybeat.rpy:2288
translate chinese_simplified story_beat6_de8b4b67:

    # pro "This is..."
    pro "这是..."

# game/storybeat.rpy:2289
translate chinese_simplified story_beat6_ef4d91be:

    # pro "A note addressed to Robin..."
    pro "一封写给罗宾的便条……"

# game/storybeat.rpy:2292
translate chinese_simplified story_beat6_989be03e:

    # "I open up the letter and begin to read it to Robin."
    "我打开这封信，开始读给罗宾听。"

# game/storybeat.rpy:2295
translate chinese_simplified story_beat6_6e7b842b:

    # pro "'Dear my sweet Robin...'"
    pro "“亲爱的我亲爱的罗宾……”"

# game/storybeat.rpy:2298
translate chinese_simplified story_beat6_26e005a4:

    # pro "'I'm sorry you felt frightened by me the last time we met...'"
    pro "“很抱歉上次我们见面时你被我吓到了……”"

# game/storybeat.rpy:2301
translate chinese_simplified story_beat6_12851fd8:

    # pro "'But you did not have to move so far from me.'"
    pro "“但你不必离我那么远。”"

# game/storybeat.rpy:2302
translate chinese_simplified story_beat6_9cf9d9f2:

    # robin "What the fuck."
    robin "搞什么鬼。"

# game/storybeat.rpy:2303
translate chinese_simplified story_beat6_ee0a8adf:

    # robin "This is from my stalker..."
    robin "这是我的跟踪者发来的..."

# game/storybeat.rpy:2304
translate chinese_simplified story_beat6_20746ca0:

    # "I read the note some more..."
    "我又读了一些注释..."

# game/storybeat.rpy:2307
translate chinese_simplified story_beat6_82a7764b:

    # pro "'I miss you. I can't wait to see you in person again."
    pro "'我想你。我迫不及待地想再次见到你本人。"

# game/storybeat.rpy:2310
translate chinese_simplified story_beat6_66605e06:

    # pro "'See you soon, my love.'"
    pro "“很快见，我的爱人。”"

# game/storybeat.rpy:2311
translate chinese_simplified story_beat6_004bff31:

    # pro "..."
    pro "..."

# game/storybeat.rpy:2314
translate chinese_simplified story_beat6_80de6757:

    # pro "Robin... are you alright?"
    pro "罗宾……你还好吗？"

# game/storybeat.rpy:2315
translate chinese_simplified story_beat6_abe2461d:

    # "His eyes have gone wide, and tears are welling up in them."
    "他的眼睛睁得大大的，泪水在眼眶里打转。"

# game/storybeat.rpy:2316
translate chinese_simplified story_beat6_b5c2d783:

    # pro "Robin, it's alright. We can figure this out. He can't get in here. You're safe."
    pro "罗宾，没关系。我们可以弄清楚这一点。他进不去这里。你很安全。"

# game/storybeat.rpy:2317
translate chinese_simplified story_beat6_7123960c:

    # robin "Y-Yeah, I..."
    robin "是的，我..."

# game/storybeat.rpy:2318
translate chinese_simplified story_beat6_aca41591:

    # robin "I don't feel so safe..."
    robin "我感觉不太安全..."

# game/storybeat.rpy:2319
translate chinese_simplified story_beat6_a67d8108:

    # pro "Robin..."
    pro "罗宾..."

# game/storybeat.rpy:2320
translate chinese_simplified story_beat6_3e52ff82:

    # pro "Listen to me."
    pro "听我说。"

# game/storybeat.rpy:2321
translate chinese_simplified story_beat6_f0ee89b1:

    # pro "We're going to be okay-"
    pro "我们会没事的-"

# game/storybeat.rpy:2322
translate chinese_simplified story_beat6_5fa99bcb:

    # robin "No... no we aren't."
    robin "不……不，我们不是。"

# game/storybeat.rpy:2323
translate chinese_simplified story_beat6_4a2fdc82:

    # robin "Fuck fuck fuck..."
    robin "他妈的他妈的..."

# game/storybeat.rpy:2324
translate chinese_simplified story_beat6_71826702:

    # robin "I can't believe he found me."
    robin "我不敢相信他找到了我。"

# game/storybeat.rpy:2325
translate chinese_simplified story_beat6_8b0ab240:

    # robin "What if he breaks in..."
    robin "万一他闯进来怎么办……"

# game/storybeat.rpy:2326
translate chinese_simplified story_beat6_a67d8108_1:

    # pro "Robin..."
    pro "罗宾..."

# game/storybeat.rpy:2327
translate chinese_simplified story_beat6_feb1e3a4:

    # pro "Robin please calm down."
    pro "罗宾请冷静。"

# game/storybeat.rpy:2328
translate chinese_simplified story_beat6_39e86371:

    # pro "Listen to me..."
    pro "听我说..."

# game/storybeat.rpy:2329
translate chinese_simplified story_beat6_f8c31f21:

    # pro "I know it's scary, and it feels like your whole world is crashing down around you."
    pro "我知道这很可怕，感觉你周围的整个世界都崩溃了。"

# game/storybeat.rpy:2330
translate chinese_simplified story_beat6_6fc401e7:

    # pro "But I want you to take a deep breath, alright?"
    pro "但我想让你深呼吸，好吗？"

# game/storybeat.rpy:2331
translate chinese_simplified story_beat6_010414c8:

    # pro "Take a deep breath..."
    pro "深吸一口气……"

# game/storybeat.rpy:2334
translate chinese_simplified story_beat6_38cebca3:

    # "Robin runs off into his room."
    "罗宾跑进他的房间。"

# game/storybeat.rpy:2335
translate chinese_simplified story_beat6_e3fec560:

    # pro "Robin!"
    pro "罗宾！"

# game/storybeat.rpy:2338
translate chinese_simplified story_beat6_a49c57db:

    # "Robin slams the door shut."
    "罗宾关上了门。"

# game/storybeat.rpy:2339
translate chinese_simplified story_beat6_8a9c7539:

    # "Fuck, fuck..."
    "他妈的，他妈的……"

# game/storybeat.rpy:2341
translate chinese_simplified story_beat6_05c2be62:

    # "I enter the room and see Robin in the corner of his room."
    "我走进房间，看到罗宾在他房间的角落里。"

# game/storybeat.rpy:2349
translate chinese_simplified story_beat6_a67d8108_2:

    # pro "Robin..."
    pro "罗宾..."

# game/storybeat.rpy:2350
translate chinese_simplified story_beat6_5ed852ca:

    # robin "I knew it... I knew he would find me..."
    robin "我知道...我知道他会找到我..."

# game/storybeat.rpy:2351
translate chinese_simplified story_beat6_2103d045:

    # robin "I knew this wouldn't last forever..."
    robin "我知道这不会永远持续下去......"

# game/storybeat.rpy:2352
translate chinese_simplified story_beat6_f4b2dcaa:

    # robin "Shit... what do I do."
    robin "妈的……我该怎么办。"

# game/storybeat.rpy:2353
translate chinese_simplified story_beat6_ba0976e9:

    # robin "What do I do, [protagonist_name]?"
    robin "我该怎么办，[protagonist_name]？"

# game/storybeat.rpy:2354
translate chinese_simplified story_beat6_ba192134:

    # "His eyes are wide and full of terror. He is absolutely terrified."
    "他的眼睛睁得大大的，充满了恐惧。他绝对害怕了。"

# game/storybeat.rpy:2355
translate chinese_simplified story_beat6_f558c877:

    # pro "We can't panic."
    pro "我们不能惊慌。"

# game/storybeat.rpy:2356
translate chinese_simplified story_beat6_26e40d21:

    # pro "It won't help us to panic. We have to be smart and rational. We have to figure this out together."
    pro "这不会帮助我们恐慌。我们必须聪明、理性。我们必须共同解决这个问题。"

# game/storybeat.rpy:2357
translate chinese_simplified story_beat6_439defec:

    # robin "He's out there right now."
    robin "他现在就在外面。"

# game/storybeat.rpy:2358
translate chinese_simplified story_beat6_4b2e447b:

    # robin "I'm not safe anymore. He knows I live here."
    robin "我不再安全了。他知道我住在这里。"

# game/storybeat.rpy:2359
translate chinese_simplified story_beat6_8cca8499:

    # robin "I... I'm..."
    robin "我……我是……"

# game/storybeat.rpy:2360
translate chinese_simplified story_beat6_36b39d27:

    # robin "What do I do, I don't know what to do..."
    robin "我该怎么办，我不知道该怎么办..."

# game/storybeat.rpy:2361
translate chinese_simplified story_beat6_9272fe76:

    # "He's hyperventilating and crying now, tears streaming down his face."
    "他现在呼吸急促，哭得厉害，泪水从脸上流下来。"

# game/storybeat.rpy:2362
translate chinese_simplified story_beat6_db1c1c53:

    # robin "This is it..."
    robin "就是这个..."

# game/storybeat.rpy:2363
translate chinese_simplified story_beat6_b25b158e:

    # robin "This is my nightmare come to life."
    robin "这是我的噩梦成真了。"

# game/storybeat.rpy:2364
translate chinese_simplified story_beat6_5f766436:

    # pro "No, no... It's okay Robin... You're okay."
    pro "不，不……没关系，罗宾……你没事。"

# game/storybeat.rpy:2365
translate chinese_simplified story_beat6_019a028f:

    # pro "Everything will be okay."
    pro "一切都会好起来的。"

# game/storybeat.rpy:2366
translate chinese_simplified story_beat6_d80dce47:

    # pro "You just need to calm down, and we can figure this out together, okay?"
    pro "你只需要冷静下来，我们可以一起解决这个问题，好吗？"

# game/storybeat.rpy:2367
translate chinese_simplified story_beat6_c88bfd60:

    # pro "I'm not going to let anything happen to you, Robin. I'll make sure of it, no matter what. I'll protect you."
    pro "我不会让你发生任何事，罗宾。无论如何，我都会确保这一点。我会保护你。"

# game/storybeat.rpy:2368
translate chinese_simplified story_beat6_18279255:

    # robin "I... I'm not safe. I need to get out of here."
    robin "我……我不安全。我需要离开这里。"

# game/storybeat.rpy:2369
translate chinese_simplified story_beat6_d596803f:

    # robin "I need to leave."
    robin "我需要离开。"

# game/storybeat.rpy:2370
translate chinese_simplified story_beat6_6ae8dd1a:

    # robin "I need to go somewhere else where nobody knows where I am. I can't stay here."
    robin "我需要去一个没人知道我在哪里的地方。我不能留在这里。"

# game/storybeat.rpy:2371
translate chinese_simplified story_beat6_3770b669:

    # robin "What if he breaks in?"
    robin "如果他闯入怎么办？"

# game/storybeat.rpy:2372
translate chinese_simplified story_beat6_1737112b:

    # robin "What if he tries to do something to me while I'm asleep?"
    robin "如果他想趁我睡着的时候对我做什么怎么办？"

# game/storybeat.rpy:2373
translate chinese_simplified story_beat6_94c00a1e:

    # "Fuck, he's spiraling again."
    "妈的，他又在飞升了。"

# game/storybeat.rpy:2374
translate chinese_simplified story_beat6_b734da46:

    # robin "No, no... I have to leave now, I can't be here any longer..."
    robin "不，不……我必须离开，我不能再待在这里了……"

# game/storybeat.rpy:2375
translate chinese_simplified story_beat6_ea0366dc:

    # pro "Robin, no... listen to me."
    pro "罗宾，不……听我说。"

# game/storybeat.rpy:2376
translate chinese_simplified story_beat6_03464c09:

    # pro "You're panicking."
    pro "你很恐慌。"

# game/storybeat.rpy:2377
translate chinese_simplified story_beat6_e61d5a28:

    # pro "You can't let fear dictate what you do, that's what will get you hurt."
    pro "你不能让恐惧决定你做什么，否则会让你受伤。"

# game/storybeat.rpy:2378
translate chinese_simplified story_beat6_c10f49fe:

    # robin "But..."
    robin "但..."

# game/storybeat.rpy:2379
translate chinese_simplified story_beat6_f2814e5d:

    # robin "I don't want to be hurt. I'm scared. I'm so scared..."
    robin "我不想受伤。我很害怕。我好害怕..."

# game/storybeat.rpy:2380
translate chinese_simplified story_beat6_91b09236:

    # pro "Do you trust me, Robin?"
    pro "你相信我吗，罗宾？"

# game/storybeat.rpy:2381
translate chinese_simplified story_beat6_8dc8bc96:

    # robin "W-what?"
    robin "什、什么？"

# game/storybeat.rpy:2382
translate chinese_simplified story_beat6_6c37f246:

    # pro "Do you trust me? Can you trust me with this?"
    pro "你相信我吗？你能相信我吗？"

# game/storybeat.rpy:2383
translate chinese_simplified story_beat6_57cad898:

    # robin "I trust you, but I'm not sure I trust myself..."
    robin "我相信你，但我不确定我是否相信自己......"

# game/storybeat.rpy:2384
translate chinese_simplified story_beat6_c3135f5b:

    # robin "I can't think clearly... I don't want to make the wrong decision, but I don't know what to do..."
    robin "我无法清晰地思考...我不想做出错误的决定，但我不知道该怎么办..."

# game/storybeat.rpy:2385
translate chinese_simplified story_beat6_3567a5c6:

    # pro "Then follow my lead. Do what I do, and you'll be alright."
    pro "然后跟着我的引导。做我做的事，你就会没事的。"

# game/storybeat.rpy:2386
