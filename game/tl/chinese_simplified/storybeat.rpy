translate chinese_simplified ending1_87a28495:

    # pro "I... I love you Robin."
    pro "我...我爱你罗宾。"

# game/storybeat.rpy:2521
translate chinese_simplified ending1_5e0e9a4c:

    # robin "...!"
    robin "...!"

# game/storybeat.rpy:2522
translate chinese_simplified ending1_13bbb172:

    # robin "L... love?"
    robin "L……爱？"

# game/storybeat.rpy:2523
translate chinese_simplified ending1_7c6b9782:

    # robin "You... you love me?"
    robin "你……你爱我吗？"

# game/storybeat.rpy:2524
translate chinese_simplified ending1_607d3540:

    # pro "Yes, I love you."
    pro "是的，我爱你。"

# game/storybeat.rpy:2525
translate chinese_simplified ending1_9b86348a:

    # pro "You're the most amazing person I've ever met. I would do anything to protect you, Robin."
    pro "你是我见过的最了不起的人。我愿意做任何事情来保护你，罗宾。"

