    # "He's here."
    "他在这里。"

# game/storybeat.rpy:2567
translate chinese_simplified ending1_e2621e57:

    # "He waited until Robin was off stream."
    "他等到罗宾下线。"

# game/storybeat.rpy:2568
translate chinese_simplified ending1_7bd462e9_4:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2569
translate chinese_simplified ending1_7b9874db:

    # "I hear Robin get up and walk towards the door. He's following the plan."
    "我听到罗宾站起来朝门口走去。他正在执行计划。"

# game/storybeat.rpy:2571
