    # pro "Yeah, let's go."
    pro "是的，我们走吧。"

# game/storybeat.rpy:1416
translate chinese_simplified story_beat4_afc68d24:

    # "We enter my room and climb into my bed."
    "我们进入我的房间并爬上我的床。"

# game/storybeat.rpy:1420
translate chinese_simplified story_beat4_7f96ffc0:

    # "We lay in my bed together, my heart racing faster than I've ever felt it."
    "我们一起躺在床上，我的心跳得比以往任何时候都快。"

# game/storybeat.rpy:1421
translate chinese_simplified story_beat4_ca533191:

    # "Robin's ass is facing me, his body pressed up against mine."
    "罗宾的屁股正对着我，他的身体压在我的身上。"

# game/storybeat.rpy:1422
translate chinese_simplified story_beat4_a19e15ef:

    # "Fuck... I really hope I can suppress my dirty thoughts."
    "操……真希望自己能压抑住自己肮脏的念头。"

# game/storybeat.rpy:1423
translate chinese_simplified story_beat4_a934ea41:

    # robin "This is nice..."
    robin "这很好..."

# game/storybeat.rpy:1424
translate chinese_simplified story_beat4_5b16d7fa:

    # pro "Y-yeah... I think so too."
    pro "是的……我也这么认为。"

# game/storybeat.rpy:1425
translate chinese_simplified story_beat4_ccd2aeec:

    # "I can slowly feel a boner start to form in my pants."
    "我可以慢慢地感觉到我的裤子里开始形成骨头。"

# game/storybeat.rpy:1426
translate chinese_simplified story_beat4_9eef029d:

    # "I need to calm the fuck down."
    "我需要他妈的冷静下来。"

# game/storybeat.rpy:1427
translate chinese_simplified story_beat4_713cb2fb:

    # "The feeling of his ass pressed up against my dick isn't helping either."
    "他的屁股压在我鸡巴上的感觉也无济于事。"

# game/storybeat.rpy:1428
translate chinese_simplified story_beat4_4204685f:

    # robin "Your breathing is a little heavy, are you okay?"
