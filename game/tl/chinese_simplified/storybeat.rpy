    pro "哦哦，我很好！"

# game/storybeat.rpy:1430
translate chinese_simplified story_beat4_a5c360b5:

    # pro "Just uh... a little nervous."
    pro "只是呃……有点紧张。"

# game/storybeat.rpy:1431
translate chinese_simplified story_beat4_93c2d877:

    # robin "Nervous?"
    robin "紧张的？"

# game/storybeat.rpy:1432
translate chinese_simplified story_beat4_2fcc1caf:

    # pro "Yeah, it's fine! Don't worry about it!"
    pro "是啊，没问题！别担心！"

# game/storybeat.rpy:1434
translate chinese_simplified story_beat4_357e7314:

