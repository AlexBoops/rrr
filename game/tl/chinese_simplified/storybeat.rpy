    pro "哇，这真是完蛋了。"

# game/storybeat.rpy:1364
translate chinese_simplified story_beat4_fbe6a5e9:

    # robin "Yeah..."
    robin "是的..."

# game/storybeat.rpy:1366
translate chinese_simplified story_beat4_00875e63:

    # robin "A career on the internet has always been my dream, but now that it's become a reality..."
    robin "在互联网上从事职业一直是我的梦想，但现在它已经成为现实......"

# game/storybeat.rpy:1367
translate chinese_simplified story_beat4_e54b5eed:

    # robin "I guess I'm just kind of lost."
    robin "我想我只是有点迷失了。"

# game/storybeat.rpy:1368
translate chinese_simplified story_beat4_d1b429f7:

    # robin "I don't know what I want to do anymore."
    robin "我不知道我想做什么了。"

# game/storybeat.rpy:1369
translate chinese_simplified story_beat4_11c213ee:

    # pro "Hey, if you ever want to talk about anything like this..."
    pro "嘿，如果你想谈论这样的事情......"

# game/storybeat.rpy:1370
translate chinese_simplified story_beat4_1e05d98d:

    # pro "I'm always here for you, okay?"
    pro "我一直在你身边，好吗？"

# game/storybeat.rpy:1371
translate chinese_simplified story_beat4_e1baa4f9:

    # robin "Th-thanks. It means a lot to me."
    robin "谢谢。这对我来说意义重大。"

# game/storybeat.rpy:1372
translate chinese_simplified story_beat4_918aae24:

    # pro "You don't need to have your entire future figured out you know..."
    pro "你不需要弄清楚你的整个未来，你知道......"

# game/storybeat.rpy:1373
translate chinese_simplified story_beat4_a507a988:

