    # pro "Well, as you know, I'm an indie game developer."
    pro "嗯，如你所知，我是一名独立游戏开发者。"

# game/storybeat.rpy:1330
translate chinese_simplified story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "我希望在今年年底之前发布我的项目的第一个版本。"

# game/storybeat.rpy:1331
