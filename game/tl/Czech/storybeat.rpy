    robin "Nemůžu uvěřit, že jsi mě chránil..."

# game/storybeat.rpy:1006
translate czech story_beat3_4cf88b20:

    # "He's still shaking, but I can tell he's relieved."
    "Stále se třese, ale vidím, že se mu ulevilo."

# game/storybeat.rpy:1007
translate czech story_beat3_a86862f3:

    # robin "I thought I was going to have to just stand there and take it."
    robin "Myslel jsem, že tam budu muset jen tak stát a vzít to."

# game/storybeat.rpy:1008
translate czech story_beat3_a67d8108:

    # pro "Robin..."
    pro "Červenka..."

# game/storybeat.rpy:1009
translate czech story_beat3_63019aad:

    # pro "C'mon, let's go."
    pro "Pojď, jdeme."

# game/storybeat.rpy:1010
translate czech story_beat3_81644fc9:

    # robin "N-no it's okay..."
    robin "N-ne to je v pořádku..."

# game/storybeat.rpy:1011
translate czech story_beat3_4996547a:

    # robin "I'm fine I'm just... a little shaken."
    robin "Jsem v pořádku, jen jsem... trochu otřesený."

# game/storybeat.rpy:1012
translate czech story_beat3_dcffc3e3:

    # robin "I still want to hang out."
    robin "Pořád se chci flákat."

# game/storybeat.rpy:1013
translate czech story_beat3_eabb522c:

    # pro "Are you sure?"
    pro "jsi si jistý?"

# game/storybeat.rpy:1014
translate czech story_beat3_e54d2131:

    # robin "Yeah, I'm sure."
    robin "Jo, jsem si jistý."

# game/storybeat.rpy:1015
translate czech story_beat3_82fea0d2:

    # pro "At the very least we should get out of this area."
    pro "Přinejmenším bychom se měli dostat z této oblasti."

# game/storybeat.rpy:1016
translate czech story_beat3_af42bb25:

    # pro "Let's go find a quieter spot to hang out."
    pro "Pojďme si najít klidnější místo, kde se pobavit."

# game/storybeat.rpy:1017
translate czech story_beat3_531cbf7d:

    # robin "Okay..."
    robin "Dobře..."

# game/storybeat.rpy:1020
translate czech story_beat3_2fc7b9aa:

    # "We grab our stuff and find a secluded area away from the other people."
    "Popadneme naše věci a najdeme odlehlou oblast daleko od ostatních lidí."

# game/storybeat.rpy:1021
translate czech story_beat3_614e23cf:

    # "We lay down on the sand."
    "Lehli jsme si na písek."

# game/storybeat.rpy:1027
translate czech story_beat3_91408ff0:

    # robin "You know, I'm not used to people sticking up for me like that."
    robin "Víš, nejsem zvyklý, že se mě lidi takhle zastávají."

# game/storybeat.rpy:1029
translate czech story_beat3_a19fd04b:

    # robin "It was nice..."
    robin "Bylo to pěkné..."

# game/storybeat.rpy:1030
translate czech story_beat3_2570704d:

    # pro "Well, you shouldn't have to deal with shit like that."
    pro "No, neměl bys řešit takové sračky."

# game/storybeat.rpy:1031
translate czech story_beat3_306fa07f:

    # pro "Nobody should."
    pro "Nikdo by neměl."

# game/storybeat.rpy:1033
translate czech story_beat3_0f6a92c0:

    # robin "Yeah, I know."
    robin "Jo, já vím."

# game/storybeat.rpy:1034
translate czech story_beat3_66adfb54:

    # robin "I just don't like causing trouble."
    robin "Jen nerad dělám problémy."

# game/storybeat.rpy:1035
translate czech story_beat3_b069da86:

    # robin "I try to ignore it, but some people just won't leave me alone."
    robin "Snažím se to ignorovat, ale někteří lidé mě prostě nenechají na pokoji."

# game/storybeat.rpy:1036
translate czech story_beat3_4a2d4b85:

    # pro "It's not your fault that they're assholes."
    pro "Není to tvoje chyba, že jsou to kreténi."

# game/storybeat.rpy:1037
translate czech story_beat3_73bad232:

    # pro "You shouldn't have to deal with it, and I'll be happy to step in if anything like that happens again."
    pro "Neměli byste to řešit a pokud se něco podobného bude opakovat, rád zakročím."

# game/storybeat.rpy:1039
translate czech story_beat3_182e045a:

    # robin "Thanks, that means a lot."
    robin "Díky, to hodně znamená."

# game/storybeat.rpy:1040
translate czech story_beat3_e5c00071:

    # robin "You're really..."
    robin "Ty jsi opravdu..."

# game/storybeat.rpy:1041
translate czech story_beat3_553aa927:

    # robin "Really just..."
    robin "Opravdu jen..."

# game/storybeat.rpy:1043
translate czech story_beat3_7bd462e9:

    # robin "..."
    robin "..."

# game/storybeat.rpy:1044
translate czech story_beat3_fde89fdb:

    # robin "Nevermind..."
    robin "Nevadí..."

# game/storybeat.rpy:1045
translate czech story_beat3_2738d110:

    # pro "What is it?"
    pro "Co je to?"

# game/storybeat.rpy:1046
translate czech story_beat3_a3a13bb9:

    # robin "Forget it, don't worry..."
    robin "Zapomeň na to, neboj..."

# game/storybeat.rpy:1047
translate czech story_beat3_4dd3ce4b:

    # "What was he going to say?"
    "Co chtěl říct?"

# game/storybeat.rpy:1048
translate czech story_beat3_a0a2bd06:

    # pro "Um, okay."
    pro "Dobře."

# game/storybeat.rpy:1049
translate czech story_beat3_ab4c7c06:

    # pro "Well, I'm glad you're feeling better."
    pro "No, jsem rád, že se cítíš lépe."

# game/storybeat.rpy:1054
translate czech story_beat3_df54e5ca:

    # "We stare up at the sky and watch the clouds slowly move by."
    "Díváme se na oblohu a pozorujeme, jak se mraky pomalu pohybují kolem."

# game/storybeat.rpy:1055
translate czech story_beat3_51e745d5:

    # pro "Hey Robin, can I ask you a personal question?"
    pro "Ahoj Robine, můžu se tě zeptat na osobní otázku?"

# game/storybeat.rpy:1056
translate czech story_beat3_91ab02b5:

    # robin "Uh, sure."
    robin "Uh, jistě."

# game/storybeat.rpy:1057
translate czech story_beat3_59d0db9d:

    # pro "What was the real reason you left your old place and moved way out here?"
    pro "Jaký byl skutečný důvod, proč jsi opustil své staré místo a odstěhoval se sem?"

# game/storybeat.rpy:1058
translate czech story_beat3_fa7ea6e8:

    # robin "Oh..."
    robin "Ó..."

# game/storybeat.rpy:1059
translate czech story_beat3_46c2f64a:

    # robin "Um... well..."
    robin "Ehm... no..."

# game/storybeat.rpy:1060
translate czech story_beat3_af936a96:

    # pro "It's okay if you don't want to talk about it."
    pro "Nevadí, když o tom nechceš mluvit."

# game/storybeat.rpy:1061
translate czech story_beat3_7bebb2b5:

    # robin "No, it's okay..."
    robin "Ne, to je v pořádku..."

# game/storybeat.rpy:1062
translate czech story_beat3_5ac21870:

    # robin "I've never told anyone about this, but I guess I should talk about it."
    robin "Nikdy jsem o tom nikomu neřekl, ale myslím, že bych o tom měl mluvit."

# game/storybeat.rpy:1063
translate czech story_beat3_d1d0f557:

    # robin "As you know, I'm a live-streamer."
    robin "Jak víte, jsem živý streamer."

# game/storybeat.rpy:1064
translate czech story_beat3_6dbe2305:

    # robin "And I love it, really."
    robin "A miluji to, opravdu."

# game/storybeat.rpy:1065
translate czech story_beat3_62d5e0e7:

    # robin "But theres a ton of creeps online."
    robin "Ale na internetu je spousta strašidelných věcí."

# game/storybeat.rpy:1066
translate czech story_beat3_60dd46d3:

    # robin "At first they were easy to ignore, just block them from my livestream chat and move on."
    robin "Zpočátku je bylo snadné ignorovat, stačí je zablokovat v mém chatu s živým přenosem a jít dál."

# game/storybeat.rpy:1067
translate czech story_beat3_8a8eea0a:

    # robin "But then they harassed me on Twinkr... and FemstaGram..."
    robin "Ale pak mě obtěžovali na Twinkr... a FemstaGram..."

# game/storybeat.rpy:1068
translate czech story_beat3_16c0c4fb:

    # robin "Pretty much just saying creepy things that sexualized me on all my social media platforms."
    robin "V podstatě jen říkat strašidelné věci, které mě sexualizovaly na všech mých platformách sociálních médií."

# game/storybeat.rpy:1069
translate czech story_beat3_c1ec4cef:

    # pro "Whoa, that sounds horrible."
    pro "Fuj, to zní hrozně."

# game/storybeat.rpy:1070
translate czech story_beat3_c14acb61:

    # robin "Yea... it was."
    robin "Jo... to bylo."

# game/storybeat.rpy:1071
translate czech story_beat3_9083d04c:

    # robin "It was manageable though, it's just the internet right?"
    robin "Dalo se to zvládnout, je to jen internet, že?"

# game/storybeat.rpy:1074
translate czech story_beat3_d60ad138:

    # robin "Well, at least thats what I thought..."
    robin "Tedy alespoň jsem si to myslel..."

# game/storybeat.rpy:1078
translate czech story_beat3_2aa7acdd:

    # robin "About a month ago, I heard a knock on my door really late at night."
    robin "Asi před měsícem jsem opravdu pozdě v noci slyšel klepání na moje dveře."

# game/storybeat.rpy:1079
translate czech story_beat3_0a4f663a:

    # robin "I lived by myself in an apartment, so I thought it was weird."
    robin "Bydlela jsem sama v bytě, tak mi to přišlo divné."

# game/storybeat.rpy:1081
translate czech story_beat3_b3fd2eca:

    # robin "But I opened it anyways, and..."
    robin "Ale stejně jsem to otevřel a..."

# game/storybeat.rpy:1085
translate czech story_beat3_ee849a7b:

    # robin "He was there..."
    robin "Byl tam..."

# game/storybeat.rpy:1086
translate czech story_beat3_283dedc6:

    # robin "Somehow, one of the creeps online found out where I lived..."
    robin "Nějakým způsobem, jeden z creepů online zjistil, kde bydlím..."

# game/storybeat.rpy:1087
translate czech story_beat3_7278c67b:

    # pro "What the fuck..."
    pro "Co sakra..."

# game/storybeat.rpy:1088
translate czech story_beat3_84089f4b:

    # robin "I... I was so scared."
    robin "Já... Měl jsem takový strach."

# game/storybeat.rpy:1089
translate czech story_beat3_2d182e8a:

    # robin "I froze and he..."
    robin "Ztuhla jsem a on..."

# game/storybeat.rpy:1091
translate czech story_beat3_3125e9b2:

    # robin "He almost..."
    robin "On skoro..."

# game/storybeat.rpy:1092
translate czech story_beat3_17e44e10:

    # pro "Jesus fucking Christ."
    pro "Ježíš kurva Kriste."

# game/storybeat.rpy:1093
translate czech story_beat3_cce5a599:

    # pro "Did you call the cops?"
    pro "Volal jsi policajty?"

# game/storybeat.rpy:1094
translate czech story_beat3_13f66967:

    # robin "No, I couldn't."
    robin "Ne, nemohl."

# game/storybeat.rpy:1095
translate czech story_beat3_99d7f078:

    # robin "He threatened to tell everyone where I lived and..."
    robin "Vyhrožoval všem, že řekne, kde bydlím a..."

# game/storybeat.rpy:1096
translate czech story_beat3_cd6e7200:

    # robin "I didn't want to risk it."
    robin "Nechtěl jsem to riskovat."

# game/storybeat.rpy:1099
translate czech story_beat3_08898ad9:

    # pro "Oh my god, Robin..."
    pro "Ach můj bože, Robine..."

# game/storybeat.rpy:1100
translate czech story_beat3_0eb0f0f7:

    # pro "That's horrible, I'm so sorry."
    pro "To je hrozné, je mi to moc líto."

# game/storybeat.rpy:1103
translate czech story_beat3_f81922f9:

    # robin "It's okay, I just..."
    robin "To je v pořádku, já jen..."

# game/storybeat.rpy:1104
translate czech story_beat3_4342c269:

    # robin "I had to get out of there."
    robin "Musel jsem odtamtud vypadnout."

# game/storybeat.rpy:1105
translate czech story_beat3_af3a8aec:

    # robin "That's why I came here."
    robin "Proto jsem sem přišel."

# game/storybeat.rpy:1108
translate czech story_beat3_9f244daa:

    # robin "I figured it would be a smaller town, and nobody would bother me."
    robin "Myslel jsem, že to bude menší město a nikdo mě nebude obtěžovat."

# game/storybeat.rpy:1109
translate czech story_beat3_010bc1b8:

    # pro "I'm so sorry you had to go through that, Robin."
    pro "Je mi líto, že jsi tím musel projít, Robine."

# game/storybeat.rpy:1110
translate czech story_beat3_6ae03e37:

    # pro "No one should ever have to go through that."
    pro "Nikdo by tím nikdy neměl projít."

# game/storybeat.rpy:1111
translate czech story_beat3_1c5043fa:

    # robin "It's fine, really."
    robin "Je to v pořádku, opravdu."

# game/storybeat.rpy:1112
translate czech story_beat3_8d0fa7f5:

    # robin "It's kind of nice getting it off my chest..."
    robin "Je docela příjemné to sundat z hrudi..."

# game/storybeat.rpy:1113
translate czech story_beat3_17c9c130:

    # robin "I just hate being..."
    robin "Jen nesnáším být..."

# game/storybeat.rpy:1114
translate czech story_beat3_f1fe2452:

    # robin "So weak."
    robin "Tak slabé."

# game/storybeat.rpy:1118
translate czech story_beat3_cbb7b812:

    # robin "I don't know..."
    robin "Nevím..."

# game/storybeat.rpy:1119
translate czech story_beat3_fd49e948:

    # robin "I'm just worried that the stalker will eventually find me again..."
    robin "Jen se bojím, že mě ten stalker nakonec zase najde..."

# game/storybeat.rpy:1120
translate czech story_beat3_c413cfa0:

    # robin "And that if he does, I won't be able to get away."
    robin "A že jestli to udělá, nebudu moct utéct."

# game/storybeat.rpy:1123
translate czech story_beat3_27f13eb3:

    # pro "Robin, I'll protect you."
    pro "Robine, ochráním tě."

# game/storybeat.rpy:1124
translate czech story_beat3_cfe2a155:

    # pro "If the stalker or anyone else comes after you, I'll be there."
    pro "Pokud za vámi přijde stalker nebo kdokoli jiný, budu tam."

# game/storybeat.rpy:1125
translate czech story_beat3_dc6a7198:

    # robin "I..."
    robin "já..."

# game/storybeat.rpy:1127
translate czech story_beat3_02747ec1:

    # robin "That means a lot to me, thank you."
    robin "Moc to pro mě znamená, děkuji."

# game/storybeat.rpy:1129
translate czech story_beat3_315bc637:

    # system "Robin {color=#918fff}trusts{/color} you a {color=#8AFF59}little bit{/color} more now."
    system "Robin vám teď {color=#918fff}věří{/color} o {color=#8AFF59}trochu{/color} víc."

# game/storybeat.rpy:1134
translate czech story_beat3_6846f444:

    # "I want to hug him."
    "Chci ho obejmout."

# game/storybeat.rpy:1135
translate czech story_beat3_d1f38b56:

    # "I want to hold him and tell him that everything will be okay."
    "Chci ho držet a říct mu, že všechno bude v pořádku."

# game/storybeat.rpy:1136
translate czech story_beat3_e246420e:

    # robin "Um..."
    robin "ehm..."

# game/storybeat.rpy:1137
translate czech story_beat3_8e078ddb:

    # robin "I'm kind of tired, so if you want to go back that's fine."
    robin "Jsem trochu unavený, takže pokud se chcete vrátit, je to v pořádku."

# game/storybeat.rpy:1138
translate czech story_beat3_2b31c75a:

    # pro "Oh, right."
    pro "Jasně."

# game/storybeat.rpy:1139
translate czech story_beat3_93d5acac:

    # pro "Yeah, we should definitely go back."
    pro "Jo, určitě bychom se měli vrátit."

# game/storybeat.rpy:1140
translate czech story_beat3_1c380cc3:

    # robin "Okay, let's pack up and go."
    robin "Dobře, sbalíme se a půjdeme."

# game/storybeat.rpy:1142
translate czech story_beat3_2bffde70:

    # robin "Thanks for listening and letting me talk about this."
    robin "Děkuji, že jste mě poslouchali a nechali mě o tom mluvit."

# game/storybeat.rpy:1144
translate czech story_beat3_cbf3d343:

    # "We pack up and head back to the car."
    "Balíme a vracíme se k autu."

# game/storybeat.rpy:1145
translate czech story_beat3_7d12e478:

    # robin "This was a good day, wasn't it?"
    robin "Tohle byl dobrý den, že?"

# game/storybeat.rpy:1146
translate czech story_beat3_677d0104:

    # pro "Definitely, one of the best days we've had."
    pro "Rozhodně jeden z nejlepších dnů, které jsme měli."

# game/storybeat.rpy:1147
translate czech story_beat3_a5ac5a61:

    # robin "Yeah, I'm glad I decided to come here."
    robin "Jo, jsem rád, že jsem se rozhodl sem přijít."

# game/storybeat.rpy:1148
translate czech story_beat3_5082b2c1:

    # "I'm glad he came here."
    "Jsem rád, že sem přišel."

# game/storybeat.rpy:1149
translate czech story_beat3_f9dff4cb:

    # "We drive back, the radio playing softly in the background."
    "Jedeme zpět, v pozadí tiše hraje rádio."

# game/storybeat.rpy:1150
translate czech story_beat3_1aeb4c2b:

    # "I'm still processing what Robin told me."
    "Stále zpracovávám, co mi Robin řekl."

# game/storybeat.rpy:1151
translate czech story_beat3_eff7bc22:

    # "God, what a fucking asshole."
    "Bože, jaký zasraný debil."

# game/storybeat.rpy:1152
translate czech story_beat3_3b4179f0:

    # "I can't believe someone would do that to him."
    "Nemůžu uvěřit, že by mu to někdo udělal."

# game/storybeat.rpy:1153
translate czech story_beat3_7052fe1a:

    # "Robin is so sweet and innocent, it makes me sick to think that people would prey on him like that."
    "Robin je tak sladký a nevinný, až se mi dělá špatně při pomyšlení, že by ho lidé takhle lovili."

# game/storybeat.rpy:1154
translate czech story_beat3_c870ddbb:

    # "I need to protect him."
    "Musím ho chránit."

# game/storybeat.rpy:1156
translate czech story_beat3_c33f0da3:

    # "After a short drive, we arrive home and head inside our apartment."
    "Po krátké jízdě dorážíme domů a míříme do našeho bytu."

# game/storybeat.rpy:1158
translate czech story_beat3_af480cf8:

    # robin "Well, I'm going to take a shower and then head to bed."
    robin "No, jdu si dát sprchu a pak spát."

# game/storybeat.rpy:1159
translate czech story_beat3_f241d8fd:

    # robin "Today was a lot of fun, thanks again for everything."
    robin "Dnes to bylo hodně zábavné, ještě jednou díky za všechno."

# game/storybeat.rpy:1160
translate czech story_beat3_c4b65fe1:

    # pro "Of course, I'm glad we got to spend the day together."
    pro "Samozřejmě jsem rád, že jsme ten den mohli strávit spolu."

# game/storybeat.rpy:1161
translate czech story_beat3_1c7aa342:

    # robin "Me too, goodnight."
    robin "Já taky, dobrou noc."

# game/storybeat.rpy:1162
translate czech story_beat3_44d8b4ac:

    # pro "Goodnight."
    pro "Dobrou noc."

# game/storybeat.rpy:1164
translate czech story_beat3_5ab325d5:

    # "I watch him walk into the bathroom and hear the shower turn on."
    "Dívám se, jak jde do koupelny a slyším, jak se zapíná sprcha."

# game/storybeat.rpy:1166
translate czech story_beat3_419d1b09:

    # "I enter my room and pass out immediately after I lay down on my bed."
    "Vcházím do svého pokoje a omdlím hned poté, co jsem si lehl na postel."

# game/storybeat.rpy:1167
translate czech story_beat3_d2b847d3:

    # "Today was fun but exhausting."
    "Dnešek byl zábavný, ale vyčerpávající."

# game/storybeat.rpy:1172
translate czech story_beat3_17b738de:

    # system "{color=#FF5454}Progression Level{/color} has increased"
    system "{color=#FF5454}Úroveň postupu{/color} se zvýšila"

# game/storybeat.rpy:1190
translate czech story_beat4_aa0d0ae2:

    # "Fuck, there's a really bad thunderstorm outside..."
    "Sakra, venku je fakt hrozná bouřka..."

# game/storybeat.rpy:1191
translate czech story_beat4_9526ab0f:

    # "I'm sitting at my desk, trying to focus on my work, but the lights keep flickering."
    "Sedím u svého stolu a snažím se soustředit na svou práci, ale světla stále blikají."

# game/storybeat.rpy:1192
translate czech story_beat4_2cb73df8:

    # pro "What if the power goes out...?"
    pro "Co když vypadne proud...?"

# game/storybeat.rpy:1193
translate czech story_beat4_fc3f0bec:

    # pro "Honestly I'm not even going to risk this..."
    pro "Upřímně, nebudu to riskovat..."

# game/storybeat.rpy:1194
translate czech story_beat4_49178709:

    # "I turn off my computer and unplug it from the outlets to prevent a sudden power surge."
    "Vypnu počítač a odpojím ho ze zásuvek, abych zabránil náhlému přepětí."

# game/storybeat.rpy:1195
translate czech story_beat4_f599b714:

    # pro "I guess if I can't do work, I could try chilling in the living room..."
    pro "Myslím, že když nemůžu dělat práci, mohl bych zkusit chladit v obýváku..."

# game/storybeat.rpy:1197
translate czech story_beat4_7a3e8f69:

    # "I leave my room and see Robin already sitting on the couch."
    "Odcházím z pokoje a vidím Robina, jak už sedí na gauči."

# game/storybeat.rpy:1199
translate czech story_beat4_24394ad0:

    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "Hej, tahle bouřka opravdu začíná sílit..."

# game/storybeat.rpy:1200
translate czech story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "Jo, je to tam určitě dost špatné."

# game/storybeat.rpy:1201
translate czech story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "Jak se držíš?"

# game/storybeat.rpy:1202
translate czech story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "Jsem v pořádku, jen jsem nechtěl být zavřený ve svém pokoji pro případ, že by vypadl proud..."

# game/storybeat.rpy:1203
translate czech story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "Aha, měl jsem stejný nápad."

# game/storybeat.rpy:1204
translate czech story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "Stejně nemůžeme nic udělat, že?"

# game/storybeat.rpy:1206
translate czech story_beat4_64a8ddb7:

    # robin "Well, at least it gives us a chance to hang out together."
    robin "No, alespoň nám to dává šanci se spolu pobavit."

# game/storybeat.rpy:1207
translate czech story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "Nevadí, když si pak sednu s tebou?"

# game/storybeat.rpy:1208
translate czech story_beat4_b4dcea1a:

    # robin "Not at all, go ahead."
    robin "Vůbec ne, pokračuj."

# game/storybeat.rpy:1210
translate czech story_beat4_8f6120d3:

    # "I plop down on the couch next to Robin and get comfortable."
    "Lehnu si na pohovku vedle Robina a uklidním se."

# game/storybeat.rpy:1212
translate czech story_beat4_9d413682:

    # robin "So, do you think the power is going to go out?"
    robin "Tak co, myslíš, že vypadne proud?"

# game/storybeat.rpy:1214
translate czech story_beat4_94a704f7:

    # pro "Considering the way this storm is going, it's likely."
    pro "Vzhledem k tomu, jak se tato bouře vyvíjí, je to pravděpodobné."

# game/storybeat.rpy:1216
translate czech story_beat4_7d0ca308:

    # robin "Hopefully not for long, though..."
    robin "Snad ne na dlouho, i když..."

# game/storybeat.rpy:1217
translate czech story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "Máte nějaké svíčky nebo baterky?"

# game/storybeat.rpy:1219
translate czech story_beat4_7590b815:

    # pro "Nope..."
    pro "Ne..."

# game/storybeat.rpy:1220
translate czech story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "Ale byt má jedno nebo dvě záložní světla, která jsou napojena na generátor."

# game/storybeat.rpy:1221
translate czech story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "I když vypadne proud, měli bychom mít nějaké světlo, dokud se znovu nerozsvítí."

# game/storybeat.rpy:1223
translate czech story_beat4_9546838f:

    # robin "That's good..."
    robin "To je dobrý..."

# game/storybeat.rpy:1224
translate czech story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "Víš, poslední dobou jsem o něčem přemýšlel."

# game/storybeat.rpy:1226
translate czech story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "Ó? co to je?"

# game/storybeat.rpy:1228
translate czech story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "No, um... možná je vhodná chvíle se tě na to zeptat, když už spolu mluvíme."

# game/storybeat.rpy:1230
translate czech story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "Uh, co přesně máš na mysli?"

# game/storybeat.rpy:1232
translate czech story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "Vzpomeňte si, jak jsem vám řekl o tom stalkerovi u mě..."

# game/storybeat.rpy:1233
translate czech story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "Víš, na výletě na pláž."

# game/storybeat.rpy:1235
translate czech story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "Samozřejmě si vzpomínám. Viděl jsi ho tady někde nebo co?"

# game/storybeat.rpy:1237
translate czech story_beat4_fcb99189:

    # robin "No, but..."
    robin "Ne, ale..."

# game/storybeat.rpy:1238
translate czech story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "Onehdy v noci jsem slyšel někoho klepat na dveře našeho bytu."

# game/storybeat.rpy:1240
translate czech story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "Co sakra?"

# game/storybeat.rpy:1241
translate czech story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "Podíval jste se na ně?"

# game/storybeat.rpy:1243
translate czech story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "Ne, ale byl jsem opravdu vyděšený."

# game/storybeat.rpy:1244
translate czech story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "Co když je to stejný chlap?"

# game/storybeat.rpy:1245
translate czech story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "Co když mě dokázal najít a on je jen-"

# game/storybeat.rpy:1247
translate czech story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "Hej, to je v pořádku."

# game/storybeat.rpy:1248
translate czech story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "I kdyby to byl on, budu tu, abych tě ochránil."

# game/storybeat.rpy:1253
translate czech story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "Ale co když s sebou přivede další?"

# game/storybeat.rpy:1258
translate czech story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "Nebo se snaží vnutit do našeho bytu?"

# game/storybeat.rpy:1263
translate czech story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "Hej, zpomal Robine..."

# game/storybeat.rpy:1264
translate czech story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "Slibuji, že se to nestane."

# game/storybeat.rpy:1265
translate czech story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "Nevědí, že tu bydlíš..."

# game/storybeat.rpy:1266
translate czech story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "A já jsem tu taky, ochráním tě."

# game/storybeat.rpy:1268
translate czech story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "Podívá se na mě a usměje se."

# game/storybeat.rpy:1269
translate czech story_beat4_531cbf7d:

    # robin "Okay..."
    robin "Dobře..."

# game/storybeat.rpy:1273
translate czech story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "Najednou se místnost ponoří do tmy."

# game/storybeat.rpy:1276
translate czech story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "Cítím, jak mě Robin chytil za hruď a padl na mě."

# game/storybeat.rpy:1277
translate czech story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "Ach můj bože, vypadl proud!"

# game/storybeat.rpy:1279
translate czech story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "Třese se. Cítím, jak mi jeho srdce buší na hrudi."

# game/storybeat.rpy:1280
translate czech story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "To je v pořádku, Robine. Jsem tady."

# game/storybeat.rpy:1284
translate czech story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "Po chvíli se spustí záložní generátor a rozsvítí se tlumené světlo nad gaučem."

# game/storybeat.rpy:1285
translate czech story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "R-robin..."

# game/storybeat.rpy:1286
translate czech story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "Pořád mě svírá za košili, ztěžka a zpanikařeně oddechuje."

# game/storybeat.rpy:1287
translate czech story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "Promiň, já jen..."

# game/storybeat.rpy:1288
translate czech story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "Nemám rád být ve tmě."

# game/storybeat.rpy:1289
translate czech story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "Hej, to je v pořádku. Jsi v bezpečí, dobře?"

# game/storybeat.rpy:1290
translate czech story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "Nedovolím, aby se ti stalo něco špatného, slibuji."

# game/storybeat.rpy:1291
translate czech story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "Cítím, jak se jeho tělo pomalu uvolňuje, jak si zvyká na slabé světlo."

# game/storybeat.rpy:1292
translate czech story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "To je v pořádku, jen musíme počkat, až se znovu zapne proud."

# game/storybeat.rpy:1293
translate czech story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "Promiň, že jsem na tebe takhle spadl..."

# game/storybeat.rpy:1294
translate czech story_beat4_af94f9cb:

    # pro "No worries..."
    pro "Žádný strach..."

# game/storybeat.rpy:1297
translate czech story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "Pomalu ze mě sesedne a znovu se posadí."

# game/storybeat.rpy:1301
translate czech story_beat4_294c5cbd:

    # "Robin looks so scared."
    "Robin vypadá tak vyděšeně."

# game/storybeat.rpy:1302
translate czech story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "Jeho tvář je bledá a trochu se třese."

# game/storybeat.rpy:1303
translate czech story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "Hej, to je v pořádku."

# game/storybeat.rpy:1304
translate czech story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "Jsem si jistý, že napájení bude brzy znovu zapnuto."

# game/storybeat.rpy:1305
translate czech story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "A pamatujte, jsem tady s vámi."

# game/storybeat.rpy:1306
translate czech story_beat4_052f66f1:

    # robin "It's just..."
    robin "Je to jen..."

# game/storybeat.rpy:1307
translate czech story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "Zaklepání na dveře minulou noc... bylo to, jako bych byl znovu sám s tím stalkerem."

# game/storybeat.rpy:1309
translate czech story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "Zní to blbě, ale já to tak cítím..."

# game/storybeat.rpy:1311
translate czech story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "Není to hloupé, Robine. Máte plné právo se bát."

# game/storybeat.rpy:1312
translate czech story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "Ten zážitek byl opravdu traumatický a stále ho zpracováváte."

# game/storybeat.rpy:1313
translate czech story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "Jen věz, že jsem tu pro tebe, dobře?"

# game/storybeat.rpy:1314
translate czech story_beat4_425b462e:

    # robin "Right..."
    robin "Právo..."

# game/storybeat.rpy:1315
translate czech story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "Co obvykle děláš, když tě něco děsí?"

# game/storybeat.rpy:1316
translate czech story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "No, asi se jen snažím rozptýlit."

# game/storybeat.rpy:1317
translate czech story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "Dívejte se na televizi nebo hrajte videohru nebo tak něco."

# game/storybeat.rpy:1318
translate czech story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "To jsou věci, které teď opravdu dělat nemůžu..."

# game/storybeat.rpy:1320
translate czech story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "Chcete místo toho jen mluvit? Možná mi to pomůže se trochu uklidnit."

# game/storybeat.rpy:1322
translate czech story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "Jasně, o čem chceš mluvit?"

# game/storybeat.rpy:1323
translate czech story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "No, myslím, že bychom mohli mluvit o čemkoli."

# game/storybeat.rpy:1324
translate czech story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "A co... naše plány do budoucna?"

# game/storybeat.rpy:1325
translate czech story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "Naše plány do budoucna?"

# game/storybeat.rpy:1326
translate czech story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "Jo, jako tam, kde se uvidíme za rok nebo dva."

# game/storybeat.rpy:1327
translate czech story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "Můžu jít první, jestli chceš."

# game/storybeat.rpy:1328
translate czech story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "Dobře..."

# game/storybeat.rpy:1329
translate czech story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "No, jak víte, jsem nezávislý vývojář her."

# game/storybeat.rpy:1330
translate czech story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "Doufám, že první verze mého projektu vyjde do konce tohoto roku."

# game/storybeat.rpy:1331
translate czech story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "Pokud vše půjde dobře, snad si budu moci dovolit pronajmout studio, kde si mohu najmout tým, který mi pomůže s tvorbou mých her!"

# game/storybeat.rpy:1333
translate czech story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "Páni, to je opravdu ambiciózní!"

# game/storybeat.rpy:1334
translate czech story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "Jo, ale na této hře pracuji už dlouho, takže je vzrušující vidět, jak se daří."

# game/storybeat.rpy:1335
translate czech story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "To je skvělé, těším se na tebe."

# game/storybeat.rpy:1336
translate czech story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "Díky. Takže ano, to mám v plánu."

# game/storybeat.rpy:1339
translate czech story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "Dobře, jsem na řadě."

# game/storybeat.rpy:1340
translate czech story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "No, nejsem si úplně jistý, jak to říct, ale..."

# game/storybeat.rpy:1341
translate czech story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "To je v pořádku, nespěchejte."

# game/storybeat.rpy:1342
translate czech story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "Myslím, že mi Robin {color=#918fff}důvěřuje{/color} natolik, že se mi svěřuje."

# game/storybeat.rpy:1343
translate czech story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "Chci někoho najít..."

# game/storybeat.rpy:1344
translate czech story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "Někoho, kdo mě bude milovat za mě."

# game/storybeat.rpy:1345
translate czech story_beat4_a67d8108:

    # pro "Robin..."
    pro "Červenka..."

# game/storybeat.rpy:1346
translate czech story_beat4_160fe2a1:

    # robin "Maybe that's a little too far ahead for me to be thinking about, but..."
    robin "Možná je to trochu moc dopředu na to, abych o tom přemýšlel, ale..."

# game/storybeat.rpy:1347
translate czech story_beat4_a1839a3e:

    # robin "It's always been a dream of mine to find someone, find a partner."
    robin "Vždy bylo mým snem někoho najít, najít si partnera."

# game/storybeat.rpy:1348
translate czech story_beat4_f205592d:

    # robin "Someone who really loves me and isn't just using me..."
    robin "Někoho, kdo mě opravdu miluje a nejen mě využívá..."

# game/storybeat.rpy:1349
translate czech story_beat4_a30fb4c2:

    # robin "Since I'm a streamer, I rarely leave the house..."
    robin "Vzhledem k tomu, že jsem streamer, málokdy vycházím z domu..."

# game/storybeat.rpy:1350
translate czech story_beat4_dbc99b84:

    # robin "It's hard to meet people."
    robin "Je těžké potkat lidi."

# game/storybeat.rpy:1351
translate czech story_beat4_91ce40d6:

    # robin "Being sexualized all the time online also hasn't been good for my self-worth issues..."
    robin "Být neustále sexualizovaný online také nebylo dobré pro mé problémy s vlastní hodnotou..."

# game/storybeat.rpy:1354
translate czech story_beat4_a972e603:

    # robin "It comes with the job, I guess."
    robin "Asi to přichází s prací."

# game/storybeat.rpy:1355
translate czech story_beat4_6ffbb649:

