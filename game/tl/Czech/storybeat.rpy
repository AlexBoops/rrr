    robin "kurva kurva kurva..."

# game/storybeat.rpy:2324
translate czech story_beat6_71826702:

    # robin "I can't believe he found me."
    robin "Nemůžu uvěřit, že mě našel."

# game/storybeat.rpy:2325
translate czech story_beat6_8b0ab240:

    # robin "What if he breaks in..."
    robin "Co když se vloupe dovnitř..."

# game/storybeat.rpy:2326
translate czech story_beat6_a67d8108_1:

    # pro "Robin..."
    pro "Červenka..."

# game/storybeat.rpy:2327
translate czech story_beat6_feb1e3a4:

    # pro "Robin please calm down."
    pro "Robine, prosím uklidni se."

# game/storybeat.rpy:2328
translate czech story_beat6_39e86371:

    # pro "Listen to me..."
    pro "Poslouchej mě..."

# game/storybeat.rpy:2329
translate czech story_beat6_f8c31f21:

    # pro "I know it's scary, and it feels like your whole world is crashing down around you."
    pro "Vím, že je to děsivé a mám pocit, že se kolem tebe hroutí celý tvůj svět."

# game/storybeat.rpy:2330
translate czech story_beat6_6fc401e7:

    # pro "But I want you to take a deep breath, alright?"
    pro "Ale chci, aby ses zhluboka nadechl, ano?"

# game/storybeat.rpy:2331
translate czech story_beat6_010414c8:

    # pro "Take a deep breath..."
    pro "Zhluboka se nadechněte..."

# game/storybeat.rpy:2334
translate czech story_beat6_38cebca3:

    # "Robin runs off into his room."
    "Robin utíká do svého pokoje."

# game/storybeat.rpy:2335
translate czech story_beat6_e3fec560:

    # pro "Robin!"
    pro "Červenka!"

# game/storybeat.rpy:2338
translate czech story_beat6_a49c57db:

    # "Robin slams the door shut."
    "Robin zabouchne dveře."

# game/storybeat.rpy:2339
translate czech story_beat6_8a9c7539:

    # "Fuck, fuck..."
    "Sakra, kurva..."

# game/storybeat.rpy:2341
translate czech story_beat6_05c2be62:

    # "I enter the room and see Robin in the corner of his room."
    "Vejdu do pokoje a vidím Robina v rohu jeho pokoje."

# game/storybeat.rpy:2349
translate czech story_beat6_a67d8108_2:

    # pro "Robin..."
    pro "Červenka..."

# game/storybeat.rpy:2350
translate czech story_beat6_5ed852ca:

    # robin "I knew it... I knew he would find me..."
    robin "Věděl jsem to... Věděl jsem, že mě najde..."

# game/storybeat.rpy:2351
translate czech story_beat6_2103d045:

    # robin "I knew this wouldn't last forever..."
    robin "Věděl jsem, že to nebude trvat věčně..."

# game/storybeat.rpy:2352
translate czech story_beat6_f4b2dcaa:

    # robin "Shit... what do I do."
    robin "Sakra... co mám dělat."

# game/storybeat.rpy:2353
translate czech story_beat6_ba0976e9:

    # robin "What do I do, [protagonist_name]?"
    robin "Co mám dělat, [protagonist_name]?"

# game/storybeat.rpy:2354
translate czech story_beat6_ba192134:

    # "His eyes are wide and full of terror. He is absolutely terrified."
    "Jeho oči jsou rozšířené a plné hrůzy. Je naprosto vyděšený."

# game/storybeat.rpy:2355
translate czech story_beat6_f558c877:

    # pro "We can't panic."
    pro "Nemůžeme panikařit."

# game/storybeat.rpy:2356
translate czech story_beat6_26e40d21:

    # pro "It won't help us to panic. We have to be smart and rational. We have to figure this out together."
    pro "Nepomůže nám to k panice. Musíme být chytří a racionální. Musíme na to společně přijít."

# game/storybeat.rpy:2357
translate czech story_beat6_439defec:

    # robin "He's out there right now."
    robin "Právě teď je venku."

# game/storybeat.rpy:2358
translate czech story_beat6_4b2e447b:

    # robin "I'm not safe anymore. He knows I live here."
    robin "Už nejsem v bezpečí. Ví, že tady bydlím."

# game/storybeat.rpy:2359
translate czech story_beat6_8cca8499:

    # robin "I... I'm..."
    robin "Já... já jsem..."

# game/storybeat.rpy:2360
translate czech story_beat6_36b39d27:

    # robin "What do I do, I don't know what to do..."
    robin "Co mám dělat, nevím co mám dělat..."

# game/storybeat.rpy:2361
translate czech story_beat6_9272fe76:

    # "He's hyperventilating and crying now, tears streaming down his face."
    "Teď hyperventiluje a pláče, po tvářích mu stékají slzy."

# game/storybeat.rpy:2362
translate czech story_beat6_db1c1c53:

    # robin "This is it..."
    robin "Tohle je ono..."

# game/storybeat.rpy:2363
translate czech story_beat6_b25b158e:

    # robin "This is my nightmare come to life."
    robin "Tohle je moje noční můra, která ožívá."

# game/storybeat.rpy:2364
translate czech story_beat6_5f766436:

    # pro "No, no... It's okay Robin... You're okay."
    pro "Ne, ne... To je v pořádku, Robine... Jsi v pořádku."

# game/storybeat.rpy:2365
translate czech story_beat6_019a028f:

    # pro "Everything will be okay."
    pro "Všechno bude v pořádku."

# game/storybeat.rpy:2366
translate czech story_beat6_d80dce47:

    # pro "You just need to calm down, and we can figure this out together, okay?"
    pro "Jen se musíš uklidnit a můžeme to spolu vyřešit, dobře?"

# game/storybeat.rpy:2367
translate czech story_beat6_c88bfd60:

    # pro "I'm not going to let anything happen to you, Robin. I'll make sure of it, no matter what. I'll protect you."
    pro "Nedovolím, aby se ti něco stalo, Robine. Postarám se o to, ať se děje cokoliv. Budu tě chránit."

# game/storybeat.rpy:2368
translate czech story_beat6_18279255:

    # robin "I... I'm not safe. I need to get out of here."
    robin "Já... nejsem v bezpečí. Potřebuji se odtud dostat."

# game/storybeat.rpy:2369
translate czech story_beat6_d596803f:

    # robin "I need to leave."
    robin "Potřebuji odejít."

# game/storybeat.rpy:2370
translate czech story_beat6_6ae8dd1a:

    # robin "I need to go somewhere else where nobody knows where I am. I can't stay here."
    robin "Musím jít někam jinam, kde nikdo neví, kde jsem. Nemůžu tu zůstat."

# game/storybeat.rpy:2371
translate czech story_beat6_3770b669:

    # robin "What if he breaks in?"
    robin "Co když se vloupe dovnitř?"

# game/storybeat.rpy:2372
translate czech story_beat6_1737112b:

    # robin "What if he tries to do something to me while I'm asleep?"
    robin "Co když se mi pokusí něco udělat, když spím?"

# game/storybeat.rpy:2373
translate czech story_beat6_94c00a1e:

    # "Fuck, he's spiraling again."
    "Sakra, zase se točí do spirály."

# game/storybeat.rpy:2374
translate czech story_beat6_b734da46:

    # robin "No, no... I have to leave now, I can't be here any longer..."
    robin "Ne, ne... musím teď odejít, už tu nemůžu být..."

# game/storybeat.rpy:2375
translate czech story_beat6_ea0366dc:

    # pro "Robin, no... listen to me."
    pro "Robine, ne... poslouchej mě."

# game/storybeat.rpy:2376
translate czech story_beat6_03464c09:

    # pro "You're panicking."
    pro "Jsi panic."

# game/storybeat.rpy:2377
translate czech story_beat6_e61d5a28:

    # pro "You can't let fear dictate what you do, that's what will get you hurt."
    pro "Nesmíš dovolit strachu, aby ti diktoval, co děláš, to je to, co ti ublíží."

# game/storybeat.rpy:2378
translate czech story_beat6_c10f49fe:

    # robin "But..."
    robin "Ale..."

# game/storybeat.rpy:2379
translate czech story_beat6_f2814e5d:

    # robin "I don't want to be hurt. I'm scared. I'm so scared..."
    robin "Nechci být zraněný. Mám strach. já se tak bojím..."

# game/storybeat.rpy:2380
translate czech story_beat6_91b09236:

    # pro "Do you trust me, Robin?"
    pro "Věříš mi, Robine?"

# game/storybeat.rpy:2381
translate czech story_beat6_8dc8bc96:

    # robin "W-what?"
    robin "C-co?"

# game/storybeat.rpy:2382
translate czech story_beat6_6c37f246:

    # pro "Do you trust me? Can you trust me with this?"
    pro "věříš mi? Můžete mi to věřit?"

# game/storybeat.rpy:2383
translate czech story_beat6_57cad898:

    # robin "I trust you, but I'm not sure I trust myself..."
    robin "Věřím ti, ale nejsem si jistý, jestli věřím sám sobě..."

# game/storybeat.rpy:2384
translate czech story_beat6_c3135f5b:

    # robin "I can't think clearly... I don't want to make the wrong decision, but I don't know what to do..."
    robin "Nedokážu jasně myslet... Nechci udělat špatné rozhodnutí, ale nevím, co mám dělat..."

# game/storybeat.rpy:2385
translate czech story_beat6_3567a5c6:

    # pro "Then follow my lead. Do what I do, and you'll be alright."
    pro "Pak následujte mé vedení. Udělej to, co já, a budeš v pořádku."

# game/storybeat.rpy:2386
translate czech story_beat6_0c1aa26a:

    # robin "But I don't want you to get hurt... or worse..."
    robin "Ale nechci, aby ses zranil... nebo ještě hůř..."

# game/storybeat.rpy:2387
translate czech story_beat6_89568f5e:

    # robin "I'm scared."
    robin "Mám strach."

# game/storybeat.rpy:2388
translate czech story_beat6_a9628e64:

    # pro "We're not going to get hurt. I promise."
    pro "Nebudeme se zranit. slibuji."

# game/storybeat.rpy:2389
translate czech story_beat6_b5e5cee4:

    # robin "You can't guarantee that... no one can."
    robin "To nemůžeš zaručit... to nemůže nikdo."

# game/storybeat.rpy:2390
translate czech story_beat6_e7f591e1:

    # robin "I need to go somewhere he won't find me, and then maybe we'll be safe."
    robin "Musím jít někam, kde mě nenajde, a pak možná budeme v bezpečí."

# game/storybeat.rpy:2391
translate czech story_beat6_dc6dc9d0:

    # "I have to make a decision, I have to say something."
    "Musím se rozhodnout, musím něco říct."

# game/storybeat.rpy:2392
translate czech story_beat6_43db7b2c:

    # "Until I make a choice for Robin, he'll continue to spiral."
    "Dokud se pro Robina nerozhodnu, bude pokračovat ve spirále."

# game/storybeat.rpy:2447
translate czech story_beat6_ec012af7:

    # "What should I do?"
    "co mám dělat?"

# game/storybeat.rpy:2459
translate czech ending1_6f18e46b:

    # pro "Robin, listen to me."
    pro "Robine, poslouchej mě."

# game/storybeat.rpy:2460
translate czech ending1_56251f37:

    # pro "I'll confront him, if he even steps a foot near you I'll kick his fucking ass."
    pro "Postavím se mu, pokud se k tobě byť jen postaví, nakopu ho do prdele."

# game/storybeat.rpy:2461
translate czech ending1_30fd2c14:

    # pro "I'm done letting this stupid stalker psychologically torture you like this."
    pro "Skončil jsem s tím, že tě takhle hloupý stalker psychicky mučí."

# game/storybeat.rpy:2462
translate czech ending1_fd1949ec:

    # pro "Let's take this fucker down."
    pro "Vezmeme toho hajzla dolů."

# game/storybeat.rpy:2463
translate czech ending1_b3d003e8:

    # pro "If anything, this could be an opportunity."
    pro "Kdyby něco, tohle by mohla být příležitost."

# game/storybeat.rpy:2464
translate czech ending1_26bad9f7:

    # pro "We could set a trap, bait him into making the first move, and get the police involved."
    pro "Mohli bychom nastražit past, nalákat ho, aby udělal první krok, a zapojit policii."

# game/storybeat.rpy:2465
translate czech ending1_75bfb15e:

    # robin "What..."
    robin "Co..."

# game/storybeat.rpy:2466
translate czech ending1_7ad18170:

    # pro "Don't you want him to face justice? Don't you want him to rot away in a cell for being such a scumbag?"
    pro "Nechcete, aby čelil spravedlnosti? Nechceš, aby shnil v cele za to, že je takový zmetek?"

# game/storybeat.rpy:2467
translate czech ending1_60ca6eb5:

    # robin "I... I want to forget he ever existed and hope I never see his face again."
    robin "Já... chci zapomenout, že kdy existoval, a doufám, že už nikdy neuvidím jeho tvář."

# game/storybeat.rpy:2468
translate czech ending1_697e8cb8:

    # pro "I know you do, but if you just run away from it..."
    pro "Vím, že ano, ale když před tím prostě utečeš..."

# game/storybeat.rpy:2469
translate czech ending1_fa132311:

    # pro "It will always be looming over your head. And it will always have its hooks in you, tugging at you, tormenting you."
    pro "Vždy se vám to bude rýsovat nad hlavou. A vždy bude mít své háčky ve vás, tahat s vámi, trýznit vás."

# game/storybeat.rpy:2470
translate czech ending1_cd0fa110:

    # robin "But... I'm so afraid. I can barely even imagine facing him alone."
    robin "Ale... tak se bojím. Sotva si dokážu představit, že bych mu stála sama."

# game/storybeat.rpy:2471
translate czech ending1_a38acf0f:

    # pro "You're not alone."
    pro "Nejsi sám."

# game/storybeat.rpy:2472
translate czech ending1_507739f8:

    # pro "I'm here, always."
    pro "Jsem tady, vždycky."

# game/storybeat.rpy:2473
translate czech ending1_d55454f1:

    # pro "I'm here to support you."
    pro "Jsem tu, abych vás podpořil."

# game/storybeat.rpy:2474
translate czech ending1_0cc141e3:

    # pro "I'm here to take care of you."
    pro "Jsem tu, abych se o tebe postaral."

# game/storybeat.rpy:2475
translate czech ending1_7bd462e9:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2476
translate czech ending1_5a1b7040:

    # pro "We need to act fast, Robin."
    pro "Musíme jednat rychle, Robine."

# game/storybeat.rpy:2477
translate czech ending1_4545a33b:

    # robin "I don't know... I just don't know. What if I regret it?"
    robin "Nevím... prostě nevím. Co když toho budu litovat?"

# game/storybeat.rpy:2478
translate czech ending1_9a052b3a:

    # pro "Do you trust me?"
    pro "věříš mi?"

# game/storybeat.rpy:2479
translate czech ending1_80617602:

    # robin "Yes, but I'm worried you'll do something stupid or reckless or—"
    robin "Ano, ale obávám se, že uděláte něco hloupého nebo neuváženého nebo..."

# game/storybeat.rpy:2480
translate czech ending1_06295e90:

    # pro "Robin."
    pro "Červenka."

# game/storybeat.rpy:2481
translate czech ending1_7c8ad6f4:

    # pro "We're partners. You and me. Partners. And we're stronger together than apart."
    pro "Jsme partneři. Ty a já. Partneři. A jsme silnější spolu než odděleně."

# game/storybeat.rpy:2482
translate czech ending1_7bd462e9_1:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2486
translate czech ending1_1063c74c:

    # "Robin gets off the floor."
    "Robin se zvedne z podlahy."

# game/storybeat.rpy:2487
translate czech ending1_b3874a90:

    # robin "Alright, but if I die, I'm gonna haunt your ass as a ghost for the rest of eternity."
    robin "Dobře, ale jestli zemřu, budu tě pronásledovat jako duch po zbytek věčnosti."

# game/storybeat.rpy:2488
translate czech ending1_f370dd4f:

    # pro "Deal. Let's do this."
    pro "Jednat. Pojďme na to."

# game/storybeat.rpy:2490
translate czech ending1_47b08dfb:

    # "Robin has a smile on his face again."
    "Robin má opět úsměv na tváři."

# game/storybeat.rpy:2492
translate czech ending1_2a5a7ba2:

    # robin "So, what's the plan?"
    robin "Takže, jaký je plán?"

# game/storybeat.rpy:2494
translate czech ending1_ef66c50c:

    # pro "This creep clearly knows you're with someone."
    pro "Tenhle hlupák jasně ví, že s někým jsi."

# game/storybeat.rpy:2495
translate czech ending1_f8e4eb3d:

    # pro "He's just waiting for an opportunity where you're alone before striking, that's when he has power."
    pro "Jen čeká na příležitost, kdy jste sami, než udeříte, tehdy má moc."

# game/storybeat.rpy:2496
translate czech ending1_d02d9c8c:

    # pro "Given that he was able to disappear after leaving the note, that means he is still somewhere near the building."
    pro "Vzhledem k tomu, že po opuštění poznámky mohl zmizet, znamená to, že je stále někde poblíž budovy."

# game/storybeat.rpy:2497
translate czech ending1_191b0d03:

    # pro "He may even be inside our apartment building, even now."
    pro "Může být dokonce v našem činžovním domě, dokonce i teď."

# game/storybeat.rpy:2498
translate czech ending1_7bd462e9_2:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2499
translate czech ending1_999e07c6:

    # pro "Hey, don't worry. He won't do anything until he knows you're alone and defenseless."
    pro "Hej, neboj se. Neudělá nic, dokud nebude vědět, že jsi sám a bezbranný."

# game/storybeat.rpy:2500
translate czech ending1_5261baf4:

    # pro "So here's my plan."
    pro "Takže tady je můj plán."

# game/storybeat.rpy:2501
translate czech ending1_e482a287:

    # pro "Tonight, when it gets late, turn on your stream and pretend that I'm out of the house."
    pro "Dnes večer, až bude pozdě, zapněte stream a předstírejte, že jsem mimo dům."

# game/storybeat.rpy:2502
translate czech ending1_69415f3e:

    # pro "If he's watching, this will be his chance to strike."
    pro "Pokud se bude dívat, bude to jeho šance zasáhnout."

# game/storybeat.rpy:2503
translate czech ending1_e561669b:

    # pro "At least he'll think so."
    pro "Alespoň si to bude myslet."

# game/storybeat.rpy:2504
translate czech ending1_8b3a9809:

    # pro "I'll hide somewhere and wait for him to appear."
    pro "Někam se schovám a počkám, až se objeví."

# game/storybeat.rpy:2505
translate czech ending1_133bc4d3:

    # pro "I'll also call the cops and have them on stand-by."
    pro "Zavolám také policajty a nechám je v pohotovosti."

# game/storybeat.rpy:2506
translate czech ending1_7a146a6d:

    # robin "That sounds so dangerous..."
    robin "To zní tak nebezpečně..."

# game/storybeat.rpy:2507
translate czech ending1_7498e563:

    # robin "What if he hurts you?"
    robin "Co když ti ublíží?"

# game/storybeat.rpy:2508
translate czech ending1_cc02856f:

    # pro "Trust me, I may look a bit scrawny but I can take care of myself."
    pro "Věř mi, možná vypadám trochu vychrtle, ale dokážu se o sebe postarat."

# game/storybeat.rpy:2509
translate czech ending1_4585dad3:

    # robin "I hope so..."
    robin "To doufám..."

# game/storybeat.rpy:2510
translate czech ending1_3aa0a0fc:

    # pro "Once he shows up, I'll confront him and subdue him."
    pro "Jakmile se objeví, postavím se mu a podřídím si ho."

# game/storybeat.rpy:2511
translate czech ending1_53335d30:

    # pro "And the cops can swoop in to finish the job."
    pro "A policajti se mohou vrhnout a dokončit práci."

# game/storybeat.rpy:2512
translate czech ending1_12bd033e:

    # robin "This feels like a weird dream, I can't believe this is happening..."
    robin "Připadá mi to jako zvláštní sen, nemůžu uvěřit, že se to děje..."

# game/storybeat.rpy:2513
translate czech ending1_8ebc34c4:

    # pro "It's the only way. Otherwise, he'll never leave you alone."
    pro "Je to jediný způsob. Jinak tě nikdy nenechá samotnou."

# game/storybeat.rpy:2514
translate czech ending1_55929a4f:

