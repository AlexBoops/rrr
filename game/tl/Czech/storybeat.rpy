    robin "Necítím se tak bezpečně..."

# game/storybeat.rpy:2319
translate czech story_beat6_a67d8108:

    # pro "Robin..."
    pro "Červenka..."

# game/storybeat.rpy:2320
translate czech story_beat6_3e52ff82:

