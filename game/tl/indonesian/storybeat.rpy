translate indonesian story_beat6_9272fe76:

    # "He's hyperventilating and crying now, tears streaming down his face."
    "Dia terengah-engah dan menangis sekarang, air mata mengalir di wajahnya."

# game/storybeat.rpy:2362
translate indonesian story_beat6_db1c1c53:

