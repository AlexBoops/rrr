# game/storybeat.rpy:1156
translate indonesian story_beat3_c33f0da3:

    # "After a short drive, we arrive home and head inside our apartment."
    "Setelah perjalanan singkat, kami tiba di rumah dan masuk ke dalam apartemen kami."

# game/storybeat.rpy:1158
translate indonesian story_beat3_af480cf8:

    # robin "Well, I'm going to take a shower and then head to bed."
    robin "Baiklah, aku akan mandi lalu tidur."

# game/storybeat.rpy:1159
translate indonesian story_beat3_f241d8fd:

    # robin "Today was a lot of fun, thanks again for everything."
    robin "Hari ini sangat menyenangkan, sekali lagi terima kasih untuk semuanya."

# game/storybeat.rpy:1160
translate indonesian story_beat3_c4b65fe1:

    # pro "Of course, I'm glad we got to spend the day together."
    pro "Tentu saja, aku senang kita bisa menghabiskan hari bersama."

# game/storybeat.rpy:1161
translate indonesian story_beat3_1c7aa342:

    # robin "Me too, goodnight."
    robin "Aku juga, selamat malam."

# game/storybeat.rpy:1162
translate indonesian story_beat3_44d8b4ac:

    # pro "Goodnight."
    pro "Selamat malam."

# game/storybeat.rpy:1164
translate indonesian story_beat3_5ab325d5:

    # "I watch him walk into the bathroom and hear the shower turn on."
    "Aku melihatnya berjalan ke kamar mandi dan mendengar pancuran menyala."

# game/storybeat.rpy:1166
translate indonesian story_beat3_419d1b09:

    # "I enter my room and pass out immediately after I lay down on my bed."
    "Saya memasuki kamar saya dan segera pingsan setelah saya berbaring di tempat tidur."

# game/storybeat.rpy:1167
translate indonesian story_beat3_d2b847d3:

    # "Today was fun but exhausting."
    "Hari ini menyenangkan namun melelahkan."

# game/storybeat.rpy:1172
translate indonesian story_beat3_17b738de:

    # system "{color=#FF5454}Progression Level{/color} has increased"
    system "{color=#FF5454}Tingkat Kemajuan{/color} telah meningkat"

# game/storybeat.rpy:1190
translate indonesian story_beat4_aa0d0ae2:

    # "Fuck, there's a really bad thunderstorm outside..."
    "Sial, ada badai petir yang sangat buruk di luar..."

# game/storybeat.rpy:1191
translate indonesian story_beat4_9526ab0f:

    # "I'm sitting at my desk, trying to focus on my work, but the lights keep flickering."
    "Aku sedang duduk di mejaku, mencoba fokus pada pekerjaanku, tapi lampu terus berkedip."

# game/storybeat.rpy:1192
translate indonesian story_beat4_2cb73df8:

    # pro "What if the power goes out...?"
    pro "Bagaimana jika listrik padam...?"

# game/storybeat.rpy:1193
translate indonesian story_beat4_fc3f0bec:

    # pro "Honestly I'm not even going to risk this..."
    pro "Sejujurnya aku bahkan tidak akan mengambil risiko ini..."

# game/storybeat.rpy:1194
translate indonesian story_beat4_49178709:

    # "I turn off my computer and unplug it from the outlets to prevent a sudden power surge."
    "Saya mematikan komputer saya dan mencabutnya dari stopkontak untuk mencegah lonjakan listrik tiba-tiba."

# game/storybeat.rpy:1195
translate indonesian story_beat4_f599b714:

    # pro "I guess if I can't do work, I could try chilling in the living room..."
    pro "Saya kira jika saya tidak bisa bekerja, saya bisa mencoba bersantai di ruang tamu..."

# game/storybeat.rpy:1197
translate indonesian story_beat4_7a3e8f69:

    # "I leave my room and see Robin already sitting on the couch."
    "Aku meninggalkan kamarku dan melihat Robin sudah duduk di sofa."

# game/storybeat.rpy:1199
translate indonesian story_beat4_24394ad0:

    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "Hei, badai ini benar-benar mulai melanda ya..."

# game/storybeat.rpy:1200
translate indonesian story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "Ya, keadaan diluar sana sangat buruk."

# game/storybeat.rpy:1201
translate indonesian story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "Bagaimana kabarmu?"

# game/storybeat.rpy:1202
translate indonesian story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "Aku baik-baik saja, hanya saja aku tidak ingin dikurung di kamarku kalau-kalau listrik padam..."

# game/storybeat.rpy:1203
translate indonesian story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "Ah, aku juga punya ide yang sama."

# game/storybeat.rpy:1204
translate indonesian story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "Lagi pula, kita tidak bisa menyelesaikan apa pun, bukan?"

# game/storybeat.rpy:1206
translate indonesian story_beat4_64a8ddb7:

    # robin "Well, at least it gives us a chance to hang out together."
    robin "Setidaknya itu memberi kita kesempatan untuk jalan-jalan bersama."

# game/storybeat.rpy:1207
translate indonesian story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "Bolehkah kalau aku duduk bersamamu?"

# game/storybeat.rpy:1208
translate indonesian story_beat4_b4dcea1a:

    # robin "Not at all, go ahead."
    robin "Tidak sama sekali, silakan saja."

# game/storybeat.rpy:1210
translate indonesian story_beat4_8f6120d3:

    # "I plop down on the couch next to Robin and get comfortable."
    "Aku duduk di sofa di sebelah Robin dan merasa nyaman."

# game/storybeat.rpy:1212
translate indonesian story_beat4_9d413682:

    # robin "So, do you think the power is going to go out?"
    robin "Jadi, menurut Anda apakah listrik akan padam?"

# game/storybeat.rpy:1214
translate indonesian story_beat4_94a704f7:

    # pro "Considering the way this storm is going, it's likely."
    pro "Mengingat arah badai ini, hal ini mungkin saja terjadi."

# game/storybeat.rpy:1216
translate indonesian story_beat4_7d0ca308:

    # robin "Hopefully not for long, though..."
    robin "Namun, semoga tidak lama lagi..."

# game/storybeat.rpy:1217
translate indonesian story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "Apakah Anda punya lilin atau senter?"

# game/storybeat.rpy:1219
translate indonesian story_beat4_7590b815:

    # pro "Nope..."
    pro "Tidak..."

# game/storybeat.rpy:1220
translate indonesian story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "Namun apartemen tersebut memiliki satu atau dua lampu cadangan yang dihubungkan ke generator."

# game/storybeat.rpy:1221
translate indonesian story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "Sekalipun listrik padam, kita harus tetap mendapat penerangan sampai listrik kembali menyala."

# game/storybeat.rpy:1223
translate indonesian story_beat4_9546838f:

    # robin "That's good..."
    robin "Itu bagus..."

# game/storybeat.rpy:1224
translate indonesian story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "Kau tahu, aku sedang memikirkan sesuatu akhir-akhir ini."

# game/storybeat.rpy:1226
translate indonesian story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "Oh? Apa itu?"

# game/storybeat.rpy:1228
translate indonesian story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "Baiklah, um... mungkin ini saat yang tepat untuk menanyakan hal ini padamu karena kita sudah ngobrol."

# game/storybeat.rpy:1230
translate indonesian story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "Uh ya, sebenarnya apa yang kamu maksud?"

# game/storybeat.rpy:1232
translate indonesian story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "Ingat bagaimana aku memberitahumu tentang penguntit di tempat lamaku..."

# game/storybeat.rpy:1233
translate indonesian story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "Anda tahu, di perjalanan pantai."

# game/storybeat.rpy:1235
translate indonesian story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "Tentu saja saya ingat. Pernahkah kamu melihatnya di sekitar sini atau apa?"

# game/storybeat.rpy:1237
translate indonesian story_beat4_fcb99189:

    # robin "No, but..."
    robin "Tidak, tapi..."

# game/storybeat.rpy:1238
translate indonesian story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "Suatu malam, saya mendengar seseorang mengetuk pintu apartemen kami."

# game/storybeat.rpy:1240
translate indonesian story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "Apa-apaan ini?"

# game/storybeat.rpy:1241
translate indonesian story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "Apakah Anda melihatnya?"

# game/storybeat.rpy:1243
translate indonesian story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "Tidak, tapi aku benar-benar ketakutan."

# game/storybeat.rpy:1244
translate indonesian story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "Bagaimana jika itu orang yang sama?"

# game/storybeat.rpy:1245
translate indonesian story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "Bagaimana jika dia bisa menemukanku dan dia hanya-"

# game/storybeat.rpy:1247
translate indonesian story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "Hei, tidak apa-apa."

# game/storybeat.rpy:1248
translate indonesian story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "Meskipun itu dia, aku akan berada di sini untuk melindungimu."

# game/storybeat.rpy:1253
translate indonesian story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "Tapi bagaimana jika dia membawa orang lain bersamanya?"

# game/storybeat.rpy:1258
translate indonesian story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "Atau mencoba memaksakan dirinya masuk ke apartemen kita?"

# game/storybeat.rpy:1263
translate indonesian story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "Hei, pelan-pelan Robin..."

# game/storybeat.rpy:1264
translate indonesian story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "Saya berjanji itu tidak akan terjadi."

# game/storybeat.rpy:1265
translate indonesian story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "Mereka tidak tahu kamu tinggal di sini..."

# game/storybeat.rpy:1266
translate indonesian story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "Dan aku di sini juga, aku akan melindungimu."

# game/storybeat.rpy:1268
translate indonesian story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "Dia menatapku dan tersenyum."

# game/storybeat.rpy:1269
translate indonesian story_beat4_531cbf7d:

    # robin "Okay..."
    robin "Oke..."

# game/storybeat.rpy:1273
translate indonesian story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "Tiba-tiba, ruangan menjadi gelap gulita."

# game/storybeat.rpy:1276
translate indonesian story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "Aku merasakan Robin meraih dadaku dan jatuh di atasku."

# game/storybeat.rpy:1277
translate indonesian story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "Ya Tuhan, listrik padam!"

# game/storybeat.rpy:1279
translate indonesian story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "Dia gemetar. Aku bisa merasakan jantungnya berdebar kencang di dadaku."

# game/storybeat.rpy:1280
translate indonesian story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "Tidak apa-apa, Robin. aku di sini."

# game/storybeat.rpy:1284
translate indonesian story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "Setelah beberapa saat, generator cadangan menyala dan lampu redup di atas sofa menyala."

# game/storybeat.rpy:1285
translate indonesian story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "R-robin..."

# game/storybeat.rpy:1286
translate indonesian story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "Dia masih mencengkeram bajuku, napasnya berat dan panik."

# game/storybeat.rpy:1287
translate indonesian story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "Maaf, aku hanya..."

# game/storybeat.rpy:1288
translate indonesian story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "Aku tidak suka berada dalam kegelapan."

# game/storybeat.rpy:1289
translate indonesian story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "Hei, tidak apa-apa. Kamu aman, oke?"

# game/storybeat.rpy:1290
translate indonesian story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "Aku tidak akan membiarkan hal buruk terjadi padamu, aku janji."

# game/storybeat.rpy:1291
translate indonesian story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "Saya bisa merasakan tubuhnya rileks perlahan saat dia terbiasa dengan cahaya redup."

# game/storybeat.rpy:1292
translate indonesian story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "Tidak apa-apa, kita hanya perlu menunggu sampai listrik kembali menyala."

# game/storybeat.rpy:1293
translate indonesian story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "M-maaf karena terjatuh di atasmu seperti itu..."

# game/storybeat.rpy:1294
translate indonesian story_beat4_af94f9cb:

    # pro "No worries..."
    pro "Jangan khawatir..."

# game/storybeat.rpy:1297
translate indonesian story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "Dia perlahan turun dariku dan duduk kembali."

# game/storybeat.rpy:1301
translate indonesian story_beat4_294c5cbd:

    # "Robin looks so scared."
    "Robin terlihat sangat ketakutan."

# game/storybeat.rpy:1302
translate indonesian story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "Wajahnya pucat dan dia sedikit gemetar."

# game/storybeat.rpy:1303
translate indonesian story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "Hei, tidak apa-apa."

# game/storybeat.rpy:1304
translate indonesian story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "Saya yakin listrik akan segera menyala kembali."

# game/storybeat.rpy:1305
translate indonesian story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "Dan ingat, aku di sini bersamamu."

# game/storybeat.rpy:1306
translate indonesian story_beat4_052f66f1:

    # robin "It's just..."
    robin "Hanya saja..."

# game/storybeat.rpy:1307
translate indonesian story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "Ketukan di pintu kemarin malam... rasanya aku sendirian bersama penguntit itu lagi."

# game/storybeat.rpy:1309
translate indonesian story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "Terdengar bodoh memang, tapi itulah yang aku rasakan..."

# game/storybeat.rpy:1311
translate indonesian story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "Itu tidak bodoh, Robin. Anda berhak untuk merasa takut."

# game/storybeat.rpy:1312
translate indonesian story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "Pengalaman itu sungguh traumatis, dan Anda masih memprosesnya."

# game/storybeat.rpy:1313
translate indonesian story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "Ketahuilah bahwa aku di sini untukmu, oke?"

# game/storybeat.rpy:1314
translate indonesian story_beat4_425b462e:

    # robin "Right..."
    robin "Benar..."

# game/storybeat.rpy:1315
translate indonesian story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "Apa yang biasanya kamu lakukan ketika ada sesuatu yang membuatmu takut?"

# game/storybeat.rpy:1316
translate indonesian story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "Yah, kurasa aku hanya mencoba mengalihkan perhatianku."

# game/storybeat.rpy:1317
translate indonesian story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "Tonton TV atau mainkan video game atau apalah."

# game/storybeat.rpy:1318
translate indonesian story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "Itu adalah hal-hal yang sebenarnya tidak dapat saya lakukan saat ini..."

# game/storybeat.rpy:1320
translate indonesian story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "Ingin bicara saja? Mungkin itu bisa membuatku sedikit tenang."

# game/storybeat.rpy:1322
translate indonesian story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "Tentu, apa yang ingin Anda bicarakan?"

# game/storybeat.rpy:1323
translate indonesian story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "Yah, kurasa kita bisa membicarakan apa saja."

# game/storybeat.rpy:1324
translate indonesian story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "Bagaimana dengan... rencana masa depan kita?"

# game/storybeat.rpy:1325
translate indonesian story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "Rencana masa depan kita?"

# game/storybeat.rpy:1326
translate indonesian story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "Ya, seperti apa yang kita lihat dalam satu atau dua tahun ke depan."

# game/storybeat.rpy:1327
translate indonesian story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "Aku bisa pergi dulu, jika kamu mau."

# game/storybeat.rpy:1328
translate indonesian story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "Oke..."

# game/storybeat.rpy:1329
translate indonesian story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "Seperti yang Anda tahu, saya adalah pengembang game indie."

# game/storybeat.rpy:1330
translate indonesian story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "Saya berharap versi pertama proyek saya dirilis pada akhir tahun ini."

# game/storybeat.rpy:1331
translate indonesian story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "Jika semuanya berjalan lancar, semoga saya mampu menyewa studio tempat saya dapat menyewa tim untuk membantu saya membuat game!"

# game/storybeat.rpy:1333
translate indonesian story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "Wah, ambisius sekali!"

# game/storybeat.rpy:1334
translate indonesian story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "Ya, tapi saya sudah lama mengerjakan game ini, jadi sangat menyenangkan melihatnya membuahkan hasil."

# game/storybeat.rpy:1335
translate indonesian story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "Itu sangat keren, aku bersemangat untukmu."

# game/storybeat.rpy:1336
translate indonesian story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "Terima kasih. Jadi ya, itulah yang saya rencanakan untuk dilakukan."

# game/storybeat.rpy:1339
translate indonesian story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "Baiklah, giliranku."

# game/storybeat.rpy:1340
translate indonesian story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "Yah, aku tidak begitu yakin bagaimana mengatakan ini tapi..."

# game/storybeat.rpy:1341
translate indonesian story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "Tidak apa-apa, luangkan waktumu."

# game/storybeat.rpy:1342
translate indonesian story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "Saya rasa Robin {color=#918fff}cukup memercayai{/color} saya sehingga bisa curhat kepada saya."

# game/storybeat.rpy:1343
translate indonesian story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "Aku ingin mencari seseorang..."

# game/storybeat.rpy:1344
translate indonesian story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "Seseorang yang akan mencintaiku untukku."

# game/storybeat.rpy:1345
translate indonesian story_beat4_a67d8108:

    # pro "Robin..."
    pro "Robin..."

