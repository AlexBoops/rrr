    # pro "I'm done letting this stupid stalker psychologically torture you like this."
    pro "Aku sudah selesai membiarkan penguntit bodoh ini menyiksamu secara psikologis seperti ini."

# game/storybeat.rpy:2462
translate indonesian ending1_fd1949ec:

    # pro "Let's take this fucker down."
    pro "Mari kita jatuhkan keparat ini."

# game/storybeat.rpy:2463
translate indonesian ending1_b3d003e8:

    # pro "If anything, this could be an opportunity."
    pro "Jika ada, ini bisa menjadi peluang."

# game/storybeat.rpy:2464
translate indonesian ending1_26bad9f7:

    # pro "We could set a trap, bait him into making the first move, and get the police involved."
    pro "Kita bisa memasang jebakan, memberinya umpan agar mengambil tindakan pertama, dan melibatkan polisi."

# game/storybeat.rpy:2465
translate indonesian ending1_75bfb15e:

    # robin "What..."
    robin "Apa..."

# game/storybeat.rpy:2466
translate indonesian ending1_7ad18170:

    # pro "Don't you want him to face justice? Don't you want him to rot away in a cell for being such a scumbag?"
    pro "Tidakkah Anda ingin dia diadili? Tidakkah kamu ingin dia membusuk di sel karena menjadi bajingan?"

# game/storybeat.rpy:2467
translate indonesian ending1_60ca6eb5:

    # robin "I... I want to forget he ever existed and hope I never see his face again."
    robin "Aku... Aku ingin melupakan dia pernah ada dan berharap aku tidak pernah melihat wajahnya lagi."

# game/storybeat.rpy:2468
translate indonesian ending1_697e8cb8:

    # pro "I know you do, but if you just run away from it..."
    pro "Aku tahu kamu melakukannya, tapi jika kamu lari darinya..."

# game/storybeat.rpy:2469
translate indonesian ending1_fa132311:

    # pro "It will always be looming over your head. And it will always have its hooks in you, tugging at you, tormenting you."
    pro "Itu akan selalu membayangi kepala Anda. Dan hal itu akan selalu ada dalam diri Anda, menarik-narik Anda, menyiksa Anda."

# game/storybeat.rpy:2470
translate indonesian ending1_cd0fa110:

    # robin "But... I'm so afraid. I can barely even imagine facing him alone."
    robin "Tapi... aku sangat takut. Aku bahkan hampir tidak bisa membayangkan menghadapinya sendirian."

# game/storybeat.rpy:2471
translate indonesian ending1_a38acf0f:

    # pro "You're not alone."
    pro "Anda tidak sendirian."

# game/storybeat.rpy:2472
translate indonesian ending1_507739f8:

    # pro "I'm here, always."
    pro "Aku di sini, selalu."

# game/storybeat.rpy:2473
translate indonesian ending1_d55454f1:

    # pro "I'm here to support you."
    pro "Saya di sini untuk mendukung Anda."

# game/storybeat.rpy:2474
translate indonesian ending1_0cc141e3:

    # pro "I'm here to take care of you."
    pro "Aku di sini untuk menjagamu."

# game/storybeat.rpy:2475
translate indonesian ending1_7bd462e9:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2476
translate indonesian ending1_5a1b7040:

    # pro "We need to act fast, Robin."
    pro "Kita harus bertindak cepat, Robin."

# game/storybeat.rpy:2477
translate indonesian ending1_4545a33b:

    # robin "I don't know... I just don't know. What if I regret it?"
    robin "Aku tidak tahu... Aku hanya tidak tahu. Bagaimana jika saya menyesalinya?"

# game/storybeat.rpy:2478
translate indonesian ending1_9a052b3a:

    # pro "Do you trust me?"
    pro "Apakah kamu percaya padaku?"

# game/storybeat.rpy:2479
translate indonesian ending1_80617602:

    # robin "Yes, but I'm worried you'll do something stupid or reckless or—"
    robin "Ya, tapi aku khawatir kamu akan melakukan sesuatu yang bodoh atau sembrono atau—"

# game/storybeat.rpy:2480
translate indonesian ending1_06295e90:

    # pro "Robin."
    pro "Robin."

# game/storybeat.rpy:2481
translate indonesian ending1_7c8ad6f4:

    # pro "We're partners. You and me. Partners. And we're stronger together than apart."
    pro "Kami adalah mitra. Anda dan saya. Mitra. Dan kita lebih kuat bersama-sama daripada terpisah."

# game/storybeat.rpy:2482
translate indonesian ending1_7bd462e9_1:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2486
translate indonesian ending1_1063c74c:

    # "Robin gets off the floor."
    "Robin turun dari lantai."

# game/storybeat.rpy:2487
translate indonesian ending1_b3874a90:

    # robin "Alright, but if I die, I'm gonna haunt your ass as a ghost for the rest of eternity."
    robin "Baiklah, tapi jika aku mati, aku akan menghantuimu sebagai hantu selamanya."

# game/storybeat.rpy:2488
translate indonesian ending1_f370dd4f:

    # pro "Deal. Let's do this."
    pro "Kesepakatan. Ayo lakukan ini."

# game/storybeat.rpy:2490
translate indonesian ending1_47b08dfb:

    # "Robin has a smile on his face again."
    "Robin kembali tersenyum."

# game/storybeat.rpy:2492
translate indonesian ending1_2a5a7ba2:

    # robin "So, what's the plan?"
    robin "Jadi, apa rencananya?"

# game/storybeat.rpy:2494
translate indonesian ending1_ef66c50c:

    # pro "This creep clearly knows you're with someone."
    pro "Orang aneh ini jelas tahu kamu sedang bersama seseorang."

# game/storybeat.rpy:2495
translate indonesian ending1_f8e4eb3d:

    # pro "He's just waiting for an opportunity where you're alone before striking, that's when he has power."
    pro "Dia hanya menunggu kesempatan dimana kamu sendirian sebelum menyerang, saat itulah dia mempunyai kekuatan."

# game/storybeat.rpy:2496
translate indonesian ending1_d02d9c8c:

    # pro "Given that he was able to disappear after leaving the note, that means he is still somewhere near the building."
    pro "Mengingat dia bisa menghilang setelah meninggalkan catatan itu, itu berarti dia masih berada di suatu tempat di dekat gedung tersebut."

# game/storybeat.rpy:2497
translate indonesian ending1_191b0d03:

    # pro "He may even be inside our apartment building, even now."
    pro "Dia bahkan mungkin berada di dalam gedung apartemen kita, bahkan sampai sekarang."

# game/storybeat.rpy:2498
translate indonesian ending1_7bd462e9_2:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2499
