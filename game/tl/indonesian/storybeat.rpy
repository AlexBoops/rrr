    "Aku memasuki kamar dan melihat Robin di sudut kamarnya."

# game/storybeat.rpy:2349
translate indonesian story_beat6_a67d8108_2:

    # pro "Robin..."
    pro "Robin..."

# game/storybeat.rpy:2350
translate indonesian story_beat6_5ed852ca:

