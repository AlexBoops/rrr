    robin "Ini dia..."

# game/storybeat.rpy:2363
translate indonesian story_beat6_b25b158e:

    # robin "This is my nightmare come to life."
    robin "Ini adalah mimpi burukku yang menjadi kenyataan."

# game/storybeat.rpy:2364
translate indonesian story_beat6_5f766436:

    # pro "No, no... It's okay Robin... You're okay."
    pro "Tidak, tidak... Tidak apa-apa Robin... Kamu baik-baik saja."

# game/storybeat.rpy:2365
translate indonesian story_beat6_019a028f:

    # pro "Everything will be okay."
    pro "Semuanya akan baik-baik saja."

# game/storybeat.rpy:2366
translate indonesian story_beat6_d80dce47:

    # pro "You just need to calm down, and we can figure this out together, okay?"
    pro "Kamu hanya perlu tenang, dan kita bisa menyelesaikannya bersama, oke?"

# game/storybeat.rpy:2367
translate indonesian story_beat6_c88bfd60:

    # pro "I'm not going to let anything happen to you, Robin. I'll make sure of it, no matter what. I'll protect you."
    pro "Aku tidak akan membiarkan apapun terjadi padamu, Robin. Aku akan memastikannya, apa pun yang terjadi. aku akan melindungimu."

# game/storybeat.rpy:2368
translate indonesian story_beat6_18279255:

    # robin "I... I'm not safe. I need to get out of here."
    robin "Aku... aku tidak aman. Saya harus keluar dari sini."

# game/storybeat.rpy:2369
translate indonesian story_beat6_d596803f:

    # robin "I need to leave."
    robin "Saya harus pergi."

# game/storybeat.rpy:2370
translate indonesian story_beat6_6ae8dd1a:

    # robin "I need to go somewhere else where nobody knows where I am. I can't stay here."
    robin "Saya harus pergi ke tempat lain di mana tidak ada yang tahu di mana saya berada. Saya tidak bisa tinggal di sini."

# game/storybeat.rpy:2371
translate indonesian story_beat6_3770b669:

    # robin "What if he breaks in?"
    robin "Bagaimana jika dia menerobos masuk?"

# game/storybeat.rpy:2372
translate indonesian story_beat6_1737112b:

    # robin "What if he tries to do something to me while I'm asleep?"
    robin "Bagaimana jika dia mencoba melakukan sesuatu padaku saat aku tertidur?"

# game/storybeat.rpy:2373
translate indonesian story_beat6_94c00a1e:

    # "Fuck, he's spiraling again."
    "Sial, dia berputar lagi."

# game/storybeat.rpy:2374
translate indonesian story_beat6_b734da46:

    # robin "No, no... I have to leave now, I can't be here any longer..."
    robin "Tidak, tidak... aku harus pergi sekarang, aku tidak bisa berada di sini lebih lama lagi..."

# game/storybeat.rpy:2375
translate indonesian story_beat6_ea0366dc:

    # pro "Robin, no... listen to me."
    pro "Robin, tidak... dengarkan aku."

# game/storybeat.rpy:2376
translate indonesian story_beat6_03464c09:

    # pro "You're panicking."
    pro "Anda panik."

