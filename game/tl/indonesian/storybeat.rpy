    # robin "He's out there right now."
    robin "Dia ada di luar sana sekarang."

# game/storybeat.rpy:2358
translate indonesian story_beat6_4b2e447b:

    # robin "I'm not safe anymore. He knows I live here."
    robin "Aku tidak aman lagi. Dia tahu aku tinggal di sini."

# game/storybeat.rpy:2359
translate indonesian story_beat6_8cca8499:

    # robin "I... I'm..."
    robin "aku... aku..."

# game/storybeat.rpy:2360
