translate indonesian story_beat6_e61d5a28:

    # pro "You can't let fear dictate what you do, that's what will get you hurt."
    pro "Kamu tidak boleh membiarkan rasa takut mendikte apa yang kamu lakukan, itulah yang akan membuatmu terluka."

# game/storybeat.rpy:2378
translate indonesian story_beat6_c10f49fe:

    # robin "But..."
    robin "Tetapi..."

# game/storybeat.rpy:2379
translate indonesian story_beat6_f2814e5d:

    # robin "I don't want to be hurt. I'm scared. I'm so scared..."
    robin "Saya tidak ingin terluka. saya takut. aku sangat takut..."

# game/storybeat.rpy:2380
translate indonesian story_beat6_91b09236:

    # pro "Do you trust me, Robin?"
    pro "Apakah kamu percaya padaku, Robin?"

# game/storybeat.rpy:2381
translate indonesian story_beat6_8dc8bc96:

    # robin "W-what?"
    robin "A-apa?"

# game/storybeat.rpy:2382
translate indonesian story_beat6_6c37f246:

    # pro "Do you trust me? Can you trust me with this?"
    pro "Apakah kamu percaya padaku? Bisakah kamu mempercayaiku dengan ini?"

# game/storybeat.rpy:2383
translate indonesian story_beat6_57cad898:

    # robin "I trust you, but I'm not sure I trust myself..."
    robin "Aku percaya padamu, tapi aku tidak yakin aku bisa mempercayai diriku sendiri..."

# game/storybeat.rpy:2384
translate indonesian story_beat6_c3135f5b:

    # robin "I can't think clearly... I don't want to make the wrong decision, but I don't know what to do..."
    robin "Aku tidak bisa berpikir jernih... Aku tidak ingin mengambil keputusan yang salah, tapi aku tidak tahu harus berbuat apa..."

# game/storybeat.rpy:2385
translate indonesian story_beat6_3567a5c6:

    # pro "Then follow my lead. Do what I do, and you'll be alright."
    pro "Kemudian ikuti petunjuk saya. Lakukan apa yang saya lakukan, dan Anda akan baik-baik saja."

# game/storybeat.rpy:2386
translate indonesian story_beat6_0c1aa26a:

    # robin "But I don't want you to get hurt... or worse..."
    robin "Tapi aku tidak ingin kamu terluka... atau lebih buruk lagi..."

# game/storybeat.rpy:2387
translate indonesian story_beat6_89568f5e:

    # robin "I'm scared."
    robin "saya takut."

# game/storybeat.rpy:2388
translate indonesian story_beat6_a9628e64:

    # pro "We're not going to get hurt. I promise."
    pro "Kami tidak akan terluka. Saya berjanji."

# game/storybeat.rpy:2389
translate indonesian story_beat6_b5e5cee4:

    # robin "You can't guarantee that... no one can."
    robin "Anda tidak dapat menjamin bahwa... tidak ada yang bisa."

# game/storybeat.rpy:2390
translate indonesian story_beat6_e7f591e1:

    # robin "I need to go somewhere he won't find me, and then maybe we'll be safe."
    robin "Aku harus pergi ke suatu tempat di mana dia tidak akan menemukanku, dan mungkin kita akan aman."

# game/storybeat.rpy:2391
translate indonesian story_beat6_dc6dc9d0:

    # "I have to make a decision, I have to say something."
    "Saya harus membuat keputusan, saya harus mengatakan sesuatu."

# game/storybeat.rpy:2392
translate indonesian story_beat6_43db7b2c:

    # "Until I make a choice for Robin, he'll continue to spiral."
    "Sampai saya menentukan pilihan untuk Robin, dia akan terus berputar-putar."

# game/storybeat.rpy:2447
translate indonesian story_beat6_ec012af7:

    # "What should I do?"
    "Apa yang harus saya lakukan?"

# game/storybeat.rpy:2459
translate indonesian ending1_6f18e46b:

    # pro "Robin, listen to me."
    pro "Robin, dengarkan aku."

# game/storybeat.rpy:2460
translate indonesian ending1_56251f37:

    # pro "I'll confront him, if he even steps a foot near you I'll kick his fucking ass."
    pro "Aku akan menghadapinya, jika dia melangkah mendekatimu, aku akan menendang pantatnya."

# game/storybeat.rpy:2461
