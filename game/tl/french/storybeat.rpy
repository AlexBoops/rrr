    pro "Oh Dieu merci..."

# game/storybeat.rpy:3421
translate french ending3_146eb2f0:

    # pro "I was so worried..."
    pro "J'étais tellement inquiète..."

# game/storybeat.rpy:3422
translate french ending3_b9566204:

    # cop "We've arrested the man and he's on his way to jail, so he won't be able to harm Mr. Robin anymore."
    cop "Nous avons arrêté l'homme et il est en route vers la prison, il ne pourra donc plus faire de mal à M. Robin."

# game/storybeat.rpy:3423
translate french ending3_8749b116:

    # pro "Can I see him?"
    pro "Puis-je le voir ?"

