translate french story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "Mais l’appartement dispose d’une ou deux lumières de secours reliées à un générateur."

# game/storybeat.rpy:1221
translate french story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "Même en cas de coupure de courant, nous devrions avoir un peu de lumière jusqu'à ce qu'elle revienne."

# game/storybeat.rpy:1223
translate french story_beat4_9546838f:

    # robin "That's good..."
    robin "C'est bien..."

# game/storybeat.rpy:1224
translate french story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "Tu sais, j'ai pensé à quelque chose ces derniers temps."

# game/storybeat.rpy:1226
translate french story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "Oh? Qu'est ce que c'est?"

# game/storybeat.rpy:1228
translate french story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "Eh bien, euh... c'est peut-être le bon moment pour vous demander ça puisque nous parlons déjà."

# game/storybeat.rpy:1230
translate french story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "Euh, à quoi tu fais référence exactement ?"

# game/storybeat.rpy:1232
translate french story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "Rappelez-vous comment je vous ai parlé de ce harceleur chez moi..."

# game/storybeat.rpy:1233
translate french story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "Vous savez, lors d'une sortie à la plage."

# game/storybeat.rpy:1235
translate french story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "Bien sûr, je m'en souviens. L'avez-vous vu par ici ou quoi ?"

# game/storybeat.rpy:1237
translate french story_beat4_fcb99189:

    # robin "No, but..."
    robin "Non, mais..."

# game/storybeat.rpy:1238
translate french story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "L'autre soir, j'ai entendu quelqu'un frapper à la porte de notre appartement."

# game/storybeat.rpy:1240
translate french story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "C'est quoi ce bordel ?"

# game/storybeat.rpy:1241
translate french story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "Les avez-vous regardés ?"

# game/storybeat.rpy:1243
translate french story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "Non, mais j'étais vraiment paniqué."

# game/storybeat.rpy:1244
translate french story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "Et si c'était le même gars ?"

# game/storybeat.rpy:1245
translate french story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "Et s'il était capable de me trouver et qu'il est juste..."

# game/storybeat.rpy:1247
translate french story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "Hé, ça va."

# game/storybeat.rpy:1248
translate french story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "Même si c'est lui, je serai là pour te protéger."

# game/storybeat.rpy:1253
translate french story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "Mais que se passe-t-il s’il amène d’autres personnes avec lui ?"

# game/storybeat.rpy:1258
translate french story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "Ou essaie de s'introduire de force dans notre appartement ?"

# game/storybeat.rpy:1263
translate french story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "Hé, ralentis Robin..."

# game/storybeat.rpy:1264
translate french story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "Je promets que cela n'arrivera pas."

# game/storybeat.rpy:1265
translate french story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "Ils ne savent pas que tu vis ici..."

# game/storybeat.rpy:1266
translate french story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "Et je suis là aussi, je te protégerai."

# game/storybeat.rpy:1268
translate french story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "Il me regarde et sourit."

# game/storybeat.rpy:1269
translate french story_beat4_531cbf7d:

    # robin "Okay..."
    robin "D'accord..."

# game/storybeat.rpy:1273
translate french story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "Soudain, la pièce devient noire."

# game/storybeat.rpy:1276
translate french story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "Je sens Robin attraper ma poitrine et tomber sur moi."

# game/storybeat.rpy:1277
translate french story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "Oh mon Dieu, il y a eu une coupure de courant !"

# game/storybeat.rpy:1279
translate french story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "Il tremble. Je peux sentir son cœur battre contre ma poitrine."

# game/storybeat.rpy:1280
translate french story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "C'est bon, Robin. Je suis ici."

# game/storybeat.rpy:1284
translate french story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "Après quelques instants, le générateur de secours se déclenche et une faible lumière au-dessus du canapé s'allume."

# game/storybeat.rpy:1285
translate french story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "Robin R..."

# game/storybeat.rpy:1286
translate french story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "Il s'agrippe toujours à ma chemise, sa respiration est lourde et paniquée."

# game/storybeat.rpy:1287
translate french story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "Désolé, j'ai juste..."

# game/storybeat.rpy:1288
translate french story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "Je n'aime pas être dans le noir."

# game/storybeat.rpy:1289
translate french story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "Hé, ça va. Tu es en sécurité, d'accord ?"

# game/storybeat.rpy:1290
translate french story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "Je ne laisserai rien de mal t'arriver, je te le promets."

# game/storybeat.rpy:1291
translate french story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "Je peux sentir son corps se détendre lentement à mesure qu'il s'habitue à la faible lumière."

# game/storybeat.rpy:1292
translate french story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "C'est bon, il faut juste attendre que le courant revienne."

# game/storybeat.rpy:1293
translate french story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "Désolé de tomber sur toi comme ça..."

# game/storybeat.rpy:1294
translate french story_beat4_af94f9cb:

    # pro "No worries..."
    pro "Pas de soucis..."

# game/storybeat.rpy:1297
translate french story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "Il se détache lentement de moi et se redresse."

# game/storybeat.rpy:1301
translate french story_beat4_294c5cbd:

    # "Robin looks so scared."
    "Robin a l'air si effrayé."

# game/storybeat.rpy:1302
translate french story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "Son visage est pâle et il tremble un peu."

# game/storybeat.rpy:1303
translate french story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "Hé, ça va."

# game/storybeat.rpy:1304
translate french story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "Je suis sûr que le courant sera bientôt rétabli."

# game/storybeat.rpy:1305
translate french story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "Et rappelez-vous, je suis ici avec vous."

# game/storybeat.rpy:1306
translate french story_beat4_052f66f1:

    # robin "It's just..."
    robin "C'est juste..."

# game/storybeat.rpy:1307
translate french story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "Quand j'ai frappé à la porte l'autre soir... j'avais l'impression d'être à nouveau seul avec ce harceleur."

# game/storybeat.rpy:1309
translate french story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "Cela semble stupide, mais c'est ce que je ressens..."

# game/storybeat.rpy:1311
translate french story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "Ce n'est pas stupide, Robin. Vous avez parfaitement le droit d’avoir peur."

# game/storybeat.rpy:1312
translate french story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "Cette expérience a été vraiment traumatisante et vous êtes encore en train de la vivre."

# game/storybeat.rpy:1313
translate french story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "Sache juste que je suis là pour toi, d'accord ?"

# game/storybeat.rpy:1314
translate french story_beat4_425b462e:

    # robin "Right..."
    robin "Droite..."

# game/storybeat.rpy:1315
translate french story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "Que faites-vous habituellement lorsque quelque chose vous fait peur ?"

# game/storybeat.rpy:1316
translate french story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "Eh bien, je suppose que j'essaie juste de me distraire."

# game/storybeat.rpy:1317
translate french story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "Regardez la télévision ou jouez à un jeu vidéo ou quelque chose du genre."

# game/storybeat.rpy:1318
translate french story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "Ce sont des choses que je ne peux pas vraiment faire pour le moment..."

# game/storybeat.rpy:1320
translate french story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "Tu veux juste parler à la place ? Peut-être que ça m'aidera à me calmer un peu."

# game/storybeat.rpy:1322
translate french story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "Bien sûr, de quoi veux-tu parler ?"

# game/storybeat.rpy:1323
translate french story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "Eh bien, nous pourrions parler de tout, je suppose."

# game/storybeat.rpy:1324
translate french story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "Et... nos projets futurs ?"

# game/storybeat.rpy:1325
translate french story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "Nos projets futurs ?"

# game/storybeat.rpy:1326
translate french story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "Ouais, comme où nous nous voyons dans un an ou deux."

# game/storybeat.rpy:1327
translate french story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "Je peux commencer, si tu veux."

# game/storybeat.rpy:1328
translate french story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "D'accord..."

# game/storybeat.rpy:1329
translate french story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "Eh bien, comme vous le savez, je suis un développeur de jeux indépendant."

# game/storybeat.rpy:1330
translate french story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "J'espère publier la première version de mon projet d'ici la fin de cette année."

# game/storybeat.rpy:1331
translate french story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "Si tout se passe bien, j'espère pouvoir me permettre de louer un studio où je pourrai embaucher une équipe pour m'aider à créer mes jeux !"

# game/storybeat.rpy:1333
translate french story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "Wow, c'est vraiment ambitieux !"

# game/storybeat.rpy:1334
translate french story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "Oui, mais je travaille sur ce jeu depuis longtemps donc c'est excitant de le voir se concrétiser."

# game/storybeat.rpy:1335
translate french story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "C'est trop cool, je suis excité pour toi."

# game/storybeat.rpy:1336
translate french story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "Merci. Alors oui, c'est ce que je compte faire."

# game/storybeat.rpy:1339
translate french story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "Très bien, à mon tour."

# game/storybeat.rpy:1340
translate french story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "Eh bien, je ne sais pas exactement comment dire ça, mais..."

# game/storybeat.rpy:1341
translate french story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "C'est bon, prends ton temps."

# game/storybeat.rpy:1342
translate french story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "Je pense que Robin {color=#918fff}me fait suffisamment confiance{/color} pour se confier à moi."

# game/storybeat.rpy:1343
translate french story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "Je veux trouver quelqu'un..."

# game/storybeat.rpy:1344
translate french story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "Quelqu'un qui m'aimera pour moi."

# game/storybeat.rpy:1345
translate french story_beat4_a67d8108:

    # pro "Robin..."
    pro "Robin..."

# game/storybeat.rpy:1346
translate french story_beat4_160fe2a1:

    # robin "Maybe that's a little too far ahead for me to be thinking about, but..."
    robin "C'est peut-être un peu trop loin pour que j'y pense, mais..."

# game/storybeat.rpy:1347
translate french story_beat4_a1839a3e:

    # robin "It's always been a dream of mine to find someone, find a partner."
    robin "J'ai toujours rêvé de trouver quelqu'un, de trouver un partenaire."

# game/storybeat.rpy:1348
translate french story_beat4_f205592d:

    # robin "Someone who really loves me and isn't just using me..."
    robin "Quelqu'un qui m'aime vraiment et qui ne se contente pas de m'utiliser..."

# game/storybeat.rpy:1349
translate french story_beat4_a30fb4c2:

    # robin "Since I'm a streamer, I rarely leave the house..."
    robin "Depuis que je suis streamer, je sors rarement de la maison..."

# game/storybeat.rpy:1350
translate french story_beat4_dbc99b84:

    # robin "It's hard to meet people."
    robin "C'est difficile de rencontrer des gens."

# game/storybeat.rpy:1351
translate french story_beat4_91ce40d6:

    # robin "Being sexualized all the time online also hasn't been good for my self-worth issues..."
    robin "Être sexualisé tout le temps en ligne n'a pas non plus été bon pour mes problèmes d'estime de soi..."

# game/storybeat.rpy:1354
translate french story_beat4_a972e603:

    # robin "It comes with the job, I guess."
    robin "Cela vient avec le travail, je suppose."

# game/storybeat.rpy:1355
translate french story_beat4_6ffbb649:

    # robin "But it's still hard to deal with."
    robin "Mais cela reste difficile à gérer."

# game/storybeat.rpy:1356
translate french story_beat4_4c3c3006:

    # pro "People online are horny idiots, don't let them get to you."
    pro "Les gens en ligne sont des idiots excités, ne les laissez pas vous atteindre."

# game/storybeat.rpy:1357
translate french story_beat4_e5bde556:

    # robin "I try not to, but it's hard."
    robin "J'essaie de ne pas le faire, mais c'est difficile."

# game/storybeat.rpy:1358
translate french story_beat4_2097a78b:

    # robin "I just want to find someone who sees me for me."
    robin "Je veux juste trouver quelqu'un qui me voit pour moi."

# game/storybeat.rpy:1361
translate french story_beat4_3e312a5b:

    # robin "I don't know... they just make me feel like I'm not worth anything."
    robin "Je ne sais pas... ils me donnent juste l'impression que je ne vaux rien."

# game/storybeat.rpy:1362
translate french story_beat4_2d902c07:

    # robin "Like I'm just a piece of meat to them."
    robin "Comme si je n'étais qu'un morceau de viande pour eux."

# game/storybeat.rpy:1363
translate french story_beat4_606646c1:

    # pro "Wow, that's really fucked up."
    pro "Wow, c'est vraiment foutu."

# game/storybeat.rpy:1364
translate french story_beat4_fbe6a5e9:

    # robin "Yeah..."
    robin "Ouais..."

# game/storybeat.rpy:1366
translate french story_beat4_00875e63:

    # robin "A career on the internet has always been my dream, but now that it's become a reality..."
    robin "Une carrière sur Internet a toujours été mon rêve, mais maintenant que c'est devenu une réalité..."

# game/storybeat.rpy:1367
translate french story_beat4_e54b5eed:

    # robin "I guess I'm just kind of lost."
    robin "Je suppose que je suis juste un peu perdu."

# game/storybeat.rpy:1368
translate french story_beat4_d1b429f7:

    # robin "I don't know what I want to do anymore."
    robin "Je ne sais plus ce que je veux faire."

# game/storybeat.rpy:1369
translate french story_beat4_11c213ee:

    # pro "Hey, if you ever want to talk about anything like this..."
    pro "Hé, si jamais tu veux parler de quelque chose comme ça..."

# game/storybeat.rpy:1370
translate french story_beat4_1e05d98d:

    # pro "I'm always here for you, okay?"
    pro "Je suis toujours là pour toi, d'accord ?"

# game/storybeat.rpy:1371
translate french story_beat4_e1baa4f9:

    # robin "Th-thanks. It means a lot to me."
    robin "Merci. Cela signifie beaucoup pour moi."

# game/storybeat.rpy:1372
translate french story_beat4_918aae24:

    # pro "You don't need to have your entire future figured out you know..."
    pro "Vous n'avez pas besoin de penser à tout votre avenir, vous savez..."

# game/storybeat.rpy:1373
translate french story_beat4_a507a988:

    # pro "Sometimes things just happen unexpectedly."
    pro "Parfois, les choses arrivent de manière inattendue."

# game/storybeat.rpy:1374
translate french story_beat4_e92b6384:

    # pro "Like us, we were complete strangers when you first moved in."
    pro "Comme nous, nous étions de parfaits inconnus lorsque vous avez emménagé."

# game/storybeat.rpy:1375
translate french story_beat4_7464c56d:

    # pro "Now, you're one of the closest friends I have."
    pro "Maintenant, tu es l'un de mes amis les plus proches."

# game/storybeat.rpy:1376
translate french story_beat4_68d7b9aa:

    # robin "Yeah, that's true."
    robin "Ouais, c'est vrai."

# game/storybeat.rpy:1378
translate french story_beat4_970ac64e:

    # robin "I'm glad we became friends."
    robin "Je suis content que nous soyons devenus amis."

# game/storybeat.rpy:1379
translate french story_beat4_4a8af8d0:

    # robin "You make me feel so... comfortable."
    robin "Grâce à toi, je me sens si... à l'aise."

# game/storybeat.rpy:1380
translate french story_beat4_e7c88bc3:

    # robin "I don't know how you do it."
    robin "Je ne sais pas comment tu fais."

# game/storybeat.rpy:1381
translate french story_beat4_e82f048d:

    # pro "It's a gift."
    pro "C'est un cadeau."

# game/storybeat.rpy:1382
translate french story_beat4_fad03f8a:

    # "We laugh together, and for a moment the fear of the dark subsides."
    "Nous rions ensemble et pendant un instant la peur du noir s'apaise."

# game/storybeat.rpy:1385
translate french story_beat4_776782d0:

    # robin "Can I... ask you for something?"
    robin "Puis-je... te demander quelque chose ?"

# game/storybeat.rpy:1386
translate french story_beat4_087f9b10:

    # pro "Of course, what is it?"
    pro "Bien sûr, qu'est-ce que c'est ?"

# game/storybeat.rpy:1387
translate french story_beat4_0f0aad54:

    # robin "If you wouldn't mind, can I sleep in your room tonight?"
    robin "Si cela ne vous dérange pas, puis-je dormir dans votre chambre ce soir ?"

# game/storybeat.rpy:1388
translate french story_beat4_d5239721:

    # robin "If the power doesn't come back on, of course!"
    robin "Si le courant ne revient pas, bien sûr !"

# game/storybeat.rpy:1391
translate french story_beat4_3fb05efa:

    # "His face flushes with embarrassment. It's adorable."
    "Son visage rougit d'embarras. C'est adorable."

# game/storybeat.rpy:1392
translate french story_beat4_653a0356:

    # pro "Sure, you can sleep in my room with me."
    pro "Bien sûr, tu peux dormir dans ma chambre avec moi."

# game/storybeat.rpy:1393
translate french story_beat4_03b2370e:

    # robin "Are you sure it isn't weird?"
