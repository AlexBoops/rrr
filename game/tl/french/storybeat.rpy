translate french ending3_a5c35f8d:

    # robin "I'll be back for my stuff tomorrow..."
    robin "Je reviens chercher mes affaires demain..."

# game/storybeat.rpy:3460
translate french ending3_39e01fef:

    # robin "I can pay for the damages to the door you broke too."
    robin "Je peux aussi payer pour les dommages causés à la porte que vous avez cassée."

# game/storybeat.rpy:3461
translate french ending3_82353b83:

    # pro "Robin... no..."
    pro "Robin... no..."

# game/storybeat.rpy:3462
translate french ending3_ecd229c2:

    # pro "I was... I was just..."
    pro "J'étais... j'étais juste..."

# game/storybeat.rpy:3464
translate french ending3_ed23f47e:

    # "Without another word, he turns around and leaves."
    "Sans un mot, il se retourne et s'en va."

# game/storybeat.rpy:3465
translate french ending3_d0157b79:

    # "I'm alone... again..."
    "Je suis seul... encore une fois..."

# game/storybeat.rpy:3466
translate french ending3_f05b010b:

    # "And this time it's my fault..."
    "Et cette fois c'est de ma faute..."

# game/storybeat.rpy:3467
translate french ending3_5aef4a4b:

    # "I failed him..."
    "Je l'ai laissé tomber..."

# game/storybeat.rpy:3468
translate french ending3_e7c39007:

    # "I told him to trust me..."
    "Je lui ai dit de me faire confiance..."

# game/storybeat.rpy:3469
translate french ending3_050bae79:

    # "If maybe I had stayed up with him... or even just ran away with him."
    "Si peut-être j'étais resté avec lui... ou même si j'avais simplement fui avec lui."

# game/storybeat.rpy:3470
translate french ending3_d3121992:

    # "This wouldn't have happened."
    "Cela ne serait pas arrivé."

# game/storybeat.rpy:3472
translate french ending3_faa87652:

    # "I... I don't even know what to think."
    "Je... je ne sais même pas quoi penser."

# game/storybeat.rpy:3473
translate french ending3_b39c2d35:

    # "What do I do now...?"
    "Que dois-je faire maintenant...?"

# game/storybeat.rpy:3474
translate french ending3_52323f8f:

    # "Was this the end of things?"
    "Était-ce la fin des choses ?"

# game/storybeat.rpy:3475
translate french ending3_60a1cb87:

    # "I guess so..."
    "Je crois que oui..."

# game/storybeat.rpy:3476
translate french ending3_806de563:

    # "I'm... I'm horrible."
    "Je suis... je suis horrible."

# game/storybeat.rpy:3481
