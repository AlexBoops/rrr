    # pro "My statement..."
    pro "Ma déclaration..."

# game/storybeat.rpy:3414
translate french ending3_033f5306:

    # "The police ask me questions regarding what happened."
    "La police me pose des questions sur ce qui s'est passé."

# game/storybeat.rpy:3415
translate french ending3_5ef0727a:

    # "Apparently, by the time they had arrived to the apartment, I had already beaten and knocked out the stalker."
    "Apparemment, au moment où ils sont arrivés à l'appartement, j'avais déjà battu et assommé le harceleur."

# game/storybeat.rpy:3416
translate french ending3_7fb94011:

    # "I can barely remember anything, I feel like I blacked out."
    "Je ne me souviens presque de rien, j’ai l’impression de m’être évanoui."

# game/storybeat.rpy:3417
translate french ending3_8b6b99dd:

    # pro "And where is Robin?"
    pro "Et où est Robin ?"

# game/storybeat.rpy:3418
translate french ending3_dd25b953:

    # cop "We had a paramedic look him over, but he's okay."
    cop "Nous avons demandé à un ambulancier de l'examiner, mais il va bien."

# game/storybeat.rpy:3419
translate french ending3_fd769f77:

    # cop "Just shaken up, and bruised."
    cop "Juste secoué et meurtri."

