    # robin "I'm sorry."
    robin "Je suis désolé."

# game/storybeat.rpy:3457
translate french ending3_c4911750:

    # "I'm stunned. I don't know what to say."
    "Je suis abasourdi. Je ne sais pas quoi dire."

# game/storybeat.rpy:3458
translate french ending3_05a42722:

    # robin "I'm going to stay at a motel tonight. Don't bother trying to contact me."
    robin "Je vais rester dans un motel ce soir. N'essayez pas de me contacter."

