    robin "Bugün çok eğlenceliydi, her şey için tekrar teşekkürler."

# game/storybeat.rpy:1160
translate turkish story_beat3_c4b65fe1:

    # pro "Of course, I'm glad we got to spend the day together."
    pro "Tabii ki, günü birlikte geçirmemize sevindim."

# game/storybeat.rpy:1161
translate turkish story_beat3_1c7aa342:

    # robin "Me too, goodnight."
    robin "Ben de iyi geceler."

# game/storybeat.rpy:1162
translate turkish story_beat3_44d8b4ac:

    # pro "Goodnight."
    pro "İyi geceler."

# game/storybeat.rpy:1164
translate turkish story_beat3_5ab325d5:

    # "I watch him walk into the bathroom and hear the shower turn on."
    "Banyoya girmesini ve duşun açıldığını duymasını izliyorum."

# game/storybeat.rpy:1166
translate turkish story_beat3_419d1b09:

    # "I enter my room and pass out immediately after I lay down on my bed."
    "Odama giriyorum ve yatağıma uzandıktan hemen sonra bayılıyorum."

# game/storybeat.rpy:1167
translate turkish story_beat3_d2b847d3:

    # "Today was fun but exhausting."
    "Bugün eğlenceli ama yorucuydu."

# game/storybeat.rpy:1172
translate turkish story_beat3_17b738de:

    # system "{color=#FF5454}Progression Level{/color} has increased"
    system "{color=#FF5454} ilerleme seviyesi {/color} arttı"

# game/storybeat.rpy:1190
translate turkish story_beat4_aa0d0ae2:

    # "Fuck, there's a really bad thunderstorm outside..."
    "Siktir et, dışarıda gerçekten kötü bir fırtına var ..."

# game/storybeat.rpy:1191
translate turkish story_beat4_9526ab0f:

    # "I'm sitting at my desk, trying to focus on my work, but the lights keep flickering."
    "Masamda oturuyorum, işime odaklanmaya çalışıyorum, ama ışıklar titremeye devam ediyor."

# game/storybeat.rpy:1192
translate turkish story_beat4_2cb73df8:

    # pro "What if the power goes out...?"
    pro "Ya güç sönerse ...?"

# game/storybeat.rpy:1193
translate turkish story_beat4_fc3f0bec:

    # pro "Honestly I'm not even going to risk this..."
    pro "Dürüst olmak gerekirse, bunu riske atmayacağım bile ..."

# game/storybeat.rpy:1194
translate turkish story_beat4_49178709:

    # "I turn off my computer and unplug it from the outlets to prevent a sudden power surge."
    "Ani bir güç artışını önlemek için bilgisayarımı kapatıp çıkışlardan çıkarıyorum."

# game/storybeat.rpy:1195
translate turkish story_beat4_f599b714:

    # pro "I guess if I can't do work, I could try chilling in the living room..."
    pro "Sanırım iş yapamazsam, oturma odasında soğumayı deneyebilirim ..."

# game/storybeat.rpy:1197
translate turkish story_beat4_7a3e8f69:

    # "I leave my room and see Robin already sitting on the couch."
    "Odamdan ayrılıyorum ve Robin'i zaten kanepede otururken görüyorum."

# game/storybeat.rpy:1199
translate turkish story_beat4_24394ad0:

    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "Hey, bu fırtına gerçekten yükselmeye başlıyor ha ..."

# game/storybeat.rpy:1200
translate turkish story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "Evet, orada kesinlikle oldukça kötü."

# game/storybeat.rpy:1201
translate turkish story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "Nasıl duruyorsun?"

# game/storybeat.rpy:1202
translate turkish story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "İyiyim, gücün sönmesi durumunda odamda kilitlenmek istemedim ..."

# game/storybeat.rpy:1203
translate turkish story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "Ah, aynı fikrim vardı."

# game/storybeat.rpy:1204
translate turkish story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "Zaten hiçbir şey yapabileceğimiz gibi değil, değil mi?"

# game/storybeat.rpy:1206
translate turkish story_beat4_64a8ddb7:

    # robin "Well, at least it gives us a chance to hang out together."
    robin "En azından bize birlikte takılma şansı veriyor."

# game/storybeat.rpy:1207
translate turkish story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "O zaman seninle oturursam bir sakıncası?"

# game/storybeat.rpy:1208
translate turkish story_beat4_b4dcea1a:

    # robin "Not at all, go ahead."
    robin "Hiç de değil, devam et."

# game/storybeat.rpy:1210
translate turkish story_beat4_8f6120d3:

    # "I plop down on the couch next to Robin and get comfortable."
    "Robin'in yanındaki kanepeye iniyorum ve rahat ediyorum."

# game/storybeat.rpy:1212
translate turkish story_beat4_9d413682:

    # robin "So, do you think the power is going to go out?"
    robin "Öyleyse, gücün dışarı çıkacağını düşünüyor musunuz?"

# game/storybeat.rpy:1214
translate turkish story_beat4_94a704f7:

    # pro "Considering the way this storm is going, it's likely."
    pro "Bu fırtınanın nasıl gittiğini göz önünde bulundurarak, muhtemelen."

# game/storybeat.rpy:1216
translate turkish story_beat4_7d0ca308:

    # robin "Hopefully not for long, though..."
    robin "Umarım uzun sürmez ..."

# game/storybeat.rpy:1217
translate turkish story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "Mum veya el feneriniz var mı?"

# game/storybeat.rpy:1219
translate turkish story_beat4_7590b815:

    # pro "Nope..."
    pro "Hayır..."

# game/storybeat.rpy:1220
translate turkish story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "Ancak dairede bir jeneratöre bağlanmış bir veya iki yedekleme ışığı var."

# game/storybeat.rpy:1221
translate turkish story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "Güç sönmüş olsa bile, geri dönene kadar biraz ışık almalıyız."

# game/storybeat.rpy:1223
translate turkish story_beat4_9546838f:

    # robin "That's good..."
    robin "Bu iyi..."

# game/storybeat.rpy:1224
translate turkish story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "Bilirsiniz, son zamanlarda bir şeyler düşünüyordum."

# game/storybeat.rpy:1226
translate turkish story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "Ah? Bu da ne?"

# game/storybeat.rpy:1228
translate turkish story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "Peki, um ... belki de zaten konuştuğumuz için size bunu sormak için iyi bir zaman."

# game/storybeat.rpy:1230
translate turkish story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "Uh huh, tam olarak neye atıfta bulunuyorsun?"

# game/storybeat.rpy:1232
translate turkish story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "Sana eski yerimdeki o takipçiyi nasıl anlattığımı hatırla ..."

# game/storybeat.rpy:1233
translate turkish story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "Bilirsiniz, plaj gezisinde."

# game/storybeat.rpy:1235
translate turkish story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "Tabii ki hatırlıyorum. Onu burada gördün mü?"

# game/storybeat.rpy:1237
translate turkish story_beat4_fcb99189:

    # robin "No, but..."
    robin "Hayır, ama ..."

# game/storybeat.rpy:1238
translate turkish story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "Geçen gece, birinin apartman kapımızı çaldığını duydum."

# game/storybeat.rpy:1240
translate turkish story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "Ne lanet?"

# game/storybeat.rpy:1241
translate turkish story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "Onlara bir göz attın mı?"

# game/storybeat.rpy:1243
translate turkish story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "Hayır, ama gerçekten korktum."

# game/storybeat.rpy:1244
translate turkish story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "Ya aynı adamsa?"

# game/storybeat.rpy:1245
translate turkish story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "Ya beni bulabilseydi ve sadece-"

# game/storybeat.rpy:1247
translate turkish story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "Hey, sorun değil."

# game/storybeat.rpy:1248
translate turkish story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "O olsa bile, seni korumak için burada olacağım."

# game/storybeat.rpy:1253
translate turkish story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "Peki ya başkalarını yanına getirirse?"

# game/storybeat.rpy:1258
translate turkish story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "Yoksa kendini dairemize zorlamaya mı çalışıyor?"

# game/storybeat.rpy:1263
translate turkish story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "Hey, Robin'i yavaşlat ..."

# game/storybeat.rpy:1264
translate turkish story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "Bunun olmayacağına söz veriyorum."

# game/storybeat.rpy:1265
translate turkish story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "Burada yaşadığını bilmiyorlar ..."

# game/storybeat.rpy:1266
translate turkish story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "Ve ben de buradayım, seni koruyacağım."

# game/storybeat.rpy:1268
translate turkish story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "Bana bakıyor ve gülümsüyor."

# game/storybeat.rpy:1269
translate turkish story_beat4_531cbf7d:

    # robin "Okay..."
    robin "Tamam aşkım..."

# game/storybeat.rpy:1273
translate turkish story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "Aniden, oda zifiri siyahlaşıyor."

# game/storybeat.rpy:1276
translate turkish story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "Robin'in göğsümü aldığını ve üstüme düştüğünü hissediyorum."

# game/storybeat.rpy:1277
translate turkish story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "Aman tanrım, güç söndü!"

# game/storybeat.rpy:1279
translate turkish story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "Sallanıyor. Kalbinin göğsüme çarptığını hissedebiliyorum."

# game/storybeat.rpy:1280
translate turkish story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "Sorun değil, Robin. Tam buradayım."

# game/storybeat.rpy:1284
translate turkish story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "Birkaç dakika sonra, yedek jeneratör içeri girer ve kanepenin üzerindeki loş bir ışık açılır."

# game/storybeat.rpy:1285
translate turkish story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "R-Robin ..."

# game/storybeat.rpy:1286
translate turkish story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "Hala gömleğime sürüklüyor, nefes alıyor ağır ve panikliyor."

# game/storybeat.rpy:1287
translate turkish story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "Üzgünüm, ben sadece ..."

# game/storybeat.rpy:1288
translate turkish story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "Karanlıkta olmayı sevmiyorum."

# game/storybeat.rpy:1289
translate turkish story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "Hey, sorun değil. Güvendesin, tamam mı?"

# game/storybeat.rpy:1290
translate turkish story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "Sana kötü bir şey olmasına izin vermeyeceğim, söz veriyorum."

# game/storybeat.rpy:1291
translate turkish story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "Loş ışığa alıştıkça vücudunun yavaşça rahatladığını hissedebiliyorum."

# game/storybeat.rpy:1292
translate turkish story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "Sorun değil, sadece güç geri dönene kadar beklememiz gerekiyor."

# game/storybeat.rpy:1293
translate turkish story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "Sizlerin üstüne düşme hakkında böyle ..."

# game/storybeat.rpy:1294
translate turkish story_beat4_af94f9cb:

    # pro "No worries..."
    pro "Endişelenme..."

# game/storybeat.rpy:1297
translate turkish story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "Yavaşça benden inip tekrar oturuyor."

# game/storybeat.rpy:1301
translate turkish story_beat4_294c5cbd:

    # "Robin looks so scared."
    "Robin çok korkmuş görünüyor."

# game/storybeat.rpy:1302
translate turkish story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "Yüzü solgun ve biraz titriyor."

# game/storybeat.rpy:1303
translate turkish story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "Hey, sorun değil."

# game/storybeat.rpy:1304
translate turkish story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "Eminim güç yakında tekrar devam edecek."

# game/storybeat.rpy:1305
translate turkish story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "Ve unutmayın, tam buradayım."

# game/storybeat.rpy:1306
translate turkish story_beat4_052f66f1:

    # robin "It's just..."
    robin "Sadece ..."

# game/storybeat.rpy:1307
translate turkish story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "Geçen gece kapıyı çaldı ... o takipçiyle tekrar yalnız olduğumu hissettim."

# game/storybeat.rpy:1309
translate turkish story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "Kulağa aptal geliyor, ama böyle hissediyorum ..."

# game/storybeat.rpy:1311
translate turkish story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "Aptal değil Robin. Korkma hakkınız var."

# game/storybeat.rpy:1312
translate turkish story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "Bu deneyim gerçekten travmatikti ve hala işliyorsunuz."

# game/storybeat.rpy:1313
translate turkish story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "Sadece senin için burada olduğumu biliyorum, tamam mı?"

# game/storybeat.rpy:1314
translate turkish story_beat4_425b462e:

    # robin "Right..."
    robin "Sağ..."

# game/storybeat.rpy:1315
translate turkish story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "Bir şey sizi korkuttuğunda genellikle ne yaparsınız?"

# game/storybeat.rpy:1316
translate turkish story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "Sanırım sadece kendimi rahatsız etmeye çalışıyorum."

# game/storybeat.rpy:1317
translate turkish story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "Biraz TV izleyin veya video oyunu veya başka bir şey oynayın."

# game/storybeat.rpy:1318
translate turkish story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "Bunlar şu anda gerçekten yapamayacağım şeyler ..."

# game/storybeat.rpy:1320
translate turkish story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "Bunun yerine sadece konuşmak ister misin? Belki bu biraz sakinleşmeme yardımcı olur."

# game/storybeat.rpy:1322
translate turkish story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "Tabii, ne hakkında konuşmak istiyorsun?"

# game/storybeat.rpy:1323
translate turkish story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "Sanırım her şey hakkında konuşabiliriz."

# game/storybeat.rpy:1324
translate turkish story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "Peki ya ... gelecek planlarımız?"

# game/storybeat.rpy:1325
translate turkish story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "Gelecek planlarımız?"

# game/storybeat.rpy:1326
translate turkish story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "Evet, bir iki yıl içinde kendimizi gördüğümüz gibi."

# game/storybeat.rpy:1327
translate turkish story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "İstersen önce gidebilirim."

# game/storybeat.rpy:1328
translate turkish story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "Tamam aşkım..."

# game/storybeat.rpy:1329
translate turkish story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "Bildiğiniz gibi, ben indie oyun geliştiricisiyim."

# game/storybeat.rpy:1330
translate turkish story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "Projemin ilk versiyonunun bu yıl sonuna kadar yayınlanmasını umuyorum."

# game/storybeat.rpy:1331
translate turkish story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "Her şey yolunda giderse, umarım oyunlarımı yapmama yardım etmek için bir takım kiralayabileceğim bir stüdyo kiralayabilirim!"

# game/storybeat.rpy:1333
translate turkish story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "Vay canına, bu gerçekten hırslı!"

# game/storybeat.rpy:1334
translate turkish story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "Evet, ama bu oyun üzerinde uzun zamandır çalışıyorum, bu yüzden meyve verildiğini görmek heyecan verici."

# game/storybeat.rpy:1335
translate turkish story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "Bu çok havalı, senin için heyecanlıyım."

# game/storybeat.rpy:1336
translate turkish story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "Teşekkürler. Evet, bunu yapmayı planladığım şey bu."

# game/storybeat.rpy:1339
translate turkish story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "Pekala, sıram."

# game/storybeat.rpy:1340
translate turkish story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "Bunu nasıl söyleyeceğimi tam olarak emin değilim ama ..."

# game/storybeat.rpy:1341
translate turkish story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "Sorun değil, zaman ayır."

# game/storybeat.rpy:1342
translate turkish story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."

# game/storybeat.rpy:1343
translate turkish story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "Birini bulmak istiyorum ..."

# game/storybeat.rpy:1344
translate turkish story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "Beni benim için sevecek biri."

# game/storybeat.rpy:1345
translate turkish story_beat4_a67d8108:

    # pro "Robin..."
    pro "Robin ..."

# game/storybeat.rpy:1346
translate turkish story_beat4_160fe2a1:

    # robin "Maybe that's a little too far ahead for me to be thinking about, but..."
    robin "Belki bu benim düşünmem için biraz fazla ileride, ama ..."

# game/storybeat.rpy:1347
translate turkish story_beat4_a1839a3e:

