    pro "Natürlich bin ich froh, dass wir den Tag zusammen verbringen durften."

# game/storybeat.rpy:1161
translate german story_beat3_1c7aa342:

    # robin "Me too, goodnight."
    robin "Ich auch, gute Nacht."

# game/storybeat.rpy:1162
