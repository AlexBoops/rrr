    # robin "I froze and he..."
    robin "Ich erstarrte und er..."

# game/storybeat.rpy:1091
translate german story_beat3_3125e9b2:

    # robin "He almost..."
    robin "Er fast..."

# game/storybeat.rpy:1092
translate german story_beat3_17e44e10:

    # pro "Jesus fucking Christ."
    pro "Jesus, verdammter Christus."

# game/storybeat.rpy:1093
translate german story_beat3_cce5a599:

    # pro "Did you call the cops?"
    pro "Hast du die Polizei gerufen?"

# game/storybeat.rpy:1094
translate german story_beat3_13f66967:

    # robin "No, I couldn't."
    robin "Nein, das konnte ich nicht."

# game/storybeat.rpy:1095
translate german story_beat3_99d7f078:

    # robin "He threatened to tell everyone where I lived and..."
    robin "Er drohte, allen zu sagen, wo ich wohne und..."

# game/storybeat.rpy:1096
translate german story_beat3_cd6e7200:

    # robin "I didn't want to risk it."
    robin "Ich wollte es nicht riskieren."

# game/storybeat.rpy:1099
translate german story_beat3_08898ad9:

    # pro "Oh my god, Robin..."
    pro "Oh mein Gott, Robin..."

# game/storybeat.rpy:1100
translate german story_beat3_0eb0f0f7:

    # pro "That's horrible, I'm so sorry."
    pro "Das ist schrecklich, es tut mir so leid."

# game/storybeat.rpy:1103
translate german story_beat3_f81922f9:

    # robin "It's okay, I just..."
    robin "Es ist okay, ich..."

# game/storybeat.rpy:1104
translate german story_beat3_4342c269:

    # robin "I had to get out of there."
    robin "Ich musste da raus."

# game/storybeat.rpy:1105
translate german story_beat3_af3a8aec:

    # robin "That's why I came here."
    robin "Deshalb bin ich hierher gekommen."

# game/storybeat.rpy:1108
translate german story_beat3_9f244daa:

    # robin "I figured it would be a smaller town, and nobody would bother me."
    robin "Ich dachte, es wäre eine kleinere Stadt und niemand würde mich stören."

# game/storybeat.rpy:1109
translate german story_beat3_010bc1b8:

    # pro "I'm so sorry you had to go through that, Robin."
    pro "Es tut mir so leid, dass du das durchmachen musstest, Robin."

# game/storybeat.rpy:1110
translate german story_beat3_6ae03e37:

    # pro "No one should ever have to go through that."
    pro "Niemand sollte das jemals durchmachen müssen."

# game/storybeat.rpy:1111
translate german story_beat3_1c5043fa:

    # robin "It's fine, really."
    robin "Es ist wirklich in Ordnung."

# game/storybeat.rpy:1112
translate german story_beat3_8d0fa7f5:

    # robin "It's kind of nice getting it off my chest..."
    robin "Es ist irgendwie schön, dass ich es loswerden kann ..."

# game/storybeat.rpy:1113
translate german story_beat3_17c9c130:

    # robin "I just hate being..."
    robin "Ich hasse es einfach,..."

# game/storybeat.rpy:1114
translate german story_beat3_f1fe2452:

    # robin "So weak."
    robin "So schwach."

# game/storybeat.rpy:1118
translate german story_beat3_cbb7b812:

    # robin "I don't know..."
    robin "Ich weiß nicht..."

# game/storybeat.rpy:1119
translate german story_beat3_fd49e948:

    # robin "I'm just worried that the stalker will eventually find me again..."
    robin "Ich mache mir nur Sorgen, dass der Stalker mich irgendwann wieder findet ..."

