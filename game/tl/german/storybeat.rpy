    pro "Wow, das hört sich schrecklich an."

# game/storybeat.rpy:1070
translate german story_beat3_c14acb61:

    # robin "Yea... it was."
    robin "Ja... das war es."

# game/storybeat.rpy:1071
translate german story_beat3_9083d04c:

