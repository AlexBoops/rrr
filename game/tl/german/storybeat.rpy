    # robin "Well, at least it gives us a chance to hang out together."
    robin "Zumindest gibt es uns die Möglichkeit, zusammen abzuhängen."

# game/storybeat.rpy:1207
translate german story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "Stört es dich, wenn ich dann neben dir sitze?"

# game/storybeat.rpy:1208
translate german story_beat4_b4dcea1a:

    # robin "Not at all, go ahead."
    robin "Überhaupt nicht, machen Sie weiter."

# game/storybeat.rpy:1210
translate german story_beat4_8f6120d3:

    # "I plop down on the couch next to Robin and get comfortable."
    "Ich lasse mich neben Robin auf die Couch fallen und mache es mir bequem."

# game/storybeat.rpy:1212
translate german story_beat4_9d413682:

    # robin "So, do you think the power is going to go out?"
    robin "Glauben Sie also, dass der Strom ausfallen wird?"

# game/storybeat.rpy:1214
translate german story_beat4_94a704f7:

    # pro "Considering the way this storm is going, it's likely."
    pro "Wenn man bedenkt, wie sich dieser Sturm entwickelt, ist das wahrscheinlich."

# game/storybeat.rpy:1216
translate german story_beat4_7d0ca308:

    # robin "Hopefully not for long, though..."
    robin "Aber hoffentlich nicht mehr lange..."

# game/storybeat.rpy:1217
translate german story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "Haben Sie Kerzen oder Taschenlampen?"

# game/storybeat.rpy:1219
translate german story_beat4_7590b815:

    # pro "Nope..."
    pro "Nein..."

# game/storybeat.rpy:1220
translate german story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "Aber die Wohnung verfügt über ein oder zwei Notlichter, die an einen Generator angeschlossen sind."

# game/storybeat.rpy:1221
translate german story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "Selbst wenn der Strom ausfällt, sollten wir etwas Licht haben, bis der Strom wieder angeht."

# game/storybeat.rpy:1223
translate german story_beat4_9546838f:

    # robin "That's good..."
    robin "Das ist gut..."

# game/storybeat.rpy:1224
translate german story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "Weißt du, ich habe in letzter Zeit über etwas nachgedacht."

# game/storybeat.rpy:1226
translate german story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "Oh? Was ist das?"

# game/storybeat.rpy:1228
translate german story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "Na ja, ähm... vielleicht ist jetzt ein guter Zeitpunkt, Sie das zu fragen, da wir ja bereits miteinander reden."

# game/storybeat.rpy:1230
translate german story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "Äh huh, was meinst du denn genau?"

# game/storybeat.rpy:1232
translate german story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "Denken Sie daran, wie ich Ihnen von dem Stalker in meiner alten Wohnung erzählt habe ..."

# game/storybeat.rpy:1233
translate german story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "Weißt du, beim Strandausflug."

# game/storybeat.rpy:1235
translate german story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "Natürlich erinnere ich mich. Hast du ihn hier gesehen oder so?"

# game/storybeat.rpy:1237
translate german story_beat4_fcb99189:

    # robin "No, but..."
    robin "Nein, aber..."

# game/storybeat.rpy:1238
translate german story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "Neulich Nacht hörte ich, wie jemand an unserer Wohnungstür klopfte."

# game/storybeat.rpy:1240
translate german story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "Was zum Teufel?"

# game/storybeat.rpy:1241
translate german story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "Hast du sie dir angesehen?"

# game/storybeat.rpy:1243
translate german story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "Nein, aber ich war wirklich ausgeflippt."

# game/storybeat.rpy:1244
translate german story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "Was ist, wenn es derselbe Typ ist?"

# game/storybeat.rpy:1245
translate german story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "Was wäre, wenn er mich finden könnte und einfach-"

# game/storybeat.rpy:1247
translate german story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "Hey, es ist okay."

# game/storybeat.rpy:1248
translate german story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "Selbst wenn er es ist, werde ich hier sein, um dich zu beschützen."

# game/storybeat.rpy:1253
translate german story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "Was aber, wenn er andere mitbringt?"

# game/storybeat.rpy:1258
translate german story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "Oder versucht er, sich in unsere Wohnung zu drängen?"

# game/storybeat.rpy:1263
translate german story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "Hey, mach mal langsam, Robin..."

# game/storybeat.rpy:1264
translate german story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "Ich verspreche, dass das nicht passieren wird."

# game/storybeat.rpy:1265
translate german story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "Sie wissen nicht, dass du hier lebst ..."

# game/storybeat.rpy:1266
translate german story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "Und ich bin auch hier, ich werde dich beschützen."

# game/storybeat.rpy:1268
translate german story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "Er sieht mich an und lächelt."

# game/storybeat.rpy:1269
translate german story_beat4_531cbf7d:

    # robin "Okay..."
    robin "Okay..."

# game/storybeat.rpy:1273
translate german story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "Plötzlich wird es im Raum stockfinster."

# game/storybeat.rpy:1276
translate german story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "Ich spüre, wie Robin meine Brust packt und auf mich fällt."

# game/storybeat.rpy:1277
translate german story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "Oh mein Gott, der Strom ist ausgefallen!"

# game/storybeat.rpy:1279
translate german story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "Er zittert. Ich spüre, wie sein Herz gegen meine Brust hämmert."

# game/storybeat.rpy:1280
translate german story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "Es ist okay, Robin. Ich bin genau hier."

# game/storybeat.rpy:1284
translate german story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "Nach ein paar Augenblicken schaltet sich der Notstromgenerator ein und ein schwaches Licht über der Couch geht an."

# game/storybeat.rpy:1285
translate german story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "R-Robin..."

# game/storybeat.rpy:1286
translate german story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "Er hält immer noch mein Hemd fest, sein Atem ist schwer und panisch."

# game/storybeat.rpy:1287
translate german story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "Tut mir leid, ich habe nur..."

# game/storybeat.rpy:1288
translate german story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "Ich mag es nicht, im Dunkeln zu tappen."

# game/storybeat.rpy:1289
translate german story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "Hey, es ist okay. Du bist in Sicherheit, okay?"

# game/storybeat.rpy:1290
translate german story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "Ich werde nicht zulassen, dass dir etwas Schlimmes passiert, das verspreche ich."

# game/storybeat.rpy:1291
translate german story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "Ich spüre, wie sich sein Körper langsam entspannt, während er sich an das schwache Licht gewöhnt."

# game/storybeat.rpy:1292
translate german story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "Es ist in Ordnung, wir müssen nur warten, bis der Strom wieder da ist."

# game/storybeat.rpy:1293
translate german story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "Tut mir leid, dass ich so auf dich gefallen bin ..."

# game/storybeat.rpy:1294
translate german story_beat4_af94f9cb:

    # pro "No worries..."
    pro "Keine Sorge..."

# game/storybeat.rpy:1297
translate german story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "Er löst sich langsam von mir und setzt sich wieder auf."

# game/storybeat.rpy:1301
translate german story_beat4_294c5cbd:

    # "Robin looks so scared."
    "Robin sieht so verängstigt aus."

# game/storybeat.rpy:1302
translate german story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "Sein Gesicht ist blass und er zittert ein wenig."

# game/storybeat.rpy:1303
translate german story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "Hey, es ist okay."

# game/storybeat.rpy:1304
translate german story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "Ich bin mir sicher, dass der Strom bald wieder verfügbar sein wird."

# game/storybeat.rpy:1305
translate german story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "Und denken Sie daran, ich bin hier bei Ihnen."

# game/storybeat.rpy:1306
translate german story_beat4_052f66f1:

    # robin "It's just..."
    robin "Es ist einfach..."

# game/storybeat.rpy:1307
translate german story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "Das Klopfen an der Tür neulich Nacht … es fühlte sich an, als wäre ich wieder ganz allein mit diesem Stalker."

# game/storybeat.rpy:1309
translate german story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "Es klingt dumm, aber so fühle ich mich..."

# game/storybeat.rpy:1311
translate german story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "Das ist nicht dumm, Robin. Sie haben jedes Recht, Angst zu haben."

# game/storybeat.rpy:1312
translate german story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "Diese Erfahrung war wirklich traumatisch und Sie verarbeiten sie immer noch."

# game/storybeat.rpy:1313
translate german story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "Du musst nur wissen, dass ich für dich da bin, okay?"

# game/storybeat.rpy:1314
translate german story_beat4_425b462e:

    # robin "Right..."
    robin "Rechts..."

# game/storybeat.rpy:1315
translate german story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "Was machst du normalerweise, wenn dir etwas Angst macht?"

# game/storybeat.rpy:1316
translate german story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "Nun ja, ich schätze, ich versuche nur, mich abzulenken."

# game/storybeat.rpy:1317
translate german story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "Schauen Sie fern oder spielen Sie ein Videospiel oder so etwas."

# game/storybeat.rpy:1318
translate german story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "Das sind Dinge, die ich im Moment allerdings nicht wirklich tun kann ..."

# game/storybeat.rpy:1320
translate german story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "Möchten Sie stattdessen einfach nur reden? Vielleicht hilft mir das ein wenig, mich zu beruhigen."

# game/storybeat.rpy:1322
translate german story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "Klar, worüber möchtest du reden?"

# game/storybeat.rpy:1323
translate german story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "Nun ja, wir könnten über alles reden, denke ich."

# game/storybeat.rpy:1324
translate german story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "Wie wäre es mit... unseren Zukunftsplänen?"

# game/storybeat.rpy:1325
translate german story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "Unsere Zukunftspläne?"

# game/storybeat.rpy:1326
translate german story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "Ja, so wie wir uns in ein oder zwei Jahren sehen."

# game/storybeat.rpy:1327
translate german story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "Ich kann zuerst gehen, wenn du willst."

# game/storybeat.rpy:1328
translate german story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "Okay..."

# game/storybeat.rpy:1329
translate german story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "Wie Sie wissen, bin ich ein Indie-Spieleentwickler."

# game/storybeat.rpy:1330
translate german story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "Ich hoffe, dass die erste Version meines Projekts bis Ende dieses Jahres veröffentlicht wird."

# game/storybeat.rpy:1331
translate german story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "Wenn alles gut geht, kann ich es mir hoffentlich leisten, ein Studio zu mieten, in dem ich ein Team einstellen kann, das mir bei der Entwicklung meiner Spiele hilft!"

# game/storybeat.rpy:1333
translate german story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "Wow, das ist wirklich ehrgeizig!"

# game/storybeat.rpy:1334
translate german story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "Ja, aber ich arbeite schon lange an diesem Spiel, daher ist es spannend zu sehen, wie es verwirklicht wird."

# game/storybeat.rpy:1335
translate german story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "Das ist so cool, ich freue mich für dich."

# game/storybeat.rpy:1336
translate german story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "Danke. Also ja, das habe ich vor."

# game/storybeat.rpy:1339
translate german story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "Okay, ich bin dran."

# game/storybeat.rpy:1340
translate german story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "Nun, ich bin mir nicht ganz sicher, wie ich das sagen soll, aber..."

# game/storybeat.rpy:1341
translate german story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "Es ist okay, nehmen Sie sich Zeit."

# game/storybeat.rpy:1342
translate german story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "Ich denke, Robin {color=#918fff}vertraut{/color} mir genug, um sich mir anzuvertrauen."

# game/storybeat.rpy:1343
translate german story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "Ich möchte jemanden finden..."

# game/storybeat.rpy:1344
translate german story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "Jemand, der mich für mich lieben wird."

# game/storybeat.rpy:1345
translate german story_beat4_a67d8108:

    # pro "Robin..."
    pro "Robin..."

# game/storybeat.rpy:1346
translate german story_beat4_160fe2a1:

    # robin "Maybe that's a little too far ahead for me to be thinking about, but..."
    robin "Vielleicht liegt das etwas zu weit in der Zukunft, als dass ich darüber nachdenken könnte, aber..."

# game/storybeat.rpy:1347
translate german story_beat4_a1839a3e:

    # robin "It's always been a dream of mine to find someone, find a partner."
    robin "Es war schon immer ein Traum von mir, jemanden zu finden, einen Partner."

# game/storybeat.rpy:1348
translate german story_beat4_f205592d:

    # robin "Someone who really loves me and isn't just using me..."
    robin "Jemand, der mich wirklich liebt und mich nicht nur ausnutzt ..."

# game/storybeat.rpy:1349
translate german story_beat4_a30fb4c2:

    # robin "Since I'm a streamer, I rarely leave the house..."
    robin "Da ich Streamer bin, verlasse ich selten das Haus..."

# game/storybeat.rpy:1350
translate german story_beat4_dbc99b84:

    # robin "It's hard to meet people."
    robin "Es ist schwer, Leute zu treffen."

# game/storybeat.rpy:1351
translate german story_beat4_91ce40d6:

    # robin "Being sexualized all the time online also hasn't been good for my self-worth issues..."
    robin "Die ständige Sexualisierung im Internet war auch nicht gut für mein Selbstwertgefühl ..."

# game/storybeat.rpy:1354
translate german story_beat4_a972e603:

    # robin "It comes with the job, I guess."
    robin "Das gehört wohl zum Job."

# game/storybeat.rpy:1355
translate german story_beat4_6ffbb649:

    # robin "But it's still hard to deal with."
    robin "Aber es ist immer noch schwer damit umzugehen."

# game/storybeat.rpy:1356
translate german story_beat4_4c3c3006:

    # pro "People online are horny idiots, don't let them get to you."
    pro "Die Leute im Internet sind geile Idioten, lass dich nicht von ihnen unterkriegen."

# game/storybeat.rpy:1357
translate german story_beat4_e5bde556:

    # robin "I try not to, but it's hard."
    robin "Ich versuche es nicht, aber es ist schwer."

# game/storybeat.rpy:1358
translate german story_beat4_2097a78b:

    # robin "I just want to find someone who sees me for me."
    robin "Ich möchte einfach jemanden finden, der mich für mich sieht."

# game/storybeat.rpy:1361
translate german story_beat4_3e312a5b:

    # robin "I don't know... they just make me feel like I'm not worth anything."
    robin "Ich weiß nicht... sie geben mir einfach das Gefühl, nichts wert zu sein."

# game/storybeat.rpy:1362
translate german story_beat4_2d902c07:

    # robin "Like I'm just a piece of meat to them."
    robin "Als ob ich für sie nur ein Stück Fleisch wäre."

# game/storybeat.rpy:1363
translate german story_beat4_606646c1:

    # pro "Wow, that's really fucked up."
    pro "Wow, das ist wirklich beschissen."

# game/storybeat.rpy:1364
translate german story_beat4_fbe6a5e9:

    # robin "Yeah..."
    robin "Ja..."

# game/storybeat.rpy:1366
translate german story_beat4_00875e63:

    # robin "A career on the internet has always been my dream, but now that it's become a reality..."
    robin "Eine Karriere im Internet war schon immer mein Traum, aber jetzt ist er Wirklichkeit geworden ..."

# game/storybeat.rpy:1367
translate german story_beat4_e54b5eed:

    # robin "I guess I'm just kind of lost."
    robin "Ich schätze, ich bin einfach irgendwie verloren."

# game/storybeat.rpy:1368
translate german story_beat4_d1b429f7:

    # robin "I don't know what I want to do anymore."
    robin "Ich weiß nicht mehr, was ich tun möchte."

# game/storybeat.rpy:1369
translate german story_beat4_11c213ee:

    # pro "Hey, if you ever want to talk about anything like this..."
    pro "Hey, wenn du jemals über so etwas reden willst ..."

# game/storybeat.rpy:1370
translate german story_beat4_1e05d98d:

    # pro "I'm always here for you, okay?"
    pro "Ich bin immer für dich da, okay?"

# game/storybeat.rpy:1371
translate german story_beat4_e1baa4f9:

    # robin "Th-thanks. It means a lot to me."
    robin "D-danke. Es bedeutet mir sehr viel."

# game/storybeat.rpy:1372
translate german story_beat4_918aae24:

    # pro "You don't need to have your entire future figured out you know..."
    pro "Sie müssen nicht Ihre gesamte Zukunft im Voraus planen, wissen Sie ..."

# game/storybeat.rpy:1373
translate german story_beat4_a507a988:

    # pro "Sometimes things just happen unexpectedly."
    pro "Manchmal passieren Dinge einfach unerwartet."

# game/storybeat.rpy:1374
translate german story_beat4_e92b6384:

    # pro "Like us, we were complete strangers when you first moved in."
    pro "Als Sie eingezogen sind, waren wir wie wir völlig fremd."

# game/storybeat.rpy:1375
translate german story_beat4_7464c56d:

    # pro "Now, you're one of the closest friends I have."
    pro "Nun, du bist einer der engsten Freunde, die ich habe."

# game/storybeat.rpy:1376
translate german story_beat4_68d7b9aa:

    # robin "Yeah, that's true."
    robin "Ja, das stimmt."

# game/storybeat.rpy:1378
translate german story_beat4_970ac64e:

    # robin "I'm glad we became friends."
    robin "Ich bin froh, dass wir Freunde geworden sind."

# game/storybeat.rpy:1379
translate german story_beat4_4a8af8d0:

    # robin "You make me feel so... comfortable."
    robin "Bei dir fühle ich mich so... wohl."

# game/storybeat.rpy:1380
translate german story_beat4_e7c88bc3:

    # robin "I don't know how you do it."
    robin "Ich weiß nicht, wie du das machst."

# game/storybeat.rpy:1381
translate german story_beat4_e82f048d:

    # pro "It's a gift."
    pro "Es ist ein Geschenk."

# game/storybeat.rpy:1382
translate german story_beat4_fad03f8a:

    # "We laugh together, and for a moment the fear of the dark subsides."
    "Wir lachen zusammen und für einen Moment lässt die Angst vor der Dunkelheit nach."

# game/storybeat.rpy:1385
translate german story_beat4_776782d0:

    # robin "Can I... ask you for something?"
    robin "Kann ich... dich um etwas bitten?"

# game/storybeat.rpy:1386
translate german story_beat4_087f9b10:

    # pro "Of course, what is it?"
    pro "Natürlich, was ist das?"

