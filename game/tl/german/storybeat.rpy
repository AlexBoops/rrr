    robin "Äh, sicher."

# game/storybeat.rpy:1057
translate german story_beat3_59d0db9d:

    # pro "What was the real reason you left your old place and moved way out here?"
    pro "Was war der wahre Grund, warum Sie Ihren alten Wohnort verlassen haben und hierher gezogen sind?"

# game/storybeat.rpy:1058
translate german story_beat3_fa7ea6e8:

    # robin "Oh..."
    robin "Oh..."

# game/storybeat.rpy:1059
