    robin "Das war ein guter Tag, nicht wahr?"

# game/storybeat.rpy:1146
translate german story_beat3_677d0104:

    # pro "Definitely, one of the best days we've had."
    pro "Auf jeden Fall einer der besten Tage, die wir je hatten."

# game/storybeat.rpy:1147
translate german story_beat3_a5ac5a61:

