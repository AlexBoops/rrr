    # "I watch him walk into the bathroom and hear the shower turn on."
    "Ich sehe zu, wie er ins Badezimmer geht und höre, wie die Dusche eingeschaltet wird."

# game/storybeat.rpy:1166
translate german story_beat3_419d1b09:

    # "I enter my room and pass out immediately after I lay down on my bed."
    "Ich betrete mein Zimmer und werde sofort ohnmächtig, nachdem ich mich auf mein Bett gelegt habe."

# game/storybeat.rpy:1167
translate german story_beat3_d2b847d3:

    # "Today was fun but exhausting."
    "Der heutige Tag war lustig, aber anstrengend."

# game/storybeat.rpy:1172
translate german story_beat3_17b738de:

    # system "{color=#FF5454}Progression Level{/color} has increased"
    system "{color=#FF5454}Fortschrittsstufe{/color} wurde erhöht"

# game/storybeat.rpy:1190
