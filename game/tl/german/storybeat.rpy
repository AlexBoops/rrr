    robin "Ich lebte alleine in einer Wohnung und fand es seltsam."

# game/storybeat.rpy:1081
translate german story_beat3_b3fd2eca:

    # robin "But I opened it anyways, and..."
    robin "Aber ich habe es trotzdem geöffnet und..."

# game/storybeat.rpy:1085
translate german story_beat3_ee849a7b:

    # robin "He was there..."
    robin "Er war da..."

# game/storybeat.rpy:1086
translate german story_beat3_283dedc6:

    # robin "Somehow, one of the creeps online found out where I lived..."
    robin "Irgendwie hat einer dieser Idioten im Internet herausgefunden, wo ich wohne ..."

# game/storybeat.rpy:1087
translate german story_beat3_7278c67b:

    # pro "What the fuck..."
    pro "Was zum Teufel..."

# game/storybeat.rpy:1088
translate german story_beat3_84089f4b:

    # robin "I... I was so scared."
    robin "Ich... ich hatte solche Angst."

# game/storybeat.rpy:1089
