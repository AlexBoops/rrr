    robin "Und wenn er es tut, werde ich nicht entkommen können."

# game/storybeat.rpy:1123
translate german story_beat3_27f13eb3:

    # pro "Robin, I'll protect you."
    pro "Robin, ich werde dich beschützen."

# game/storybeat.rpy:1124
translate german story_beat3_cfe2a155:

    # pro "If the stalker or anyone else comes after you, I'll be there."
    pro "Wenn der Stalker oder sonst jemand hinter Ihnen her ist, bin ich da."

# game/storybeat.rpy:1125
translate german story_beat3_dc6a7198:

    # robin "I..."
    robin "ICH..."

# game/storybeat.rpy:1127
