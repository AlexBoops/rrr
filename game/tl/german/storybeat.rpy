    # robin "Um..."
    robin "Äh..."

# game/storybeat.rpy:1137
translate german story_beat3_8e078ddb:

    # robin "I'm kind of tired, so if you want to go back that's fine."
    robin "Ich bin irgendwie müde, also ist das in Ordnung, wenn du zurück willst."

# game/storybeat.rpy:1138
translate german story_beat3_2b31c75a:

    # pro "Oh, right."
    pro "Oh, richtig."

# game/storybeat.rpy:1139
translate german story_beat3_93d5acac:

    # pro "Yeah, we should definitely go back."
    pro "Ja, wir sollten auf jeden Fall wiederkommen."

# game/storybeat.rpy:1140
