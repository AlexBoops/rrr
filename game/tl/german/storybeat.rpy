    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "Hey, dieser Sturm fängt wirklich an, sich zu verstärken, hm..."

# game/storybeat.rpy:1200
translate german story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "Ja, es ist definitiv ziemlich schlimm da draußen."

# game/storybeat.rpy:1201
translate german story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "Wie geht es dir?"

# game/storybeat.rpy:1202
translate german story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "Mir geht es gut, ich wollte nur nicht in meinem Zimmer eingesperrt werden, für den Fall, dass der Strom ausfällt ..."

# game/storybeat.rpy:1203
translate german story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "Ah, ich hatte die gleiche Idee."

# game/storybeat.rpy:1204
