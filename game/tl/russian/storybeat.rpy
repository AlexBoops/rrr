    # robin "I need to go somewhere else where nobody knows where I am. I can't stay here."
    robin "Мне нужно пойти куда-нибудь еще, где никто не знает, где я нахожусь. Я не могу здесь оставаться."

# game/storybeat.rpy:2371
translate russian story_beat6_3770b669:

    # robin "What if he breaks in?"
    robin "Что, если он вломится?"

