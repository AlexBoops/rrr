    # robin "Yes, but I'm worried you'll do something stupid or reckless or—"
    robin "Да, но я боюсь, что ты сделаешь что-нибудь глупое или безрассудное, или..."

# game/storybeat.rpy:2480
translate russian ending1_06295e90:

    # pro "Robin."
    pro "Робин."

# game/storybeat.rpy:2481
translate russian ending1_7c8ad6f4:

    # pro "We're partners. You and me. Partners. And we're stronger together than apart."
    pro "Мы партнеры. Ты и я. Партнеры. И вместе мы сильнее, чем по отдельности."

# game/storybeat.rpy:2482
translate russian ending1_7bd462e9_1:

    # robin "..."
    robin "..."

