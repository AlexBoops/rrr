    # pro "Do you trust me? Can you trust me with this?"
    pro "Ты мне доверяешь? Можете ли вы доверить мне это?"

# game/storybeat.rpy:2383
translate russian story_beat6_57cad898:

    # robin "I trust you, but I'm not sure I trust myself..."
    robin "Я доверяю тебе, но не уверен, что доверяю себе..."

