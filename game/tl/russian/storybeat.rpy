    # pro "You can't let fear dictate what you do, that's what will get you hurt."
    pro "Вы не можете позволить страху диктовать вам, что делать, это причинит вам боль."

# game/storybeat.rpy:2378
translate russian story_beat6_c10f49fe:

    # robin "But..."
    robin "Но..."

# game/storybeat.rpy:2379
translate russian story_beat6_f2814e5d:

    # robin "I don't want to be hurt. I'm scared. I'm so scared..."
    robin "Я не хочу, чтобы мне причинили боль. Я боюсь. Я так боюсь..."

# game/storybeat.rpy:2380
translate russian story_beat6_91b09236:

    # pro "Do you trust me, Robin?"
    pro "Ты доверяешь мне, Робин?"

# game/storybeat.rpy:2381
translate russian story_beat6_8dc8bc96:

    # robin "W-what?"
    robin "Ч-что?"

