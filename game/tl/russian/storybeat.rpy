    # "What should I do?"
    "Что я должен делать?"

# game/storybeat.rpy:2459
translate russian ending1_6f18e46b:

    # pro "Robin, listen to me."
    pro "Робин, послушай меня."

# game/storybeat.rpy:2460
translate russian ending1_56251f37:

    # pro "I'll confront him, if he even steps a foot near you I'll kick his fucking ass."
    pro "Я буду противостоять ему, если он хотя бы шагнет рядом с тобой, я надеру ему задницу."

