    # robin "But I don't want you to get hurt... or worse..."
    robin "Но я не хочу, чтобы ты пострадал... или того хуже..."

# game/storybeat.rpy:2387
translate russian story_beat6_89568f5e:

    # robin "I'm scared."
    robin "Я боюсь."

# game/storybeat.rpy:2388
