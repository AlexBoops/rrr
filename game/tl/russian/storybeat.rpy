    # pro "It will always be looming over your head. And it will always have its hooks in you, tugging at you, tormenting you."
    pro "Оно всегда будет висеть над вашей головой. И оно всегда будет держать в тебе свои крючки, тянуть тебя, мучить."

# game/storybeat.rpy:2470
translate russian ending1_cd0fa110:

    # robin "But... I'm so afraid. I can barely even imagine facing him alone."
    robin "Но... я так боюсь. Я с трудом могу себе представить, что столкнусь с ним в одиночку."

# game/storybeat.rpy:2471
translate russian ending1_a38acf0f:

    # pro "You're not alone."
    pro "Вы не одиноки."

# game/storybeat.rpy:2472
translate russian ending1_507739f8:

    # pro "I'm here, always."
    pro "Я здесь, всегда."

# game/storybeat.rpy:2473
translate russian ending1_d55454f1:

    # pro "I'm here to support you."
    pro "Я здесь, чтобы поддержать тебя."

# game/storybeat.rpy:2474
translate russian ending1_0cc141e3:

    # pro "I'm here to take care of you."
    pro "Я здесь, чтобы позаботиться о тебе."

# game/storybeat.rpy:2475
translate russian ending1_7bd462e9:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2476
translate russian ending1_5a1b7040:

    # pro "We need to act fast, Robin."
    pro "Нам нужно действовать быстро, Робин."

