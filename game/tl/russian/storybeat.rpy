    # robin "I don't know... I just don't know. What if I regret it?"
    robin "Я не знаю... Я просто не знаю. Что, если я пожалею об этом?"

# game/storybeat.rpy:2478
translate russian ending1_9a052b3a:

    # pro "Do you trust me?"
    pro "Ты мне доверяешь?"

# game/storybeat.rpy:2479
