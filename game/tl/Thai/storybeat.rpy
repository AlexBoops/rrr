# game/storybeat.rpy:3547
translate thai annviersary_event_55a7790d:

    # pro "Man, I can't wait for tomorrow..."
    pro "เพื่อน ฉันแทบจะรอพรุ่งนี้ไม่ไหวแล้ว..."

