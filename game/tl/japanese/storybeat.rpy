# game/storybeat.rpy:3450
translate japanese ending3_443a072e:

    # pro "I blacked out and when I came to, the cops were-"
    pro "私は意識を失い、気が付いた時には警官たちが――"

# game/storybeat.rpy:3451
translate japanese ending3_2418ba72:

    # robin "I'm leaving."
    robin "私は行きます。"

# game/storybeat.rpy:3453
translate japanese ending3_14e5965e:

    # robin "I'm moving out and going somewhere else."
    robin "私は引っ越して別の場所に行きます。"

# game/storybeat.rpy:3454
translate japanese ending3_cc59e536:

    # robin "I... I can't stay with you any more."
    robin "私は...もうあなたと一緒にいることはできません。"

# game/storybeat.rpy:3455
translate japanese ending3_5046e8ff:

    # robin "You broke my trust... I can't anymore."
    robin "あなたは私の信頼を裏切りました...私はもう無理です。"

# game/storybeat.rpy:3456
translate japanese ending3_5009e319:

    # robin "I'm sorry."
    robin "ごめんなさい。"

# game/storybeat.rpy:3457
translate japanese ending3_c4911750:

    # "I'm stunned. I don't know what to say."
    "びっくりしました。なんと言っていいかわかりません。"

# game/storybeat.rpy:3458
translate japanese ending3_05a42722:

    # robin "I'm going to stay at a motel tonight. Don't bother trying to contact me."
    robin "今夜はモーテルに泊まるつもりです。わざわざ私に連絡しようとしないでください。"

# game/storybeat.rpy:3459
translate japanese ending3_a5c35f8d:

    # robin "I'll be back for my stuff tomorrow..."
    robin "明日荷物を取りに戻ってきます..."

# game/storybeat.rpy:3460
translate japanese ending3_39e01fef:

    # robin "I can pay for the damages to the door you broke too."
    robin "あなたが壊したドアの損害も私が負担します。"

# game/storybeat.rpy:3461
translate japanese ending3_82353b83:

    # pro "Robin... no..."
    pro "Robin... no..."

# game/storybeat.rpy:3462
translate japanese ending3_ecd229c2:

    # pro "I was... I was just..."
    pro "私は...私はただ..."

# game/storybeat.rpy:3464
translate japanese ending3_ed23f47e:

    # "Without another word, he turns around and leaves."
    "彼は何も言わずに背を向けて立ち去った。"

# game/storybeat.rpy:3465
translate japanese ending3_d0157b79:

    # "I'm alone... again..."
    "私は一人です...また..."

# game/storybeat.rpy:3466
translate japanese ending3_f05b010b:

    # "And this time it's my fault..."
    "そして今回は私のせいです…"

# game/storybeat.rpy:3467
translate japanese ending3_5aef4a4b:

    # "I failed him..."
    "私は彼に失敗してしまいました..."

# game/storybeat.rpy:3468
translate japanese ending3_e7c39007:

    # "I told him to trust me..."
    "私は彼に私を信頼するように言いました..."

# game/storybeat.rpy:3469
translate japanese ending3_050bae79:

    # "If maybe I had stayed up with him... or even just ran away with him."
    "もしかしたら、私が彼と一緒に起きていたら... あるいは、ただ彼と一緒に逃げてさえいれば。"

# game/storybeat.rpy:3470
translate japanese ending3_d3121992:

    # "This wouldn't have happened."
    "こんなことは起こらなかったでしょう。"

# game/storybeat.rpy:3472
translate japanese ending3_faa87652:

    # "I... I don't even know what to think."
    "私は...何を考えるべきかさえわかりません。"

# game/storybeat.rpy:3473
translate japanese ending3_b39c2d35:

    # "What do I do now...?"
    "これからどうすればいいでしょうか...?"

# game/storybeat.rpy:3474
translate japanese ending3_52323f8f:

    # "Was this the end of things?"
    "これで終わりだったのか？"

# game/storybeat.rpy:3475
translate japanese ending3_60a1cb87:

    # "I guess so..."
    "私はそう思います..."

# game/storybeat.rpy:3476
translate japanese ending3_806de563:

    # "I'm... I'm horrible."
    "私は...私はひどいです。"

# game/storybeat.rpy:3481
translate japanese ending3_db2c0ffe:

    # system "Ending 3 Complete"
    system "エンディング3クリア"

