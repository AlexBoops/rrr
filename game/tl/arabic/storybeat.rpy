    # pro "Okay?"
    pro "تمام؟"

# game/storybeat.rpy:2250
translate arabic story_beat6_5b527369:

    # pro "What's okay?"
    pro "ما الأمر؟"

# game/storybeat.rpy:2252
translate arabic story_beat6_4b973700:

    # robin "Let's do it..."
    robin "دعونا نفعل ذلك..."

# game/storybeat.rpy:2253
translate arabic story_beat6_0a1bdcaf:

    # robin "I'm willing to try."
    robin "أنا على استعداد للمحاولة."

# game/storybeat.rpy:2254
translate arabic story_beat6_05d819c8:

    # robin "You're right. There's no use in worrying about it."
    robin "أنت على حق. ليس هناك فائدة من القلق بشأن ذلك."

# game/storybeat.rpy:2255
