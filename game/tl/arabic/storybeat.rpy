    pro "هذا فظيع، أنا آسف جدًا."

# game/storybeat.rpy:1103
translate arabic story_beat3_f81922f9:

    # robin "It's okay, I just..."
    robin "لا بأس، أنا فقط..."

# game/storybeat.rpy:1104
translate arabic story_beat3_4342c269:

