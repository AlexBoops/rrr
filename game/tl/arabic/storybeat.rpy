    # robin "I just have to have a little courage."
    robin "أنا فقط يجب أن أتحلى بالقليل من الشجاعة."

# game/storybeat.rpy:2256
translate arabic story_beat6_c5e6dd3b:

    # robin "If we're meant to be, we're meant to be, and if we're not then we can move on without hurting each other."
    robin "إذا كان من المفترض أن نكون كذلك، فمن المفترض أن نكون كذلك، وإذا لم يكن الأمر كذلك، فيمكننا المضي قدمًا دون إيذاء بعضنا البعض."

# game/storybeat.rpy:2257
translate arabic story_beat6_7017fd2a:

    # pro "I'm so proud of you, Robin."
    pro "أنا فخور جدًا بك يا روبن."

# game/storybeat.rpy:2258
translate arabic story_beat6_84762869:

    # pro "This is a big step for you, and I'm glad that we can do this together."
    pro "هذه خطوة كبيرة بالنسبة لك، وأنا سعيد لأننا نستطيع القيام بذلك معًا."

# game/storybeat.rpy:2259
translate arabic story_beat6_78b2f91d:

    # robin "Yeah, it's kind of scary, but I'm excited."
    robin "نعم، إنه أمر مخيف نوعًا ما، لكنني متحمس."

# game/storybeat.rpy:2260
translate arabic story_beat6_0c67d249:

    # robin "I've never been this close with someone before, it feels nice."
    robin "لم أكن قريبًا من شخص ما إلى هذا الحد من قبل، إنه شعور لطيف."

# game/storybeat.rpy:2261
translate arabic story_beat6_17a73ef9:

    # "I still feel like he's unsure..."
    "ومازلت أشعر بأنه غير متأكد.."

# game/storybeat.rpy:2262
translate arabic story_beat6_e68f4459:

    # "Maybe he doesn't know how devoted I am to him... how much I want this to work."
    "ربما لا يعرف مدى إخلاصي له... كم أريد أن ينجح هذا."

# game/storybeat.rpy:2263
translate arabic story_beat6_9fa56461:

    # "Maybe I should just..."
    "ربما ينبغي لي فقط..."

# game/storybeat.rpy:2265
translate arabic story_beat6_c282c949:

    # pro "Hey, Robin?"
    pro "مهلا، روبن؟"

# game/storybeat.rpy:2267
translate arabic story_beat6_51813b74:

    # robin "Yeah?"
    robin "نعم؟"

# game/storybeat.rpy:2268
