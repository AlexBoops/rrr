    # pro "Let me take care of you Robin."
    pro "دعني أعتني بك يا روبن."

# game/storybeat.rpy:2236
translate arabic story_beat6_091d683a:

    # pro "Let me love you and show you how wonderful it can be."
    pro "دعني أحبك وأظهر لك كم هو رائع."

# game/storybeat.rpy:2237
translate arabic story_beat6_3fd36189:

    # robin "B-but how?"
    robin "ب-ولكن كيف؟"

# game/storybeat.rpy:2239
translate arabic story_beat6_7c844f3d:

    # pro "You said you didn't want to have any more sex until we figured things out, right?"
    pro "لقد قلت أنك لا تريد ممارسة المزيد من الجنس حتى نكتشف الأمور، أليس كذلك؟"

# game/storybeat.rpy:2240
translate arabic story_beat6_a99ed122:

    # pro "That means you've already chosen your answer, haven't you?"
    pro "هذا يعني أنك اخترت إجابتك بالفعل، أليس كذلك؟"

# game/storybeat.rpy:2241
translate arabic story_beat6_9f2551cd:

    # pro "You've just chosen the harder option to avoid taking a leap of faith."
    pro "لقد اخترت للتو الخيار الأصعب لتجنب اتخاذ قفزة الإيمان."

# game/storybeat.rpy:2242
translate arabic story_beat6_9e97e6cb:

    # pro "But you need to understand that there are no right answers, only the answers that are right for us."
    pro "لكن عليك أن تفهم أنه لا توجد إجابات صحيحة، بل فقط الإجابات المناسبة لنا."

# game/storybeat.rpy:2243
translate arabic story_beat6_190031a7:

    # pro "I'm not trying to pressure you into a relationship, but I think it would be good for both of us to give it a try."
    pro "أنا لا أحاول الضغط عليك للدخول في علاقة، لكن أعتقد أنه سيكون من الجيد لكلينا أن نجربها."

# game/storybeat.rpy:2244
translate arabic story_beat6_93e9dc11:

    # pro "We can go as slow or as fast as you want, I'm not in a rush either."
    pro "يمكننا أن نسير ببطء أو بالسرعة التي تريدها، وأنا لست في عجلة من أمري أيضًا."

# game/storybeat.rpy:2245
translate arabic story_beat6_46a65d19:

    # pro "But if you want to take a risk, and you want to try for a happy ending, then I think it's worth taking a leap of faith."
    pro "لكن إذا كنت تريد المخاطرة، وتريد أن تحاول الوصول إلى نهاية سعيدة، فأعتقد أن الأمر يستحق أن تأخذ قفزة إيمانية."

# game/storybeat.rpy:2246
translate arabic story_beat6_a1ba2e62:

    # pro "I'll catch you. I'll be there for you."
    pro "سوف أمسك بك. ستجدني حين تحتاجني."

# game/storybeat.rpy:2247
translate arabic story_beat6_7bd462e9:

    # robin "..."
    robin "..."

# game/storybeat.rpy:2248
translate arabic story_beat6_531cbf7d:

    # robin "Okay..."
    robin "تمام..."

