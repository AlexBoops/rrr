    # pro "This is..."
    pro "هذا هو..."

# game/storybeat.rpy:2289
translate arabic story_beat6_ef4d91be:

    # pro "A note addressed to Robin..."
    pro "رسالة موجهة إلى روبن..."

# game/storybeat.rpy:2292
translate arabic story_beat6_989be03e:

    # "I open up the letter and begin to read it to Robin."
    "أفتح الرسالة وأبدأ في قراءتها لروبن."

# game/storybeat.rpy:2295
