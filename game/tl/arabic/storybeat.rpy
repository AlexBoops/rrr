    # robin "I... I'm not safe. I need to get out of here."
    robin "أنا...لست آمنًا. أنا بحاجة للخروج من هنا."

# game/storybeat.rpy:2369
translate arabic story_beat6_d596803f:

    # robin "I need to leave."
    robin "انا بحاجة للمغادرة."

# game/storybeat.rpy:2370
translate arabic story_beat6_6ae8dd1a:

    # robin "I need to go somewhere else where nobody knows where I am. I can't stay here."
    robin "يجب أن أذهب إلى مكان آخر حيث لا أحد يعرف أين أنا. لا أستطيع البقاء هنا."

# game/storybeat.rpy:2371
translate arabic story_beat6_3770b669:

    # robin "What if he breaks in?"
    robin "ماذا لو اقتحم؟"

# game/storybeat.rpy:2372
translate arabic story_beat6_1737112b:

    # robin "What if he tries to do something to me while I'm asleep?"
    robin "ماذا لو حاول أن يفعل شيئاً بي أثناء نومي؟"

# game/storybeat.rpy:2373
translate arabic story_beat6_94c00a1e:

    # "Fuck, he's spiraling again."
    "اللعنة، انه يتصاعد مرة أخرى."

# game/storybeat.rpy:2374
translate arabic story_beat6_b734da46:

    # robin "No, no... I have to leave now, I can't be here any longer..."
    robin "لا، لا... يجب أن أغادر الآن، لا أستطيع البقاء هنا لفترة أطول..."

# game/storybeat.rpy:2375
translate arabic story_beat6_ea0366dc:

    # pro "Robin, no... listen to me."
    pro "روبن، لا... استمع لي."

# game/storybeat.rpy:2376
translate arabic story_beat6_03464c09:

    # pro "You're panicking."
    pro "أنت مذعور."

# game/storybeat.rpy:2377
translate arabic story_beat6_e61d5a28:

    # pro "You can't let fear dictate what you do, that's what will get you hurt."
    pro "لا يمكنك أن تدع الخوف يملي عليك ما تفعله، فهذا ما سيؤذيك."

# game/storybeat.rpy:2378
translate arabic story_beat6_c10f49fe:

    # robin "But..."
    robin "لكن..."

# game/storybeat.rpy:2379
translate arabic story_beat6_f2814e5d:

    # robin "I don't want to be hurt. I'm scared. I'm so scared..."
    robin "لا أريد أن أتأذى. أنا خائف. انا خائفة جدا..."

# game/storybeat.rpy:2380
