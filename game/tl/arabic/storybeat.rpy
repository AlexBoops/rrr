translate arabic annviersary_event_ad60a32c:

    # "I had to get everything perfect. Robin deserves it."
    "كان علي أن أحصل على كل شيء بشكل مثالي. روبن يستحق ذلك."

# game/storybeat.rpy:3541
translate arabic annviersary_event_3f400f08:

    # "The past year with Robin has been nothing short of fantastic, even with all the stress and difficult situations we've experienced."
    "العام الماضي مع روبن لم يكن أقل من رائع، حتى مع كل الضغوط والمواقف الصعبة التي مررنا بها."

# game/storybeat.rpy:3542
translate arabic annviersary_event_6ed32f9d:

    # "He means the absolute world to me, and I want our relationship to grow even further."
    "إنه يعني لي العالم المطلق، وأريد أن تنمو علاقتنا أكثر."

# game/storybeat.rpy:3543
translate arabic annviersary_event_bce3ad0d:

    # pro "I'm gonna go get ready for the day, okay baby?"
    pro "سأذهب للاستعداد لهذا اليوم، حسنًا يا عزيزي؟"

# game/storybeat.rpy:3544
translate arabic annviersary_event_eca6af8f:

    # pro "I'll talk to you later."
    pro "سأتحدث معك لاحقا."

# game/storybeat.rpy:3545
translate arabic annviersary_event_d1c7dfdc:

    # robin "Okay, see you soon!"
    robin "حسنًا، أراك قريبًا!"

# game/storybeat.rpy:3546
translate arabic annviersary_event_1130ce9d:

    # "I head back to my room to get dressed."
    "أعود إلى غرفتي لأرتدي ملابسي."

# game/storybeat.rpy:3547
translate arabic annviersary_event_55a7790d:

    # pro "Man, I can't wait for tomorrow..."
    pro "يا رجل، لا أستطيع الإنتظار حتى الغد..."

translate arabic strings:

    # game/storybeat.rpy:152
    old "Is there anything in specific you're worried about?"
    new "هل هناك أي شيء محدد أنت قلق بشأنه؟"

    # game/storybeat.rpy:152
    old "Oh it's very safe here, don't worry about it."
    new "أوه، المكان آمن جدًا هنا، لا تقلق بشأن ذلك."

    # game/storybeat.rpy:152
    old "Why are you scared about safety?"
    new "لماذا أنت خائف على السلامة؟"

    # game/storybeat.rpy:407
    old "You shouldn't put yourself down like that."
    new "لا يجب أن تضع نفسك هكذا."

    # game/storybeat.rpy:407
    old "Come on, I'm sure it's great."
    new "هيا، أنا متأكد من أنه أمر رائع."

    # game/storybeat.rpy:407
    old "If it makes you happy, that's all that matters."
    new "إذا كان ذلك يجعلك سعيدًا، فهذا كل ما يهم."

    # game/storybeat.rpy:897
    old "Hey, I think you're great!"
    new "مهلا، أعتقد أنك عظيم!"

    # game/storybeat.rpy:897
    old "You're super sweet and kind."
    new "أنت لطيف للغاية ولطيف."

    # game/storybeat.rpy:897
    old "Not in a weird way but you're very, very cute."
    new "ليس بطريقة غريبة ولكنك لطيف جدًا جدًا."

    # game/storybeat.rpy:1115
    old "Hey, you aren't weak."
    new "مهلا، أنت لست ضعيفا."

    # game/storybeat.rpy:1115
    old "I'll protect you."
    new "سأحميك."

    # game/storybeat.rpy:1352
    old "You deserve so much better than that, Robin."
    new "أنت تستحق أفضل من ذلك بكثير يا روبن."

    # game/storybeat.rpy:1352
    old "What else do they say?"
    new "ماذا يقولون؟"

