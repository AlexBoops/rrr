# game/storybeat.rpy:1120
translate arabic story_beat3_c413cfa0:

    # robin "And that if he does, I won't be able to get away."
    robin "وأنه إذا فعل ذلك، فلن أتمكن من الهرب."

# game/storybeat.rpy:1123
translate arabic story_beat3_27f13eb3:

    # pro "Robin, I'll protect you."
    pro "روبن، سأحميك."

# game/storybeat.rpy:1124
translate arabic story_beat3_cfe2a155:

    # pro "If the stalker or anyone else comes after you, I'll be there."
    pro "إذا لاحقك المطارد أو أي شخص آخر، سأكون هناك."

# game/storybeat.rpy:1125
translate arabic story_beat3_dc6a7198:

    # robin "I..."
    robin "أنا..."

# game/storybeat.rpy:1127
translate arabic story_beat3_02747ec1:

