    # "I read the note some more..."
    "قرأت المذكرة أكثر.."

# game/storybeat.rpy:2307
translate arabic story_beat6_82a7764b:

    # pro "'I miss you. I can't wait to see you in person again."
    pro "'أفتقدك. لا استطيع الانتظار لرؤيتك شخصيا مرة أخرى."

# game/storybeat.rpy:2310
translate arabic story_beat6_66605e06:

    # pro "'See you soon, my love.'"
    pro "\"أراك قريبا يا حبي.\""

# game/storybeat.rpy:2311
translate arabic story_beat6_004bff31:

    # pro "..."
    pro "..."

# game/storybeat.rpy:2314
