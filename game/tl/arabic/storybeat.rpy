    # "His eyes are wide and full of terror. He is absolutely terrified."
    "عيناه واسعة ومليئة بالرعب. إنه مرعوب تمامًا."

# game/storybeat.rpy:2355
translate arabic story_beat6_f558c877:

    # pro "We can't panic."
    pro "لا يمكننا الذعر."

# game/storybeat.rpy:2356
translate arabic story_beat6_26e40d21:

    # pro "It won't help us to panic. We have to be smart and rational. We have to figure this out together."
    pro "لن يساعدنا الذعر. علينا أن نكون أذكياء وعقلانيين. علينا أن نكتشف هذا معًا."

# game/storybeat.rpy:2357
translate arabic story_beat6_439defec:

    # robin "He's out there right now."
    robin "انه هناك الآن."

# game/storybeat.rpy:2358
translate arabic story_beat6_4b2e447b:

    # robin "I'm not safe anymore. He knows I live here."
    robin "لم أعد آمنًا بعد الآن. إنه يعرف أنني أعيش هنا."

# game/storybeat.rpy:2359
translate arabic story_beat6_8cca8499:

    # robin "I... I'm..."
    robin "أنا... أنا..."

# game/storybeat.rpy:2360
translate arabic story_beat6_36b39d27:

    # robin "What do I do, I don't know what to do..."
    robin "ماذا أفعل، لا أعرف ماذا أفعل..."

# game/storybeat.rpy:2361
translate arabic story_beat6_9272fe76:

    # "He's hyperventilating and crying now, tears streaming down his face."
    "إنه يتنفس بشدة ويبكي الآن، والدموع تنهمر على وجهه."

# game/storybeat.rpy:2362
translate arabic story_beat6_db1c1c53:

    # robin "This is it..."
    robin "هذا هو..."

# game/storybeat.rpy:2363
translate arabic story_beat6_b25b158e:

    # robin "This is my nightmare come to life."
    robin "هذا هو كابوسي يأتي إلى الحياة."

# game/storybeat.rpy:2364
