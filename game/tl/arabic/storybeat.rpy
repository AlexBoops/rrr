    # "I enter the room and see Robin in the corner of his room."
    "دخلت الغرفة ورأيت روبن في زاوية غرفته."

# game/storybeat.rpy:2349
translate arabic story_beat6_a67d8108_2:

    # pro "Robin..."
    pro "روبن..."

# game/storybeat.rpy:2350
translate arabic story_beat6_5ed852ca:

    # robin "I knew it... I knew he would find me..."
    robin "كنت أعرف ذلك... كنت أعرف أنه سيجدني..."

# game/storybeat.rpy:2351
translate arabic story_beat6_2103d045:

    # robin "I knew this wouldn't last forever..."
    robin "كنت أعرف أن هذا لن يستمر إلى الأبد.."

# game/storybeat.rpy:2352
translate arabic story_beat6_f4b2dcaa:

    # robin "Shit... what do I do."
    robin "اللعنة...ماذا أفعل."

# game/storybeat.rpy:2353
translate arabic story_beat6_ba0976e9:

    # robin "What do I do, [protagonist_name]?"
    robin "ماذا أفعل [protagonist_name]؟"

# game/storybeat.rpy:2354
