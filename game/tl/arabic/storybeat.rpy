    pro "\"لكن لم يكن عليك أن تبتعد عني كثيرًا.\""

# game/storybeat.rpy:2302
translate arabic story_beat6_9cf9d9f2:

    # robin "What the fuck."
    robin "ماذا بحق الجحيم."

# game/storybeat.rpy:2303
