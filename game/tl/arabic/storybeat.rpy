    robin "اللعنة اللعنة اللعنة..."

# game/storybeat.rpy:2324
translate arabic story_beat6_71826702:

    # robin "I can't believe he found me."
    robin "لا أستطيع أن أصدق أنه وجدني."

# game/storybeat.rpy:2325
translate arabic story_beat6_8b0ab240:

    # robin "What if he breaks in..."
    robin "ماذا لو دخل..."

# game/storybeat.rpy:2326
translate arabic story_beat6_a67d8108_1:

    # pro "Robin..."
    pro "روبن..."

# game/storybeat.rpy:2327
translate arabic story_beat6_feb1e3a4:

    # pro "Robin please calm down."
    pro "روبن يرجى تهدئة."

# game/storybeat.rpy:2328
translate arabic story_beat6_39e86371:

    # pro "Listen to me..."
    pro "استمع لي..."

# game/storybeat.rpy:2329
translate arabic story_beat6_f8c31f21:

    # pro "I know it's scary, and it feels like your whole world is crashing down around you."
    pro "أعلم أن الأمر مخيف، ويبدو أن عالمك كله ينهار من حولك."

