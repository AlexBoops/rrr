# game/storybeat.rpy:1192
translate arabic story_beat4_2cb73df8:

    # pro "What if the power goes out...?"
    pro "ماذا لو انقطعت الكهرباء...؟"

# game/storybeat.rpy:1193
translate arabic story_beat4_fc3f0bec:

    # pro "Honestly I'm not even going to risk this..."
    pro "بصراحة، لن أخاطر حتى بهذا..."

# game/storybeat.rpy:1194
translate arabic story_beat4_49178709:

    # "I turn off my computer and unplug it from the outlets to prevent a sudden power surge."
    "أقوم بإيقاف تشغيل جهاز الكمبيوتر الخاص بي وفصله من المنافذ لمنع حدوث زيادة مفاجئة في الطاقة."

# game/storybeat.rpy:1195
translate arabic story_beat4_f599b714:

    # pro "I guess if I can't do work, I could try chilling in the living room..."
    pro "أعتقد أنه إذا لم أتمكن من القيام بالعمل، فيمكنني أن أحاول الاسترخاء في غرفة المعيشة..."

# game/storybeat.rpy:1197
translate arabic story_beat4_7a3e8f69:

    # "I leave my room and see Robin already sitting on the couch."
    "غادرت غرفتي ورأيت روبن جالسًا بالفعل على الأريكة."

# game/storybeat.rpy:1199
translate arabic story_beat4_24394ad0:

    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "مهلا، هذه العاصفة بدأت بالفعل في التصاعد، هاه."

# game/storybeat.rpy:1200
translate arabic story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "نعم، من المؤكد أن الوضع سيء جدًا هناك."

# game/storybeat.rpy:1201
translate arabic story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "كيف حالك الصمود؟"

# game/storybeat.rpy:1202
translate arabic story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "أنا بخير، فقط لا أريد أن أبقى محبوسًا في غرفتي في حالة انقطاع التيار الكهربائي..."

# game/storybeat.rpy:1203
translate arabic story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "اه، كان لدي نفس الفكرة."

# game/storybeat.rpy:1204
translate arabic story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "ليس الأمر وكأننا نستطيع إنجاز أي شيء على أي حال، أليس كذلك؟"

# game/storybeat.rpy:1206
translate arabic story_beat4_64a8ddb7:

    # robin "Well, at least it gives us a chance to hang out together."
    robin "حسنًا، على الأقل يمنحنا فرصة للتسكع معًا."

# game/storybeat.rpy:1207
translate arabic story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "هل تمانع لو جلست معك حينها؟"

# game/storybeat.rpy:1208
translate arabic story_beat4_b4dcea1a:

