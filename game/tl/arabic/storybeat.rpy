    # pro "Listen to me."
    pro "استمع لي."

# game/storybeat.rpy:2321
translate arabic story_beat6_f0ee89b1:

    # pro "We're going to be okay-"
    pro "سنكون بخير -"

# game/storybeat.rpy:2322
