translate chinese_traditional story_beat3_dc6a7198:

    # robin "I..."
    robin "我..."

# game/storybeat.rpy:1127
translate chinese_traditional story_beat3_02747ec1:

    # robin "That means a lot to me, thank you."
    robin "這對我來說意義重大，謝謝。"

# game/storybeat.rpy:1129
translate chinese_traditional story_beat3_315bc637:

    # system "Robin {color=#918fff}trusts{/color} you a {color=#8AFF59}little bit{/color} more now."
    system "Robin 現在更{color=#918fff}信任{/color}您{color=#8AFF59}一點{/color}了。"

# game/storybeat.rpy:1134
translate chinese_traditional story_beat3_6846f444:

    # "I want to hug him."
    "我想擁抱他。"

# game/storybeat.rpy:1135
translate chinese_traditional story_beat3_d1f38b56:

    # "I want to hold him and tell him that everything will be okay."
    "我想抱著他，告訴他一切都會好起來的。"

# game/storybeat.rpy:1136
translate chinese_traditional story_beat3_e246420e:

    # robin "Um..."
    robin "嗯..."

# game/storybeat.rpy:1137
translate chinese_traditional story_beat3_8e078ddb:

    # robin "I'm kind of tired, so if you want to go back that's fine."
    robin "我有點累了，所以如果你想回去也沒關係。"

# game/storybeat.rpy:1138
translate chinese_traditional story_beat3_2b31c75a:

    # pro "Oh, right."
    pro "哦，對了。"

# game/storybeat.rpy:1139
translate chinese_traditional story_beat3_93d5acac:

    # pro "Yeah, we should definitely go back."
    pro "是的，我們一定要回去。"

# game/storybeat.rpy:1140
translate chinese_traditional story_beat3_1c380cc3:

    # robin "Okay, let's pack up and go."
    robin "好吧，我們就收拾行李出發吧。"

# game/storybeat.rpy:1142
translate chinese_traditional story_beat3_2bffde70:

    # robin "Thanks for listening and letting me talk about this."
    robin "感謝您的聆聽並讓我談論這個問題。"

# game/storybeat.rpy:1144
translate chinese_traditional story_beat3_cbf3d343:

    # "We pack up and head back to the car."
    "我們收拾好東西，回到車上。"

# game/storybeat.rpy:1145
translate chinese_traditional story_beat3_7d12e478:

    # robin "This was a good day, wasn't it?"
    robin "這真是美好的一天，不是嗎？"

# game/storybeat.rpy:1146
translate chinese_traditional story_beat3_677d0104:

    # pro "Definitely, one of the best days we've had."
    pro "毫無疑問，這是我們度過的最美好的日子之一。"

# game/storybeat.rpy:1147
translate chinese_traditional story_beat3_a5ac5a61:

    # robin "Yeah, I'm glad I decided to come here."
    robin "是的，我很高興我決定來這裡。"

# game/storybeat.rpy:1148
translate chinese_traditional story_beat3_5082b2c1:

    # "I'm glad he came here."
    "我很高興他來到這裡。"

# game/storybeat.rpy:1149
translate chinese_traditional story_beat3_f9dff4cb:

    # "We drive back, the radio playing softly in the background."
    "我們開車回去，收音機在後台輕柔地播放著。"

# game/storybeat.rpy:1150
translate chinese_traditional story_beat3_1aeb4c2b:

    # "I'm still processing what Robin told me."
    "我仍在處理羅賓告訴我的話。"

# game/storybeat.rpy:1151
translate chinese_traditional story_beat3_eff7bc22:

    # "God, what a fucking asshole."
    "天哪，真是個混蛋。"

# game/storybeat.rpy:1152
translate chinese_traditional story_beat3_3b4179f0:

    # "I can't believe someone would do that to him."
    "我不敢相信有人會這樣對他。"

# game/storybeat.rpy:1153
translate chinese_traditional story_beat3_7052fe1a:

    # "Robin is so sweet and innocent, it makes me sick to think that people would prey on him like that."
    "羅賓是如此的可愛和天真，一想到人們會這樣攻擊他就讓我感到噁心。"

# game/storybeat.rpy:1154
translate chinese_traditional story_beat3_c870ddbb:

    # "I need to protect him."
    "我需要保護他。"

# game/storybeat.rpy:1156
translate chinese_traditional story_beat3_c33f0da3:

    # "After a short drive, we arrive home and head inside our apartment."
    "經過一小段車程後，我們到達家並走進我們的公寓。"

# game/storybeat.rpy:1158
translate chinese_traditional story_beat3_af480cf8:

    # robin "Well, I'm going to take a shower and then head to bed."
    robin "好吧，我要去洗個澡，然後上床睡覺。"

# game/storybeat.rpy:1159
translate chinese_traditional story_beat3_f241d8fd:

    # robin "Today was a lot of fun, thanks again for everything."
    robin "今天很有趣，再次感謝所做的一切。"

# game/storybeat.rpy:1160
translate chinese_traditional story_beat3_c4b65fe1:

    # pro "Of course, I'm glad we got to spend the day together."
    pro "當然，我很高興我們能一起度過這一天。"

# game/storybeat.rpy:1161
translate chinese_traditional story_beat3_1c7aa342:

    # robin "Me too, goodnight."
    robin "我也是，晚安。"

# game/storybeat.rpy:1162
translate chinese_traditional story_beat3_44d8b4ac:

    # pro "Goodnight."
    pro "晚安。"

# game/storybeat.rpy:1164
translate chinese_traditional story_beat3_5ab325d5:

    # "I watch him walk into the bathroom and hear the shower turn on."
    "我看著他走進浴室，聽到淋浴間打開的聲音。"

# game/storybeat.rpy:1166
translate chinese_traditional story_beat3_419d1b09:

    # "I enter my room and pass out immediately after I lay down on my bed."
    "我走進自己的房間，躺在床上後立刻昏倒了。"

# game/storybeat.rpy:1167
translate chinese_traditional story_beat3_d2b847d3:

    # "Today was fun but exhausting."
    "今天很有趣，但也很累。"

# game/storybeat.rpy:1172
translate chinese_traditional story_beat3_17b738de:

    # system "{color=#FF5454}Progression Level{/color} has increased"
    system "{color=#FF5454}進步等級{/color}已提高"

# game/storybeat.rpy:1190
translate chinese_traditional story_beat4_aa0d0ae2:

    # "Fuck, there's a really bad thunderstorm outside..."
    "媽的，外面真的下雷雨了…"

# game/storybeat.rpy:1191
translate chinese_traditional story_beat4_9526ab0f:

    # "I'm sitting at my desk, trying to focus on my work, but the lights keep flickering."
    "我坐在辦公桌前，試著專注於工作，但燈一直閃爍。"

# game/storybeat.rpy:1192
translate chinese_traditional story_beat4_2cb73df8:

    # pro "What if the power goes out...?"
    pro "如果停電了怎麼辦...？"

# game/storybeat.rpy:1193
translate chinese_traditional story_beat4_fc3f0bec:

    # pro "Honestly I'm not even going to risk this..."
    pro "老實說，我甚至不會冒這個風險......"

# game/storybeat.rpy:1194
translate chinese_traditional story_beat4_49178709:

    # "I turn off my computer and unplug it from the outlets to prevent a sudden power surge."
    "我關閉電腦並將其從插座上拔下，以防止突然出現電湧。"

# game/storybeat.rpy:1195
translate chinese_traditional story_beat4_f599b714:

    # pro "I guess if I can't do work, I could try chilling in the living room..."
    pro "我想如果我不能工作的話，我可以嘗試在客廳放鬆一下..."

# game/storybeat.rpy:1197
translate chinese_traditional story_beat4_7a3e8f69:

    # "I leave my room and see Robin already sitting on the couch."
    "我離開房間，看到羅賓已經坐在沙發上。"

# game/storybeat.rpy:1199
translate chinese_traditional story_beat4_24394ad0:

    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "哎呀，這場風暴真的開始猛烈起來了啊…"

# game/storybeat.rpy:1200
translate chinese_traditional story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "是的，外面的情況肯定很糟。"

# game/storybeat.rpy:1201
translate chinese_traditional story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "你還好嗎？"

# game/storybeat.rpy:1202
translate chinese_traditional story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "我很好，只是不想被鎖在房間裡以防停電…"

# game/storybeat.rpy:1203
translate chinese_traditional story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "啊，我也有同樣的想法。"

# game/storybeat.rpy:1204
translate chinese_traditional story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "無論如何我們也不能完成任何事情，對吧？"

# game/storybeat.rpy:1206
translate chinese_traditional story_beat4_64a8ddb7:

    # robin "Well, at least it gives us a chance to hang out together."
    robin "好吧，至少它給了我們一個一起出去玩的機會。"

# game/storybeat.rpy:1207
translate chinese_traditional story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "介意我跟你坐在一起嗎？"

# game/storybeat.rpy:1208
translate chinese_traditional story_beat4_b4dcea1a:

    # robin "Not at all, go ahead."
    robin "一點也不，繼續吧。"

# game/storybeat.rpy:1210
translate chinese_traditional story_beat4_8f6120d3:

    # "I plop down on the couch next to Robin and get comfortable."
    "我在羅賓旁邊的沙發上坐下來，感覺很舒服。"

# game/storybeat.rpy:1212
translate chinese_traditional story_beat4_9d413682:

    # robin "So, do you think the power is going to go out?"
    robin "那麼，你認為電力會消失嗎？"

# game/storybeat.rpy:1214
translate chinese_traditional story_beat4_94a704f7:

    # pro "Considering the way this storm is going, it's likely."
    pro "考慮到這場風暴的發展方式，這是可能的。"

# game/storybeat.rpy:1216
translate chinese_traditional story_beat4_7d0ca308:

    # robin "Hopefully not for long, though..."
    robin "但希望不會太久…"

# game/storybeat.rpy:1217
translate chinese_traditional story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "你有蠟燭或手電筒嗎？"

# game/storybeat.rpy:1219
translate chinese_traditional story_beat4_7590b815:

    # pro "Nope..."
    pro "沒有..."

# game/storybeat.rpy:1220
translate chinese_traditional story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "但公寓確實有一兩個連接到發電機的備用燈。"

# game/storybeat.rpy:1221
translate chinese_traditional story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "即使停電了，我們也應該有一些光，直到它重新打開。"

# game/storybeat.rpy:1223
translate chinese_traditional story_beat4_9546838f:

    # robin "That's good..."
    robin "那挺好的..."

# game/storybeat.rpy:1224
translate chinese_traditional story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "你知道嗎，我最近一直在思考一些事情。"

# game/storybeat.rpy:1226
translate chinese_traditional story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "哦？那是什麼？"

# game/storybeat.rpy:1228
translate chinese_traditional story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "嗯，嗯……也許現在是問你這個問題的好時機，因為我們已經在談論了。"

# game/storybeat.rpy:1230
translate chinese_traditional story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "呃呃，你具體指的是什麼？"

# game/storybeat.rpy:1232
translate chinese_traditional story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "還記得我在老地方告訴過你那個跟蹤狂的事嗎…"

# game/storybeat.rpy:1233
translate chinese_traditional story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "你知道，在海灘旅行中。"

# game/storybeat.rpy:1235
translate chinese_traditional story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "我當然記得。你在這裡見過他嗎？"

# game/storybeat.rpy:1237
translate chinese_traditional story_beat4_fcb99189:

    # robin "No, but..."
    robin "不，但是…"

# game/storybeat.rpy:1238
translate chinese_traditional story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "那天晚上，我聽到有人敲我們公寓的門。"

# game/storybeat.rpy:1240
translate chinese_traditional story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "搞什麼鬼？"

# game/storybeat.rpy:1241
translate chinese_traditional story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "你看過他們嗎？"

# game/storybeat.rpy:1243
translate chinese_traditional story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "不，但我真的嚇壞了。"

# game/storybeat.rpy:1244
translate chinese_traditional story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "萬一是同一個人呢？"

# game/storybeat.rpy:1245
translate chinese_traditional story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "如果他能夠找到我並且他只是—"

# game/storybeat.rpy:1247
translate chinese_traditional story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "嘿，沒關係。"

# game/storybeat.rpy:1248
translate chinese_traditional story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "就算是他，我也會在這裡保護你。"

# game/storybeat.rpy:1253
translate chinese_traditional story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "但如果他帶著其他人怎麼辦？"

# game/storybeat.rpy:1258
translate chinese_traditional story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "或試圖強行進入我們的公寓？"

# game/storybeat.rpy:1263
translate chinese_traditional story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "嘿，羅賓慢一點…"

# game/storybeat.rpy:1264
translate chinese_traditional story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "我保證這不會發生。"

# game/storybeat.rpy:1265
translate chinese_traditional story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "他們不知道你住在這裡..."

# game/storybeat.rpy:1266
translate chinese_traditional story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "我也在這裡，我會保護你。"

# game/storybeat.rpy:1268
translate chinese_traditional story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "他看著我微笑。"

# game/storybeat.rpy:1269
translate chinese_traditional story_beat4_531cbf7d:

    # robin "Okay..."
    robin "好的..."

# game/storybeat.rpy:1273
translate chinese_traditional story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "突然，房間裡一片漆黑。"

# game/storybeat.rpy:1276
translate chinese_traditional story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "我感覺羅賓抓住了我的胸口，倒在了我身上。"

# game/storybeat.rpy:1277
translate chinese_traditional story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "天哪，停電了！"

# game/storybeat.rpy:1279
translate chinese_traditional story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "他在發抖。我能感覺到他的心臟在我的胸口上狂跳。"

# game/storybeat.rpy:1280
translate chinese_traditional story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "沒關係，羅賓。我就在這裡。"

# game/storybeat.rpy:1284
translate chinese_traditional story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "過了一會兒，備用發電機啟動，沙發上方的昏暗燈光亮起。"

# game/storybeat.rpy:1285
translate chinese_traditional story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "R-羅賓..."

# game/storybeat.rpy:1286
translate chinese_traditional story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "他仍然抓著我的襯衫，呼吸沉重而驚慌。"

# game/storybeat.rpy:1287
translate chinese_traditional story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "抱歉，我只是..."

# game/storybeat.rpy:1288
translate chinese_traditional story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "我不喜歡待在黑暗中。"

# game/storybeat.rpy:1289
translate chinese_traditional story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "嘿，沒關係。你很安全，好嗎？"

# game/storybeat.rpy:1290
translate chinese_traditional story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "我不會讓任何不好的事情發生在你身上，我保證。"

# game/storybeat.rpy:1291
translate chinese_traditional story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "我能感覺到他的身體在慢慢放鬆，適應了昏暗的光線。"

# game/storybeat.rpy:1292
translate chinese_traditional story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "沒關係，我們只需要等待電源恢復。"

# game/storybeat.rpy:1293
translate chinese_traditional story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "抱歉，就這樣倒在你身上…"

# game/storybeat.rpy:1294
translate chinese_traditional story_beat4_af94f9cb:

    # pro "No worries..."
    pro "不用擔心..."

# game/storybeat.rpy:1297
translate chinese_traditional story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "他慢慢地從我身上下來，又坐了起來。"

# game/storybeat.rpy:1301
translate chinese_traditional story_beat4_294c5cbd:

    # "Robin looks so scared."
    "羅賓看起來很害怕。"

# game/storybeat.rpy:1302
translate chinese_traditional story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "他臉色蒼白，身體有些顫抖。"

# game/storybeat.rpy:1303
translate chinese_traditional story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "嘿，沒關係。"

# game/storybeat.rpy:1304
translate chinese_traditional story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "我確信電力很快就會恢復。"

# game/storybeat.rpy:1305
translate chinese_traditional story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "請記住，我就在你身邊。"

# game/storybeat.rpy:1306
translate chinese_traditional story_beat4_052f66f1:

    # robin "It's just..."
    robin "這只是..."

# game/storybeat.rpy:1307
translate chinese_traditional story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "那天晚上的敲門聲……感覺就像我又和那個跟蹤狂單獨在一起了。"

# game/storybeat.rpy:1309
translate chinese_traditional story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "聽起來很愚蠢，但這就是我的感覺..."

# game/storybeat.rpy:1311
translate chinese_traditional story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "這並不傻，羅賓。你完全有權利感到害怕。"

# game/storybeat.rpy:1312
translate chinese_traditional story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "那次經歷真的很痛苦，而你仍在處理它。"

# game/storybeat.rpy:1313
translate chinese_traditional story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "只要知道我在這裡等你就可以了，好嗎？"

# game/storybeat.rpy:1314
translate chinese_traditional story_beat4_425b462e:

    # robin "Right..."
    robin "正確的..."

# game/storybeat.rpy:1315
translate chinese_traditional story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "當有事情讓你害怕時通常會做什麼？"

# game/storybeat.rpy:1316
translate chinese_traditional story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "好吧，我想我只是想分散自己的注意力。"

# game/storybeat.rpy:1317
translate chinese_traditional story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "看一些電視或玩電子遊戲什麼的。"

# game/storybeat.rpy:1318
translate chinese_traditional story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "這些是我現在確實做不到的事......"

# game/storybeat.rpy:1320
translate chinese_traditional story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "想只是談談嗎？也許這會幫助我冷靜一點。"

# game/storybeat.rpy:1322
translate chinese_traditional story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "當然，你想談什麼？"

# game/storybeat.rpy:1323
translate chinese_traditional story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "好吧，我想我們可以談論任何事情。"

# game/storybeat.rpy:1324
translate chinese_traditional story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "怎麼樣……我們未來的計畫？"

# game/storybeat.rpy:1325
translate chinese_traditional story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "我們未來的計劃？"

# game/storybeat.rpy:1326
translate chinese_traditional story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "是的，就像我們看到一兩年後的自己一樣。"

# game/storybeat.rpy:1327
translate chinese_traditional story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "如果你願意的話我可以先走。"

# game/storybeat.rpy:1328
translate chinese_traditional story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "好的..."

# game/storybeat.rpy:1329
translate chinese_traditional story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "嗯，如你所知，我是一名獨立遊戲開發者。"

# game/storybeat.rpy:1330
translate chinese_traditional story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "我希望在今年年底之前發布我的專案的第一個版本。"

# game/storybeat.rpy:1331
translate chinese_traditional story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "如果一切順利，我希望能租得起工作室，在那裡我可以聘請一個團隊來幫助我製作遊戲！"

# game/storybeat.rpy:1333
translate chinese_traditional story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "哇，這真是太有野心了！"

# game/storybeat.rpy:1334
translate chinese_traditional story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "是的，但我已經在這款遊戲上工作了很長時間，所以很高興看到它取得成果。"

# game/storybeat.rpy:1335
translate chinese_traditional story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "太酷了，我為你感到興奮。"

# game/storybeat.rpy:1336
translate chinese_traditional story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "謝謝。是的，這就是我打算做的。"

# game/storybeat.rpy:1339
translate chinese_traditional story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "好吧，輪到我了。"

# game/storybeat.rpy:1340
translate chinese_traditional story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "好吧，我不太確定該怎麼說，但是......"

# game/storybeat.rpy:1341
translate chinese_traditional story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "沒關係，慢慢來。"

# game/storybeat.rpy:1342
translate chinese_traditional story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "我認為羅賓{color=#918fff}信任{/color}我，可以向我吐露心聲。"

# game/storybeat.rpy:1343
translate chinese_traditional story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "我想找一個人..."

# game/storybeat.rpy:1344
translate chinese_traditional story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "一個會為了我而愛我的人。"

# game/storybeat.rpy:1345
translate chinese_traditional story_beat4_a67d8108:

    # pro "Robin..."
    pro "羅賓..."

# game/storybeat.rpy:1346
translate chinese_traditional story_beat4_160fe2a1:

    # robin "Maybe that's a little too far ahead for me to be thinking about, but..."
    robin "也許這對我來說有點太遙遠了，但是..."

# game/storybeat.rpy:1347
translate chinese_traditional story_beat4_a1839a3e:

    # robin "It's always been a dream of mine to find someone, find a partner."
    robin "找到一個人，找到一個伴侶，一直是我的夢想。"

# game/storybeat.rpy:1348
translate chinese_traditional story_beat4_f205592d:

    # robin "Someone who really loves me and isn't just using me..."
    robin "一個真正愛我而不只是利用我的人..."

# game/storybeat.rpy:1349
translate chinese_traditional story_beat4_a30fb4c2:

    # robin "Since I'm a streamer, I rarely leave the house..."
    robin "因為我是主播，所以很少出門…"

# game/storybeat.rpy:1350
translate chinese_traditional story_beat4_dbc99b84:

    # robin "It's hard to meet people."
    robin "遇見人是很困難的。"

# game/storybeat.rpy:1351
translate chinese_traditional story_beat4_91ce40d6:

    # robin "Being sexualized all the time online also hasn't been good for my self-worth issues..."
    robin "一直在網路上被性化也對我的自我價值問題沒有好處..."

# game/storybeat.rpy:1354
translate chinese_traditional story_beat4_a972e603:

    # robin "It comes with the job, I guess."
    robin "我想它是隨著工作而來的。"

# game/storybeat.rpy:1355
translate chinese_traditional story_beat4_6ffbb649:

    # robin "But it's still hard to deal with."
    robin "但還是很難對付。"

# game/storybeat.rpy:1356
translate chinese_traditional story_beat4_4c3c3006:

    # pro "People online are horny idiots, don't let them get to you."
    pro "網路上的人都是好色的白痴，別讓他們影響你。"

# game/storybeat.rpy:1357
translate chinese_traditional story_beat4_e5bde556:

    # robin "I try not to, but it's hard."
    robin "我盡量不這麼做，但這很難。"

# game/storybeat.rpy:1358
translate chinese_traditional story_beat4_2097a78b:

    # robin "I just want to find someone who sees me for me."
    robin "我只是想找一個能替我看我的人。"

# game/storybeat.rpy:1361
translate chinese_traditional story_beat4_3e312a5b:

    # robin "I don't know... they just make me feel like I'm not worth anything."
    robin "我不知道……他們只是讓我覺得我一文不值。"

# game/storybeat.rpy:1362
translate chinese_traditional story_beat4_2d902c07:

    # robin "Like I'm just a piece of meat to them."
    robin "就像我對他們來說只是一塊肉一樣。"

# game/storybeat.rpy:1363
translate chinese_traditional story_beat4_606646c1:

    # pro "Wow, that's really fucked up."
    pro "哇，這真是完蛋了。"

# game/storybeat.rpy:1364
translate chinese_traditional story_beat4_fbe6a5e9:

    # robin "Yeah..."
    robin "是的..."

# game/storybeat.rpy:1366
translate chinese_traditional story_beat4_00875e63:

    # robin "A career on the internet has always been my dream, but now that it's become a reality..."
    robin "在網路上從事職業一直是我的夢想，但現在它已經成為現實..."

# game/storybeat.rpy:1367
translate chinese_traditional story_beat4_e54b5eed:

    # robin "I guess I'm just kind of lost."
    robin "我想我只是有點迷失了。"

# game/storybeat.rpy:1368
translate chinese_traditional story_beat4_d1b429f7:

    # robin "I don't know what I want to do anymore."
    robin "我不知道我想做什麼了。"

# game/storybeat.rpy:1369
translate chinese_traditional story_beat4_11c213ee:

    # pro "Hey, if you ever want to talk about anything like this..."
    pro "嘿，如果你想談論這樣的事情..."

# game/storybeat.rpy:1370
translate chinese_traditional story_beat4_1e05d98d:

    # pro "I'm always here for you, okay?"
    pro "我一直在你身邊，好嗎？"

# game/storybeat.rpy:1371
translate chinese_traditional story_beat4_e1baa4f9:

    # robin "Th-thanks. It means a lot to me."
    robin "謝謝。這對我來說意義重大。"

# game/storybeat.rpy:1372
translate chinese_traditional story_beat4_918aae24:

    # pro "You don't need to have your entire future figured out you know..."
    pro "你不需要弄清楚你的整個未來，你知道..."

# game/storybeat.rpy:1373
translate chinese_traditional story_beat4_a507a988:

    # pro "Sometimes things just happen unexpectedly."
    pro "有時事情會出乎意料地發生。"

# game/storybeat.rpy:1374
translate chinese_traditional story_beat4_e92b6384:

    # pro "Like us, we were complete strangers when you first moved in."
    pro "和我們一樣，當你剛搬進來時，我們也是完全陌生的。"

# game/storybeat.rpy:1375
translate chinese_traditional story_beat4_7464c56d:

    # pro "Now, you're one of the closest friends I have."
    pro "現在，你是我最親密的朋友之一。"

# game/storybeat.rpy:1376
translate chinese_traditional story_beat4_68d7b9aa:

    # robin "Yeah, that's true."
    robin "是的，確實如此。"

# game/storybeat.rpy:1378
translate chinese_traditional story_beat4_970ac64e:

    # robin "I'm glad we became friends."
    robin "我很高興我們成為朋友。"

# game/storybeat.rpy:1379
translate chinese_traditional story_beat4_4a8af8d0:

    # robin "You make me feel so... comfortable."
    robin "你讓我感覺如此……舒服。"

# game/storybeat.rpy:1380
translate chinese_traditional story_beat4_e7c88bc3:

    # robin "I don't know how you do it."
    robin "我不知道你是怎麼做到的。"

# game/storybeat.rpy:1381
translate chinese_traditional story_beat4_e82f048d:

    # pro "It's a gift."
    pro "這是一份禮物。"

# game/storybeat.rpy:1382
translate chinese_traditional story_beat4_fad03f8a:

    # "We laugh together, and for a moment the fear of the dark subsides."
    "我們一起笑，一時對黑暗的恐懼消退了。"

# game/storybeat.rpy:1385
translate chinese_traditional story_beat4_776782d0:

    # robin "Can I... ask you for something?"
    robin "我可以...向你求一件事嗎？"

# game/storybeat.rpy:1386
translate chinese_traditional story_beat4_087f9b10:

    # pro "Of course, what is it?"
    pro "當然，那是什麼？"

# game/storybeat.rpy:1387
translate chinese_traditional story_beat4_0f0aad54:

    # robin "If you wouldn't mind, can I sleep in your room tonight?"
    robin "如果你不介意的話，今晚我可以睡在你的房間嗎？"

# game/storybeat.rpy:1388
translate chinese_traditional story_beat4_d5239721:

    # robin "If the power doesn't come back on, of course!"
    robin "當然，如果電源沒有恢復的話！"

# game/storybeat.rpy:1391
translate chinese_traditional story_beat4_3fb05efa:

    # "His face flushes with embarrassment. It's adorable."
    "他的臉因尷尬而漲紅。很可愛。"

# game/storybeat.rpy:1392
translate chinese_traditional story_beat4_653a0356:

    # pro "Sure, you can sleep in my room with me."
    pro "當然，你可以和我一起睡在我的房間。"

# game/storybeat.rpy:1393
translate chinese_traditional story_beat4_03b2370e:

    # robin "Are you sure it isn't weird?"
    robin "你確定這不奇怪嗎？"

# game/storybeat.rpy:1394
translate chinese_traditional story_beat4_bf6fade1:

    # pro "Not at all!"
    pro "一點也不！"

# game/storybeat.rpy:1395
translate chinese_traditional story_beat4_d1d174a4:

    # pro "I just want you to feel safe."
    pro "我只是想讓你感到安全。"

# game/storybeat.rpy:1397
translate chinese_traditional story_beat4_c791b29e:

    # robin "Right... thank you. That means a lot to me."
    robin "對了……謝謝。這對我來說意義重大。"

# game/storybeat.rpy:1398
translate chinese_traditional story_beat4_ff1acfe7:

    # robin "You're the best."
    robin "你是最棒的。"

# game/storybeat.rpy:1399
translate chinese_traditional story_beat4_a6855880:

    # robin "Anyway, let's try and pass the time until the power comes back on!"
    robin "無論如何，讓我們試著打發時間，直到電源恢復！"

# game/storybeat.rpy:1401
translate chinese_traditional story_beat4_88861444:

    # "We the next few hours the night chatting and joking around."
    "接下來的幾個小時我們晚上聊天、開玩笑。"

# game/storybeat.rpy:1402
translate chinese_traditional story_beat4_e6c427fb:

    # "I know he's still afraid, but I'm glad Robin feels comfortable enough to talk and laugh with me."
    "我知道他仍然害怕，但我很高興羅賓感到很舒服，可以跟我說說笑笑。"

# game/storybeat.rpy:1403
translate chinese_traditional story_beat4_d87aa449:

    # pro "Hey, it's starting to get really late..."
    pro "哎呀，開始已經太晚了…"

# game/storybeat.rpy:1404
translate chinese_traditional story_beat4_ae625479:

    # pro "I say we call it and head to bed, don't think the power is going to come back anytime soon."
    pro "我說我們打電話去睡覺吧，我認為電力不會很快恢復。"

# game/storybeat.rpy:1405
translate chinese_traditional story_beat4_919f61cb:

    # robin "Oh, okay..."
    robin "哦好的..."

# game/storybeat.rpy:1406
translate chinese_traditional story_beat4_6b8abdd1:

    # robin "I guess I'm sleeping in your room tonight then, huh..."
    robin "我想今晚我會睡在你的房間裡，嗯..."

# game/storybeat.rpy:1407
translate chinese_traditional story_beat4_a0164f5c:

    # "He seems nervous."
    "他看起來很緊張。"

# game/storybeat.rpy:1408
translate chinese_traditional story_beat4_74a83be0:

    # pro "If you want, I can sleep on the floor or something-"
    pro "如果你願意的話，我可以睡在地板上什麼的──"

# game/storybeat.rpy:1409
translate chinese_traditional story_beat4_5f3c5ddc:

    # robin "If you don't mind... I'd actually like to sleep next to you."
    robin "如果你不介意的話...我其實很想睡在你旁邊。"

# game/storybeat.rpy:1410
translate chinese_traditional story_beat4_153fc70a:

    # robin "Your presence is really reassuring..."
    robin "有你的存在，真的讓人安心…"

# game/storybeat.rpy:1411
translate chinese_traditional story_beat4_88ba291b:

    # "I'm blushing furiously."
    "我氣得滿臉通紅。"

# game/storybeat.rpy:1412
translate chinese_traditional story_beat4_2afaa221:

    # pro "Y-yeah, I can sleep next to you if you want."
    pro "是的，如果你願意的話，我可以睡在你旁邊。"

# game/storybeat.rpy:1413
translate chinese_traditional story_beat4_93e42cf0:

    # robin "Thank you..."
    robin "謝謝..."

# game/storybeat.rpy:1414
translate chinese_traditional story_beat4_5d37e9ed:

    # robin "All right then, let's go to bed."
    robin "好吧，我們去睡覺吧。"

# game/storybeat.rpy:1415
translate chinese_traditional story_beat4_494dd562:

    # pro "Yeah, let's go."
    pro "是的，我們走吧。"

# game/storybeat.rpy:1416
translate chinese_traditional story_beat4_afc68d24:

    # "We enter my room and climb into my bed."
    "我們進入我的房間並爬上我的床。"

# game/storybeat.rpy:1420
translate chinese_traditional story_beat4_7f96ffc0:

    # "We lay in my bed together, my heart racing faster than I've ever felt it."
    "我們一起躺在床上，我的心跳得比以往任何時候都快。"

# game/storybeat.rpy:1421
translate chinese_traditional story_beat4_ca533191:

    # "Robin's ass is facing me, his body pressed up against mine."
    "羅賓的屁股正對著我，他的身體壓在我的身上。"

# game/storybeat.rpy:1422
translate chinese_traditional story_beat4_a19e15ef:

    # "Fuck... I really hope I can suppress my dirty thoughts."
    "操……真希望自己能壓抑住自己骯髒的念頭。"

# game/storybeat.rpy:1423
translate chinese_traditional story_beat4_a934ea41:

    # robin "This is nice..."
    robin "這很好..."

# game/storybeat.rpy:1424
translate chinese_traditional story_beat4_5b16d7fa:

    # pro "Y-yeah... I think so too."
    pro "是的……我也這麼認為。"

# game/storybeat.rpy:1425
translate chinese_traditional story_beat4_ccd2aeec:

    # "I can slowly feel a boner start to form in my pants."
    "我可以慢慢地感覺到我的褲子裡開始形成骨頭。"

# game/storybeat.rpy:1426
translate chinese_traditional story_beat4_9eef029d:

    # "I need to calm the fuck down."
    "我需要他媽的冷靜下來。"

# game/storybeat.rpy:1427
translate chinese_traditional story_beat4_713cb2fb:

    # "The feeling of his ass pressed up against my dick isn't helping either."
    "他的屁股壓在我雞巴上的感覺也無濟於事。"

# game/storybeat.rpy:1428
translate chinese_traditional story_beat4_4204685f:

    # robin "Your breathing is a little heavy, are you okay?"
    robin "你的呼吸有點粗重，沒事吧？"

# game/storybeat.rpy:1429
translate chinese_traditional story_beat4_74ca7df9:

    # pro "O-oh, I'm fine!"
    pro "哦哦，我很好！"

# game/storybeat.rpy:1430
translate chinese_traditional story_beat4_a5c360b5:

    # pro "Just uh... a little nervous."
    pro "只是呃……有點緊張。"

# game/storybeat.rpy:1431
translate chinese_traditional story_beat4_93c2d877:

    # robin "Nervous?"
    robin "緊張的？"

# game/storybeat.rpy:1432
translate chinese_traditional story_beat4_2fcc1caf:

    # pro "Yeah, it's fine! Don't worry about it!"
    pro "是啊，沒問題！別擔心！"

# game/storybeat.rpy:1434
translate chinese_traditional story_beat4_357e7314:

    # "Robin shifts his body and faces me."
    "羅賓移動身體面向我。"

# game/storybeat.rpy:1435
translate chinese_traditional story_beat4_1f485927:

    # "Holy shit, he's so close..."
    "天哪，他離得這麼近…"

# game/storybeat.rpy:1436
translate chinese_traditional story_beat4_f9d6d751:

    # robin "Sorry for falling on top of you earlier..."
    robin "對不起，剛才摔在你身上了…"

# game/storybeat.rpy:1437
translate chinese_traditional story_beat4_81d50e8c:

    # robin "You probably think I'm a total mess, huh?"
    robin "你可能認為我一團糟，對吧？"

# game/storybeat.rpy:1438
translate chinese_traditional story_beat4_0da6188e:

    # pro "I don't think you're a mess. You've been through a lot, you're allowed to be scared."
    pro "我不認為你是個爛攤子。你經歷了很多事情，你可以感到害怕。"

# game/storybeat.rpy:1440
translate chinese_traditional story_beat4_e3c1d2d0:

    # "He looks into my eyes and smiles sweetly."
    "他看著我的眼睛，甜甜地笑了。"

# game/storybeat.rpy:1441
translate chinese_traditional story_beat4_78405b1e:

    # robin "You mean a lot to me, you know that?"
    robin "你對我來說意義重大，你知道嗎？"

# game/storybeat.rpy:1442
translate chinese_traditional story_beat4_b784fb09:

    # robin "You're really kind and understanding and..."
    robin "你真的很善良，很善解人意，而且..."

# game/storybeat.rpy:1443
translate chinese_traditional story_beat4_6299b09e:

    # robin "You make me feel safe."
    robin "你讓我感到安全。"

# game/storybeat.rpy:1444
translate chinese_traditional story_beat4_6425addf:

    # pro "Well, I'm happy to hear that."
    pro "嗯，我很高興聽到這個消息。"

# game/storybeat.rpy:1445
translate chinese_traditional story_beat4_610f0b2f:

    # "I take a deep breath and try to relax."
    "我深吸一口氣，試著放鬆。"

# game/storybeat.rpy:1446
translate chinese_traditional story_beat4_6ec23e2b:

    # pro "I'll always be here for you, Robin. No matter what."
    pro "我會永遠在你身邊，羅賓。無論。"

# game/storybeat.rpy:1447
translate chinese_traditional story_beat4_43d64dd0:

    # robin "I know. It's just, after what happened at my old place..."
    robin "我知道。只是，在我老家發生了那件事之後…"

