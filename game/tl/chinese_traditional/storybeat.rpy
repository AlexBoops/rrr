    pro "聽起來像是個計劃！"

# game/storybeat.rpy:775
translate chinese_traditional story_beat3_93f7621f:

    # pro "Let's go check it out right now."
    pro "我們現在就去看看吧。"

# game/storybeat.rpy:776
translate chinese_traditional story_beat3_d9fcab1b:

    # robin "Oh, before we leave could you help me reapply my sunscreen?"
    robin "哦，我們離開之前你能幫我重新塗防曬霜嗎？"

# game/storybeat.rpy:777
translate chinese_traditional story_beat3_7fc54863:

    # pro "O-oh."
    pro "哦哦。"

# game/storybeat.rpy:778
translate chinese_traditional story_beat3_2fa062cd:

    # pro "Uh... sure."
    pro "呃...當然。"

# game/storybeat.rpy:779
translate chinese_traditional story_beat3_90a92da2:

    # robin "I wasn't able to reach my back properly at home, and I don't want to get sun burnt..."
    robin "我在家裡無法正常夠到背部，而且我不想被太陽曬傷......"

# game/storybeat.rpy:781
translate chinese_traditional story_beat3_5c6e5add:

    # "He rolls over and lays down on his stomach, taking off the straps of his swimsuit so I can get better coverage of his back."
    "他翻了個身，趴在地上，解開泳衣的帶子，這樣我就可以更好地覆蓋他的背部。"

# game/storybeat.rpy:782
