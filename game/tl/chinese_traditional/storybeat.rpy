    robin "我在一些直播中都會穿這件衣服。"

# game/storybeat.rpy:715
translate chinese_traditional story_beat3_e5a4b237:

    # pro "Why would you need to... oh."
    pro "為什麼你需要...哦。"

# game/storybeat.rpy:716
translate chinese_traditional story_beat3_ea890688:

