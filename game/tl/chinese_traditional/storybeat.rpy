    pro "我正在考慮去海灘。"

# game/storybeat.rpy:661
translate chinese_traditional story_beat3_34d6b100:

    # pro "It just wouldn't be much fun to go by myself."
    pro "自己一個人去的話就沒啥樂趣了。"

# game/storybeat.rpy:662
translate chinese_traditional story_beat3_da8de7fe:

    # pro "If you're free today and are up for it, maybe we could go on a little roommate-trip to the beach?"
    pro "如果你今天有空並且願意的話，也許我們可以和室友一起去海灘旅行？"

# game/storybeat.rpy:664
translate chinese_traditional story_beat3_67bbd811:

    # robin "R-really? You wanna hang out with me at the beach?"
    robin "真的嗎？你想和我一起去海灘玩嗎？"

# game/storybeat.rpy:665
translate chinese_traditional story_beat3_bfd658ed:

    # pro "Of course! I think it'd be fun to hang out with you outside of the apartment."
    pro "當然！我想和你在公寓外面玩會很有趣。"

# game/storybeat.rpy:667
translate chinese_traditional story_beat3_694c858e:

    # robin "Oh, uh..."
    robin "哦，呃..."

# game/storybeat.rpy:669
translate chinese_traditional story_beat3_1b58df0d:

    # robin "If you really wanna go with me, I'd love to join you!"
    robin "如果你真的想和我一起去，我很樂意和你一起去！"

# game/storybeat.rpy:670
translate chinese_traditional story_beat3_12f6a944:

    # pro "Great! I'll start packing some towels and sunscreen!"
    pro "偉大的！我要開始收拾一些毛巾和防曬乳了！"

# game/storybeat.rpy:671
translate chinese_traditional story_beat3_f86f83ad:

    # pro "You've got a swimsuit, right?"
    pro "你有泳衣吧？"

# game/storybeat.rpy:673
translate chinese_traditional story_beat3_7d23d48c:

    # robin "Oh shoot, I don't really have anything suitable for the weather."
    robin "喔天哪，我真的沒有適合這個天氣的東西。"

# game/storybeat.rpy:675
translate chinese_traditional story_beat3_8d7f38ec:

    # robin "The weather in New York is always so cold and rainy, so I've never really gone out and bought myself proper 'beach' clothes."
    robin "紐約的天氣總是那麼寒冷多雨，所以我從來沒有真正出去買過合適的「沙灘」衣服給自己。"

# game/storybeat.rpy:676
translate chinese_traditional story_beat3_471d539c:

    # pro "I may have an extra pair of swimming trunks if you want?"
    pro "如果您需要的話，我可以多帶一條泳褲嗎？"

# game/storybeat.rpy:677
translate chinese_traditional story_beat3_3e0d8030:

    # robin "No, it's okay!"
    robin "不，沒關係！"

# game/storybeat.rpy:679
translate chinese_traditional story_beat3_fbe73c71:

    # robin "There should be shops in the area that sell that kind of stuff, right?"
    robin "附近應該有賣這種東西的商店吧？"

# game/storybeat.rpy:680
translate chinese_traditional story_beat3_0c859106:

    # pro "Yeah, I think so."
    pro "是的，我想是的。"

# game/storybeat.rpy:681
translate chinese_traditional story_beat3_5ca036ce:

    # pro "I guess we can hit up the shops before the beach."
    pro "我想我們可以在去海灘之前先逛逛商店。"

# game/storybeat.rpy:683
translate chinese_traditional story_beat3_3c1ac1b6:

    # robin "Sounds like a plan!"
    robin "聽起來像是個計劃！"

# game/storybeat.rpy:684
translate chinese_traditional story_beat3_322ac24b:

