    pro "我懂了。"

# game/storybeat.rpy:717
translate chinese_traditional story_beat3_320ee121:

    # robin "Yeah, I was embarrassed by it, but I'd rather not spend any more money on a new one."
    robin "是的，我對此感到尷尬，但我不想再花更多的錢買新的了。"

# game/storybeat.rpy:718
translate chinese_traditional story_beat3_32f69d54:

    # robin "So, I'll just wear it for today."
    robin "所以，我今天就穿它。"

# game/storybeat.rpy:719
translate chinese_traditional story_beat3_388b4c5b:

    # pro "It's really, really cute. I think it suits you!"
    pro "真的非常非常可愛。我覺得很適合你！"

# game/storybeat.rpy:720
translate chinese_traditional story_beat3_6f484cc9:

    # robin "Hehe... thanks I guess."
    robin "呵呵...謝謝我猜。"

# game/storybeat.rpy:721
translate chinese_traditional story_beat3_8cc66c3e:

    # pro "Anyways, you all set Robin?"
    pro "無論如何，你們都安排羅賓了？"

# game/storybeat.rpy:722
translate chinese_traditional story_beat3_c8ffeb2c:

    # robin "Yeah, I think so. I packed sunscreen, some snacks, and a towel."
    robin "是的，我想是的。我帶了防曬霜、一些零食和一條毛巾。"

# game/storybeat.rpy:723
translate chinese_traditional story_beat3_bc8d0b95:

    # pro "Alright, let's head out!"
    pro "好吧，我們出發吧！"

# game/storybeat.rpy:726
