# game/script.rpy:95
translate korean start_48213e3e:

    # pro "A change of pace?"
    pro "속도의 변화?"

# game/script.rpy:97
translate korean start_d0c34081:

    # voice voiceline9
    # robin "Yeah..."
    voice voiceline9
    robin "응..."

# game/script.rpy:99
translate korean start_43c9059f:

    # voice voiceline10
    # robin "I, um, just needed a quiet place for my career."
    voice voiceline10
    robin "저는, 음, 단지 제 직업을 위해 조용한 장소가 필요했을 뿐이에요."

# game/script.rpy:101
translate korean start_d2fc0434:

    # voice voiceline11
    # robin "Somewhere where I don't have to worry about the problems that come with a big city."
    voice voiceline11
    robin "대도시에서 발생하는 문제에 대해 걱정할 필요가 없는 곳."

# game/script.rpy:103
translate korean start_3a775df7:

    # pro "Oh that makes sense."
    pro "아, 그렇군요."

# game/script.rpy:104
translate korean start_eea1ce3b:

    # pro "I've never really lived in a big city before, so I guess I wouldn't know what it's like."
    pro "저는 대도시에 살아본 적이 없어서 그곳이 어떤지 잘 몰랐을 것 같아요."

# game/script.rpy:105
translate korean start_0b6b382d:

    # voice voiceline12
    # robin "It's not all bad, but it's definitely not for everyone."
    voice voiceline12
    robin "모두 나쁜 것은 아니지만 확실히 모든 사람에게 적합한 것은 아닙니다."

# game/script.rpy:107
translate korean start_420bb9ed:

    # pro "I can imagine."
    pro "나는 상상할 수 있다."

# game/script.rpy:109
translate korean start_549333f9:

    # "We set down the boxes in his room while continuing our conversation."
    "우리는 대화를 계속하면서 그의 방에 상자를 내려 놓았습니다."

# game/script.rpy:111
translate korean start_0d3f177d:

    # pro "So what do you do for work?"
    pro "그럼 일을 위해 무엇을 하시나요?"

# game/script.rpy:112
translate korean start_0ee723c5:

    # voice voiceline13
    # robin "I uh..."
    voice voiceline13
    robin "난 어..."

# game/script.rpy:114
translate korean start_efafffc3:

    # voice voiceline14
    # robin "W-work from home."
    voice voiceline14
    robin "W-집에서 일해요."

# game/script.rpy:116
translate korean start_03d69cac:

    # pro "Oh that's convenient, I'm in the same sort of situation myself."
    pro "아 편리하네요 저도 딱 그런 상황이네요."

# game/script.rpy:117
translate korean start_d4d32ad5:

    # pro "I'm an indie game dev, so I basically can work from wherever I want provided I have my computer and an internet connection."
    pro "저는 인디 게임 개발자이기 때문에 기본적으로 컴퓨터와 인터넷 연결만 있으면 어디에서나 작업할 수 있습니다."

# game/script.rpy:119
translate korean start_d8c089ef:

    # voice voiceline15
    # robin "Wow, that's so cool!"
    voice voiceline15
    robin "와, 정말 멋지네요!"

# game/script.rpy:121
translate korean start_4f42f31f:

    # voice voiceline16
    # robin "A game developer seems like a dream job to be honest."
    voice voiceline16
    robin "게임 개발자는 솔직히 말해서 꿈의 직업처럼 보입니다."

# game/script.rpy:123
translate korean start_4e92ab7a:

    # pro "Eh, it's alright. Not the most stable career I could be in, but I've always wanted to make games and I finally got my opportunity to do so."
    pro "아, 괜찮아요. 제가 할 수 있는 가장 안정적인 직업은 아니지만, 저는 항상 게임을 만들고 싶었고 마침내 그렇게 할 수 있는 기회를 얻었습니다."

# game/script.rpy:124
translate korean start_df40652f:

    # voice voiceline17
    # robin "What were you doing before this?"
    voice voiceline17
    robin "이 전에는 무엇을 하고 있었나요?"

# game/script.rpy:126
translate korean start_c7e3aeb3:

    # pro "I was working as a software engineer for a big tech company."
    pro "저는 큰 기술 회사에서 소프트웨어 엔지니어로 일하고 있었습니다."

# game/script.rpy:127
translate korean start_ef47dfa2:

    # pro "I didn't like the corporate environment, so I decided to go indie and make my own games."
    pro "저는 회사 환경이 마음에 들지 않아서 인디로 가서 나만의 게임을 만들기로 결정했습니다."

# game/script.rpy:128
translate korean start_12532baa:

    # voice voiceline18
    # robin "That's really brave of you."
    voice voiceline18
    robin "정말 용감한 분이군요."

# game/script.rpy:130
translate korean start_ab4f135f:

    # pro "Thanks, I guess."
    pro "고마워요."

# game/script.rpy:132
translate korean start_a8ce8053:

    # "We finished unpacking Robin's belongings."
    "우리는 로빈의 소지품 풀기를 마쳤습니다."

# game/script.rpy:135
translate korean start_d881c139:

    # voice voiceline19
    # robin "Thank you for your help [protagonist_name]."
    voice voiceline19
    robin "도움을 주셔서 감사합니다 [protagonist_name]."

# game/script.rpy:137
translate korean start_155288c7:

    # voice voiceline20
    # robin "I really appreciate it, I've never really moved to a new place all on my own before so I was a little nervous."
    voice voiceline20
    robin "정말 고마워요. 저는 이전에 혼자서 새로운 곳으로 이사해 본 적이 없어서 조금 긴장했어요."

# game/script.rpy:139
translate korean start_5fefea31:

    # pro "No problem! Is there anything else you need help with?"
    pro "괜찮아요! 그 밖에 도움이 필요한 것이 있나요?"

# game/script.rpy:141
translate korean start_f5d9e168:

    # voice voiceline21
    # robin "Um, no I think that was everything..."
    voice voiceline21
    robin "음, 아니 그게 전부였던 것 같아요..."

# game/script.rpy:144
translate korean start_5835cd3b:

    # pro "Well if you need anything, I'll be in my room."
    pro "뭐 필요한 게 있으면 내 방에 있을게요."

# game/script.rpy:145
translate korean start_de544ff9:

    # voice voiceline22
    # robin "O-okay. I'll let you know if I do."
    voice voiceline22
