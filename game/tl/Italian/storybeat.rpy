    robin "Speriamo non per molto, però..."

# game/storybeat.rpy:1217
translate italian story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "Hai candele o torce elettriche?"

# game/storybeat.rpy:1219
translate italian story_beat4_7590b815:

    # pro "Nope..."
    pro "No..."

# game/storybeat.rpy:1220
