    pro "Ah, ho avuto la stessa idea."

# game/storybeat.rpy:1204
translate italian story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "Non è che riusciremo comunque a fare qualcosa, giusto?"

# game/storybeat.rpy:1206
