    robin "Pensavo che sarebbe stata una città più piccola e nessuno mi avrebbe disturbato."

# game/storybeat.rpy:1109
translate italian story_beat3_010bc1b8:

    # pro "I'm so sorry you had to go through that, Robin."
    pro "Mi dispiace tanto che tu abbia dovuto affrontare tutto questo, Robin."

# game/storybeat.rpy:1110
