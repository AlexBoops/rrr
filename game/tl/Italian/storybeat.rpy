    robin "Mi fido di te, ma non sono sicuro di fidarmi di me stesso..."

# game/storybeat.rpy:2384
translate italian story_beat6_c3135f5b:

    # robin "I can't think clearly... I don't want to make the wrong decision, but I don't know what to do..."
    robin "Non riesco a pensare chiaramente... non voglio prendere la decisione sbagliata, ma non so cosa fare..."

# game/storybeat.rpy:2385
