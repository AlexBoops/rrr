    # robin "I... I want to forget he ever existed and hope I never see his face again."
    robin "Io... voglio dimenticare che sia mai esistito e spero di non rivedere mai più la sua faccia."

# game/storybeat.rpy:2468
translate italian ending1_697e8cb8:

    # pro "I know you do, but if you just run away from it..."
    pro "Lo so, ma se scappi da tutto ciò..."

# game/storybeat.rpy:2469
translate italian ending1_fa132311:

    # pro "It will always be looming over your head. And it will always have its hooks in you, tugging at you, tormenting you."
    pro "Sarà sempre incombente sulla tua testa. E avrà sempre i suoi ganci dentro di te, che ti strattoneranno, ti tormenteranno."

# game/storybeat.rpy:2470
translate italian ending1_cd0fa110:

    # robin "But... I'm so afraid. I can barely even imagine facing him alone."
    robin "Ma... ho tanta paura. Riesco a malapena a immaginare di affrontarlo da solo."

# game/storybeat.rpy:2471
