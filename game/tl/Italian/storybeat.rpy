    # pro "Robin, listen to me."
    pro "Robin, ascoltami."

# game/storybeat.rpy:2460
translate italian ending1_56251f37:

    # pro "I'll confront him, if he even steps a foot near you I'll kick his fucking ass."
    pro "Lo affronterò, se fa anche solo un passo vicino a te gli prendo a calci in culo."

# game/storybeat.rpy:2461
translate italian ending1_30fd2c14:

    # pro "I'm done letting this stupid stalker psychologically torture you like this."
    pro "Ho smesso di permettere a questo stupido stalker di torturarti psicologicamente in questo modo."

# game/storybeat.rpy:2462
translate italian ending1_fd1949ec:

    # pro "Let's take this fucker down."
    pro "Portiamo giù questo stronzo."

# game/storybeat.rpy:2463
translate italian ending1_b3d003e8:

    # pro "If anything, this could be an opportunity."
    pro "Semmai questa potrebbe essere un'opportunità."

# game/storybeat.rpy:2464
translate italian ending1_26bad9f7:

    # pro "We could set a trap, bait him into making the first move, and get the police involved."
    pro "Potremmo tendere una trappola, indurlo a fare la prima mossa e coinvolgere la polizia."

# game/storybeat.rpy:2465
translate italian ending1_75bfb15e:

    # robin "What..."
    robin "Che cosa..."

# game/storybeat.rpy:2466
translate italian ending1_7ad18170:

    # pro "Don't you want him to face justice? Don't you want him to rot away in a cell for being such a scumbag?"
    pro "Non vuoi che affronti la giustizia? Non vuoi che marcisca in una cella perché è un tale pezzo di merda?"

