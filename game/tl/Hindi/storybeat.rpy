translate hindi story_beat3_3125e9b2:

    # robin "He almost..."
    robin "वह लगभग..."

# game/storybeat.rpy:1092
translate hindi story_beat3_17e44e10:

    # pro "Jesus fucking Christ."
    pro "यीशु मसीह को चोद रहा है।"

# game/storybeat.rpy:1093
translate hindi story_beat3_cce5a599:

    # pro "Did you call the cops?"
    pro "क्या आपने पुलिस को बुलाया?"

# game/storybeat.rpy:1094
translate hindi story_beat3_13f66967:

    # robin "No, I couldn't."
    robin "नहीं, मैं नहीं कर सका."

# game/storybeat.rpy:1095
translate hindi story_beat3_99d7f078:

    # robin "He threatened to tell everyone where I lived and..."
    robin "उसने धमकी दी कि वह सबको बता देगा कि मैं कहां रहता हूं और..."

# game/storybeat.rpy:1096
translate hindi story_beat3_cd6e7200:

    # robin "I didn't want to risk it."
    robin "मैं इसे जोखिम में नहीं डालना चाहता था."

# game/storybeat.rpy:1099
translate hindi story_beat3_08898ad9:

    # pro "Oh my god, Robin..."
    pro "हे भगवान, रॉबिन..."

# game/storybeat.rpy:1100
translate hindi story_beat3_0eb0f0f7:

    # pro "That's horrible, I'm so sorry."
    pro "यह भयानक है, मुझे बहुत खेद है।"

# game/storybeat.rpy:1103
translate hindi story_beat3_f81922f9:

    # robin "It's okay, I just..."
    robin "यह ठीक है, मैं बस..."

# game/storybeat.rpy:1104
translate hindi story_beat3_4342c269:

    # robin "I had to get out of there."
    robin "मुझे वहां से निकलना पड़ा."

# game/storybeat.rpy:1105
translate hindi story_beat3_af3a8aec:

    # robin "That's why I came here."
    robin "इसीलिए मैं यहां आया हूं.'"

# game/storybeat.rpy:1108
translate hindi story_beat3_9f244daa:

    # robin "I figured it would be a smaller town, and nobody would bother me."
    robin "मुझे लगा कि यह एक छोटा शहर होगा और कोई भी मुझे परेशान नहीं करेगा।"

# game/storybeat.rpy:1109
translate hindi story_beat3_010bc1b8:

    # pro "I'm so sorry you had to go through that, Robin."
    pro "मुझे बहुत खेद है कि तुम्हें इससे गुजरना पड़ा, रॉबिन।"

# game/storybeat.rpy:1110
translate hindi story_beat3_6ae03e37:

    # pro "No one should ever have to go through that."
    pro "किसी को भी इससे गुज़रना नहीं चाहिए।"

# game/storybeat.rpy:1111
translate hindi story_beat3_1c5043fa:

    # robin "It's fine, really."
    robin "यह सचमुच ठीक है।"

# game/storybeat.rpy:1112
translate hindi story_beat3_8d0fa7f5:

    # robin "It's kind of nice getting it off my chest..."
    robin "इसे मेरे सीने से उतारना एक तरह से अच्छा है..."

# game/storybeat.rpy:1113
translate hindi story_beat3_17c9c130:

    # robin "I just hate being..."
    robin "मुझे बस होने से नफरत है..."

# game/storybeat.rpy:1114
translate hindi story_beat3_f1fe2452:

    # robin "So weak."
    robin "इतनी कमजोर।"

# game/storybeat.rpy:1118
translate hindi story_beat3_cbb7b812:

    # robin "I don't know..."
    robin "मुझें नहीं पता..."

# game/storybeat.rpy:1119
translate hindi story_beat3_fd49e948:

    # robin "I'm just worried that the stalker will eventually find me again..."
    robin "मुझे बस इस बात की चिंता है कि पीछा करने वाला अंततः मुझे फिर से ढूंढ लेगा..."

# game/storybeat.rpy:1120
translate hindi story_beat3_c413cfa0:

    # robin "And that if he does, I won't be able to get away."
    robin "और अगर वह ऐसा करेगा तो मैं बच नहीं पाऊंगा।"

# game/storybeat.rpy:1123
translate hindi story_beat3_27f13eb3:

    # pro "Robin, I'll protect you."
    pro "रॉबिन, मैं तुम्हारी रक्षा करूंगा।"

# game/storybeat.rpy:1124
translate hindi story_beat3_cfe2a155:

    # pro "If the stalker or anyone else comes after you, I'll be there."
    pro "यदि पीछा करने वाला या कोई और तुम्हारे पीछे आएगा, तो मैं वहाँ पहुँच जाऊँगा।"

# game/storybeat.rpy:1125
translate hindi story_beat3_dc6a7198:

    # robin "I..."
    robin "मैं..."

# game/storybeat.rpy:1127
translate hindi story_beat3_02747ec1:

    # robin "That means a lot to me, thank you."
    robin "यह मेरे लिए बहुत मायने रखता है, धन्यवाद।"

# game/storybeat.rpy:1129
translate hindi story_beat3_315bc637:

    # system "Robin {color=#918fff}trusts{/color} you a {color=#8AFF59}little bit{/color} more now."
    system "रॉबिन अब आप पर {color=#918fff}भरोसा{/color} {color=#8AFF59}थोड़ा सा{/color} अधिक कर रहा है।"

# game/storybeat.rpy:1134
translate hindi story_beat3_6846f444:

    # "I want to hug him."
    "मैं उसे गले लगाना चाहता हूं."

# game/storybeat.rpy:1135
translate hindi story_beat3_d1f38b56:

    # "I want to hold him and tell him that everything will be okay."
    "मैं उसे पकड़कर कहना चाहता हूं कि सबकुछ ठीक हो जाएगा।"

# game/storybeat.rpy:1136
translate hindi story_beat3_e246420e:

    # robin "Um..."
    robin "उम्म..."

# game/storybeat.rpy:1137
translate hindi story_beat3_8e078ddb:

    # robin "I'm kind of tired, so if you want to go back that's fine."
    robin "मैं थोड़ा थका हुआ हूं, इसलिए यदि आप वापस जाना चाहते हैं तो कोई बात नहीं।"

# game/storybeat.rpy:1138
translate hindi story_beat3_2b31c75a:

    # pro "Oh, right."
    pro "अरे हां।"

# game/storybeat.rpy:1139
translate hindi story_beat3_93d5acac:

    # pro "Yeah, we should definitely go back."
    pro "हाँ, हमें निश्चित रूप से वापस जाना चाहिए।"

# game/storybeat.rpy:1140
translate hindi story_beat3_1c380cc3:

    # robin "Okay, let's pack up and go."
    robin "ठीक है, चलो सामान पैक करो और चलो।"

# game/storybeat.rpy:1142
translate hindi story_beat3_2bffde70:

    # robin "Thanks for listening and letting me talk about this."
    robin "सुनने और मुझे इस बारे में बात करने का मौका देने के लिए धन्यवाद।"

# game/storybeat.rpy:1144
translate hindi story_beat3_cbf3d343:

    # "We pack up and head back to the car."
    "हम सामान पैक करते हैं और कार में वापस चले जाते हैं।"

# game/storybeat.rpy:1145
translate hindi story_beat3_7d12e478:

    # robin "This was a good day, wasn't it?"
    robin "यह एक अच्छा दिन था, है ना?"

# game/storybeat.rpy:1146
translate hindi story_beat3_677d0104:

    # pro "Definitely, one of the best days we've had."
    pro "निश्चित रूप से, हमारे सबसे अच्छे दिनों में से एक।"

# game/storybeat.rpy:1147
translate hindi story_beat3_a5ac5a61:

    # robin "Yeah, I'm glad I decided to come here."
    robin "हां, मुझे खुशी है कि मैंने यहां आने का फैसला किया।"

# game/storybeat.rpy:1148
translate hindi story_beat3_5082b2c1:

    # "I'm glad he came here."
    "मुझे खुशी है कि वह यहां आये."

# game/storybeat.rpy:1149
translate hindi story_beat3_f9dff4cb:

    # "We drive back, the radio playing softly in the background."
    "हम वापस गाड़ी चलाते हैं, पृष्ठभूमि में रेडियो धीरे-धीरे बज रहा है।"

# game/storybeat.rpy:1150
translate hindi story_beat3_1aeb4c2b:

    # "I'm still processing what Robin told me."
    "रॉबिन ने मुझे जो बताया, मैं अभी भी उस पर काम कर रहा हूं।"

# game/storybeat.rpy:1151
translate hindi story_beat3_eff7bc22:

    # "God, what a fucking asshole."
    "भगवान, क्या बकवास है।"

# game/storybeat.rpy:1152
translate hindi story_beat3_3b4179f0:

    # "I can't believe someone would do that to him."
    "मैं विश्वास नहीं कर सकता कि कोई उसके साथ ऐसा करेगा।"

# game/storybeat.rpy:1153
translate hindi story_beat3_7052fe1a:

    # "Robin is so sweet and innocent, it makes me sick to think that people would prey on him like that."
    "रॉबिन इतना प्यारा और मासूम है कि मुझे यह सोचकर घबराहट होती है कि लोग उसका इस तरह शिकार करेंगे।"

# game/storybeat.rpy:1154
translate hindi story_beat3_c870ddbb:

    # "I need to protect him."
    "मुझे उसकी रक्षा करने की जरूरत है."

# game/storybeat.rpy:1156
translate hindi story_beat3_c33f0da3:

    # "After a short drive, we arrive home and head inside our apartment."
    "एक छोटी सी ड्राइव के बाद, हम घर पहुँचे और अपने अपार्टमेंट के अंदर चले गए।"

# game/storybeat.rpy:1158
translate hindi story_beat3_af480cf8:

    # robin "Well, I'm going to take a shower and then head to bed."
    robin "खैर, मैं स्नान करने जा रहा हूं और फिर बिस्तर पर जाऊंगा।"

# game/storybeat.rpy:1159
translate hindi story_beat3_f241d8fd:

    # robin "Today was a lot of fun, thanks again for everything."
    robin "आज बहुत मज़ा आया, हर चीज़ के लिए फिर से धन्यवाद।"

# game/storybeat.rpy:1160
translate hindi story_beat3_c4b65fe1:

    # pro "Of course, I'm glad we got to spend the day together."
    pro "बेशक, मुझे खुशी है कि हमें एक साथ दिन बिताने का मौका मिला।"

# game/storybeat.rpy:1161
translate hindi story_beat3_1c7aa342:

    # robin "Me too, goodnight."
    robin "मुझे भी, शुभ रात्रि।"

# game/storybeat.rpy:1162
translate hindi story_beat3_44d8b4ac:

    # pro "Goodnight."
    pro "शुभ रात्रि।"

# game/storybeat.rpy:1164
translate hindi story_beat3_5ab325d5:

    # "I watch him walk into the bathroom and hear the shower turn on."
    "मैं उसे बाथरूम में जाते हुए देखता हूं और शॉवर चालू होने की आवाज सुनता हूं।"

# game/storybeat.rpy:1166
translate hindi story_beat3_419d1b09:

    # "I enter my room and pass out immediately after I lay down on my bed."
    "मैं अपने कमरे में प्रवेश करता हूं और अपने बिस्तर पर लेटते ही बेहोश हो जाता हूं।"

# game/storybeat.rpy:1167
translate hindi story_beat3_d2b847d3:

    # "Today was fun but exhausting."
    "आज का दिन मज़ेदार था लेकिन थका देने वाला था।"

# game/storybeat.rpy:1172
translate hindi story_beat3_17b738de:

    # system "{color=#FF5454}Progression Level{/color} has increased"
    system "{color=#FF5454}प्रगति स्तर{/color} बढ़ गया है"

# game/storybeat.rpy:1190
translate hindi story_beat4_aa0d0ae2:

    # "Fuck, there's a really bad thunderstorm outside..."
    "भाड़ में जाओ, बाहर बहुत तेज़ तूफ़ान चल रहा है..."

# game/storybeat.rpy:1191
translate hindi story_beat4_9526ab0f:

    # "I'm sitting at my desk, trying to focus on my work, but the lights keep flickering."
    "मैं अपने डेस्क पर बैठा हूं, अपने काम पर ध्यान केंद्रित करने की कोशिश कर रहा हूं, लेकिन लाइटें टिमटिमाती रहती हैं।"

# game/storybeat.rpy:1192
translate hindi story_beat4_2cb73df8:

    # pro "What if the power goes out...?"
    pro "अगर बिजली चली जाए तो क्या होगा...?"

# game/storybeat.rpy:1193
translate hindi story_beat4_fc3f0bec:

    # pro "Honestly I'm not even going to risk this..."
    pro "ईमानदारी से कहूं तो मैं यह जोखिम भी नहीं उठाऊंगा..."

# game/storybeat.rpy:1194
translate hindi story_beat4_49178709:

    # "I turn off my computer and unplug it from the outlets to prevent a sudden power surge."
    "मैं अपने कंप्यूटर को बंद कर देता हूं और अचानक बिजली बढ़ने से रोकने के लिए इसे आउटलेट से अनप्लग कर देता हूं।"

# game/storybeat.rpy:1195
translate hindi story_beat4_f599b714:

    # pro "I guess if I can't do work, I could try chilling in the living room..."
    pro "मुझे लगता है कि अगर मैं काम नहीं कर सकता, तो मैं लिविंग रूम में आराम करने की कोशिश कर सकता हूं..."

# game/storybeat.rpy:1197
translate hindi story_beat4_7a3e8f69:

    # "I leave my room and see Robin already sitting on the couch."
    "मैं अपने कमरे से बाहर निकलता हूं और देखता हूं कि रॉबिन पहले से ही सोफे पर बैठा है।"

# game/storybeat.rpy:1199
translate hindi story_beat4_24394ad0:

    # robin "Hey, this storm is really starting to ramp up huh..."
    robin "अरे, यह तूफ़ान सचमुच तेज़ होने लगा है..."

# game/storybeat.rpy:1200
translate hindi story_beat4_54c0f3bf:

    # pro "Yeah, it's definitely pretty bad out there."
    pro "हाँ, यह निश्चित रूप से वहाँ बहुत बुरा है।"

# game/storybeat.rpy:1201
translate hindi story_beat4_5fb822bb:

    # pro "How are you holding up?"
    pro "आपने किस तरह संभाला हुआ है?"

# game/storybeat.rpy:1202
translate hindi story_beat4_1ef6802b:

    # robin "I'm fine, just didn't want to be locked up in my room in case the power went out..."
    robin "मैं ठीक हूँ, बस बिजली चले जाने की स्थिति में अपने कमरे में बंद नहीं रहना चाहता..."

# game/storybeat.rpy:1203
translate hindi story_beat4_facdc90c:

    # pro "Ah, I had the same idea."
    pro "आह, मेरा भी यही विचार था।"

# game/storybeat.rpy:1204
translate hindi story_beat4_98595b97:

    # pro "It's not like we can get anything done anyway, right?"
    pro "ऐसा नहीं है कि हम किसी भी तरह कुछ भी कर सकते हैं, है ना?"

# game/storybeat.rpy:1206
translate hindi story_beat4_64a8ddb7:

    # robin "Well, at least it gives us a chance to hang out together."
    robin "खैर, कम से कम यह हमें एक साथ घूमने का मौका देता है।"

# game/storybeat.rpy:1207
translate hindi story_beat4_9b6ef14a:

    # pro "Mind if I sit with you then?"
    pro "ध्यान रहे अगर मैं तुम्हारे साथ बैठूं तो?"

# game/storybeat.rpy:1208
translate hindi story_beat4_b4dcea1a:

    # robin "Not at all, go ahead."
    robin "बिल्कुल नहीं, आगे बढ़ें."

# game/storybeat.rpy:1210
translate hindi story_beat4_8f6120d3:

    # "I plop down on the couch next to Robin and get comfortable."
    "मैं रॉबिन के बगल वाले सोफे पर बैठ जाता हूं और आराम से बैठ जाता हूं।"

# game/storybeat.rpy:1212
translate hindi story_beat4_9d413682:

    # robin "So, do you think the power is going to go out?"
    robin "तो, क्या आपको लगता है कि बिजली जाने वाली है?"

# game/storybeat.rpy:1214
translate hindi story_beat4_94a704f7:

    # pro "Considering the way this storm is going, it's likely."
    pro "जिस तरह से ये तूफ़ान चल रहा है उसे देखते हुए इसकी संभावना है."

# game/storybeat.rpy:1216
translate hindi story_beat4_7d0ca308:

    # robin "Hopefully not for long, though..."
    robin "हालाँकि, उम्मीद है कि लंबे समय तक नहीं..."

# game/storybeat.rpy:1217
translate hindi story_beat4_cdbb1e49:

    # robin "Do you have any candles or flashlights?"
    robin "क्या आपके पास कोई मोमबत्तियाँ या टॉर्च हैं?"

# game/storybeat.rpy:1219
translate hindi story_beat4_7590b815:

    # pro "Nope..."
    pro "नहीं..."

# game/storybeat.rpy:1220
translate hindi story_beat4_9199df78:

    # pro "But the apartment does have one or two backup lights that are hooked up to a generator."
    pro "लेकिन अपार्टमेंट में एक या दो बैकअप लाइटें हैं जो जनरेटर से जुड़ी हैं।"

# game/storybeat.rpy:1221
translate hindi story_beat4_99fe111e:

    # pro "Even if the power goes out, we should have some light until it comes back on."
    pro "अगर बिजली चली भी जाए तो उसके वापस आने तक हमारे पास कुछ रोशनी होनी चाहिए।"

# game/storybeat.rpy:1223
translate hindi story_beat4_9546838f:

    # robin "That's good..."
    robin "अच्छी बात है..."

# game/storybeat.rpy:1224
translate hindi story_beat4_387bf87f:

    # robin "You know, I've been thinking about something lately."
    robin "तुम्हें पता है, मैं हाल ही में कुछ के बारे में सोच रहा हूँ।"

# game/storybeat.rpy:1226
translate hindi story_beat4_e5150d67:

    # pro "Oh? What's that?"
    pro "ओह? वह क्या है?"

# game/storybeat.rpy:1228
translate hindi story_beat4_5292875c:

    # robin "Well, um... maybe this is a good time to ask you this since we're already talking."
    robin "अच्छा, उम्म... शायद यह आपसे यह पूछने का अच्छा समय है क्योंकि हम पहले से ही बात कर रहे हैं।"

# game/storybeat.rpy:1230
translate hindi story_beat4_23122fab:

    # pro "Uh huh, what are you referring to exactly?"
    pro "उह हुह, आप वास्तव में किसकी बात कर रहे हैं?"

# game/storybeat.rpy:1232
translate hindi story_beat4_06bc7a11:

    # robin "Remember how I told you about that stalker at my old place..."
    robin "याद रखें कि मैंने आपको अपनी पुरानी जगह पर उस स्टॉकर के बारे में कैसे बताया था..."

# game/storybeat.rpy:1233
translate hindi story_beat4_247d53fe:

    # robin "You know, at the beach trip."
    robin "तुम्हें पता है, समुद्र तट की यात्रा पर।"

# game/storybeat.rpy:1235
translate hindi story_beat4_edabcdbc:

    # pro "Of course I remember. Have you seen him around here or something?"
    pro "बेशक मुझे याद है. क्या तुमने उसे इधर-उधर देखा है या कुछ और?"

# game/storybeat.rpy:1237
translate hindi story_beat4_fcb99189:

    # robin "No, but..."
    robin "नहीं, लेकिन..."

# game/storybeat.rpy:1238
translate hindi story_beat4_205abf8d:

    # robin "The other night, I heard someone knock on our apartment door."
    robin "दूसरी रात, मैंने सुना कि कोई हमारे अपार्टमेंट का दरवाज़ा खटखटा रहा है।"

# game/storybeat.rpy:1240
translate hindi story_beat4_9af42d31:

    # pro "What the fuck?"
    pro "क्या बकवास है?"

# game/storybeat.rpy:1241
translate hindi story_beat4_917a3fe6:

    # pro "Did you get a look at them?"
    pro "क्या आपकी नज़र उन पर पड़ी?"

# game/storybeat.rpy:1243
translate hindi story_beat4_efb2cfa0:

    # robin "No, but I was really freaked out."
    robin "नहीं, लेकिन मैं सचमुच घबरा गया था।"

# game/storybeat.rpy:1244
translate hindi story_beat4_ea30bb63:

    # robin "What if it's the same guy?"
    robin "अगर यह वही लड़का हो तो क्या होगा?"

# game/storybeat.rpy:1245
translate hindi story_beat4_a11a4502:

    # robin "What if he was able to find me and he's just-"
    robin "क्या होगा अगर वह मुझे ढूंढने में सक्षम हो और वह बस-"

# game/storybeat.rpy:1247
translate hindi story_beat4_fc2d0705:

    # pro "Hey, it's okay."
    pro "अरे, यह ठीक है."

# game/storybeat.rpy:1248
translate hindi story_beat4_09ee27bc:

    # pro "Even if it's him, I'll be here to protect you."
    pro "भले ही वह वह ही क्यों न हो, मैं आपकी रक्षा के लिए यहां रहूंगा।"

# game/storybeat.rpy:1253
translate hindi story_beat4_4d08e9be:

    # robin "But what if he brings others with him?"
    robin "लेकिन अगर वह दूसरों को अपने साथ ले आए तो क्या होगा?"

# game/storybeat.rpy:1258
translate hindi story_beat4_7446d679:

    # robin "Or tries to force himself into our apartment?"
    robin "या जबरदस्ती हमारे अपार्टमेंट में घुसने की कोशिश करता है?"

# game/storybeat.rpy:1263
translate hindi story_beat4_306014b9:

    # pro "Hey, slow down Robin..."
    pro "अरे, रॉबिन धीरे करो..."

# game/storybeat.rpy:1264
translate hindi story_beat4_e883f529:

    # pro "I promise that won't happen."
    pro "मैं वादा करता हूं कि ऐसा नहीं होगा."

# game/storybeat.rpy:1265
translate hindi story_beat4_aaf2df2d:

    # pro "They don't know you live here..."
    pro "वे नहीं जानते कि आप यहाँ रहते हैं..."

# game/storybeat.rpy:1266
translate hindi story_beat4_7a45b696:

    # pro "And I'm here too, I'll protect you."
    pro "और मैं भी यहीं हूं, मैं तुम्हारी रक्षा करूंगा."

# game/storybeat.rpy:1268
translate hindi story_beat4_4d65bd03:

    # "He looks at me and smiles."
    "वह मेरी ओर देखता है और मुस्कुराता है।"

# game/storybeat.rpy:1269
translate hindi story_beat4_531cbf7d:

    # robin "Okay..."
    robin "ठीक है..."

# game/storybeat.rpy:1273
translate hindi story_beat4_69b537b0:

    # "Suddenly, the room goes pitch black."
    "अचानक कमरे में अंधेरा छा जाता है।"

# game/storybeat.rpy:1276
translate hindi story_beat4_cdfdacbe:

    # "I feel Robin grab my chest and fall on top of me."
    "मुझे लगता है कि रॉबिन ने मेरी छाती पकड़ ली है और मेरे ऊपर गिर गया है।"

# game/storybeat.rpy:1277
translate hindi story_beat4_821cd32e:

    # robin "Oh my god, the power went out!"
    robin "हे भगवान, बिजली चली गयी!"

# game/storybeat.rpy:1279
translate hindi story_beat4_fd08368f:

    # "He's shaking. I can feel his heart pounding against my chest."
    "वह कांप रहा है. मैं उसके दिल को अपनी छाती पर धड़कता हुआ महसूस कर सकता हूँ।"

# game/storybeat.rpy:1280
translate hindi story_beat4_8f42ae5c:

    # pro "It's okay, Robin. I'm right here."
    pro "यह ठीक है, रॉबिन। मैं बिल्कुल यहाँ हूँ।"

# game/storybeat.rpy:1284
translate hindi story_beat4_3bc9df68:

    # "After a few moments, the backup generator kicks in and a dim light above the couch turns on."
    "कुछ क्षणों के बाद, बैकअप जनरेटर चालू हो जाता है और सोफे के ऊपर एक मंद रोशनी चालू हो जाती है।"

# game/storybeat.rpy:1285
translate hindi story_beat4_7cc2e32e:

    # pro "R-robin..."
    pro "आर-रॉबिन..."

# game/storybeat.rpy:1286
translate hindi story_beat4_59635525:

    # "He's still gripping onto my shirt, his breathing heavy and panicked."
    "वह अभी भी मेरी शर्ट को पकड़े हुए है, उसकी सांसें भारी हैं और वह घबराया हुआ है।"

# game/storybeat.rpy:1287
translate hindi story_beat4_2a21316c:

    # robin "Sorry, I just..."
    robin "क्षमा करें, मैं बस..."

# game/storybeat.rpy:1288
translate hindi story_beat4_216d290a:

    # robin "I don't like being in the dark."
    robin "मुझे अंधेरे में रहना पसंद नहीं है."

# game/storybeat.rpy:1289
translate hindi story_beat4_9d1e7659:

    # pro "Hey, it's okay. You're safe, okay?"
    pro "अरे, यह ठीक है. आप सुरक्षित हैं, ठीक है?"

# game/storybeat.rpy:1290
translate hindi story_beat4_0fca7e6b:

    # pro "I won't let anything bad happen to you, I promise."
    pro "मैं तुम्हारे साथ कुछ भी बुरा नहीं होने दूँगा, मैं वादा करता हूँ।"

# game/storybeat.rpy:1291
translate hindi story_beat4_7f17a9e7:

    # "I can feel his body relaxing slowly as he gets used to the dim light."
    "मैं महसूस कर सकता हूं कि उसका शरीर धीरे-धीरे आराम कर रहा है क्योंकि उसे मंद रोशनी की आदत हो गई है।"

# game/storybeat.rpy:1292
translate hindi story_beat4_222fd6f0:

    # pro "It's okay, we just need to wait until the power comes back on."
    pro "यह ठीक है, हमें बस बिजली वापस आने तक इंतजार करना होगा।"

# game/storybeat.rpy:1293
translate hindi story_beat4_3351615d:

    # robin "S-sorry about falling on top of you like that..."
    robin "एस-तुम्हारे ऊपर इस तरह गिरने के लिए खेद है..."

# game/storybeat.rpy:1294
translate hindi story_beat4_af94f9cb:

    # pro "No worries..."
    pro "कोई चिंता नहीं..."

# game/storybeat.rpy:1297
translate hindi story_beat4_ec2c854c:

    # "He slowly gets off of me and sits up again."
    "वह धीरे-धीरे मेरे पास से उतरता है और फिर से बैठ जाता है।"

# game/storybeat.rpy:1301
translate hindi story_beat4_294c5cbd:

    # "Robin looks so scared."
    "रॉबिन बहुत डरा हुआ लग रहा है."

# game/storybeat.rpy:1302
translate hindi story_beat4_d9e308e6:

    # "His face is pale and he's shaking a little bit."
    "उसका चेहरा पीला पड़ गया है और वह थोड़ा कांप रहा है।"

# game/storybeat.rpy:1303
translate hindi story_beat4_fc2d0705_1:

    # pro "Hey, it's okay."
    pro "अरे, यह ठीक है."

# game/storybeat.rpy:1304
translate hindi story_beat4_7dd06f9b:

    # pro "I'm sure the power will be back on soon."
    pro "मुझे यकीन है कि बिजली जल्द ही वापस आ जाएगी।"

# game/storybeat.rpy:1305
translate hindi story_beat4_eac7b47a:

    # pro "And remember, I'm right here with you."
    pro "और याद रखना, मैं यहीं तुम्हारे साथ हूं।"

# game/storybeat.rpy:1306
translate hindi story_beat4_052f66f1:

    # robin "It's just..."
    robin "यह सिर्फ..."

# game/storybeat.rpy:1307
translate hindi story_beat4_e464d7c6:

    # robin "The knock on the door the other night... it felt like I was alone with that stalker all over again."
    robin "दूसरी रात दरवाज़े पर दस्तक हुई... ऐसा लगा जैसे मैं उस पीछा करने वाले के साथ फिर से अकेली थी।"

# game/storybeat.rpy:1309
translate hindi story_beat4_8927c4a2:

    # robin "It sounds dumb, but that's how I feel..."
    robin "यह मूर्खतापूर्ण लगता है, लेकिन मुझे ऐसा ही लगता है..."

# game/storybeat.rpy:1311
translate hindi story_beat4_57fb94c5:

    # pro "It's not dumb, Robin. You have every right to be scared."
    pro "यह मूर्खतापूर्ण नहीं है, रॉबिन। आपको डरने का पूरा अधिकार है."

# game/storybeat.rpy:1312
translate hindi story_beat4_019b8370:

    # pro "That experience was really traumatic, and you're still processing it."
    pro "वह अनुभव वास्तव में दर्दनाक था, और आप अभी भी इसे संसाधित कर रहे हैं।"

# game/storybeat.rpy:1313
translate hindi story_beat4_7d3c9c59:

    # pro "Just know that I'm here for you, okay?"
    pro "बस इतना जान लो कि मैं तुम्हारे लिए यहाँ हूँ, ठीक है?"

# game/storybeat.rpy:1314
translate hindi story_beat4_425b462e:

    # robin "Right..."
    robin "सही..."

# game/storybeat.rpy:1315
translate hindi story_beat4_163f216b:

    # robin "What do you usually do when something scares you?"
    robin "जब कोई चीज़ आपको डराती है तो आप आमतौर पर क्या करते हैं?"

# game/storybeat.rpy:1316
translate hindi story_beat4_04ef7531:

    # pro "Well, I guess I just try to distract myself."
    pro "खैर, मुझे लगता है कि मैं सिर्फ अपना ध्यान भटकाने की कोशिश करता हूं।"

# game/storybeat.rpy:1317
translate hindi story_beat4_7f0e2d37:

    # pro "Watch some TV or play a video game or something."
    pro "कुछ टीवी देखें या वीडियो गेम या कुछ और खेलें।"

# game/storybeat.rpy:1318
translate hindi story_beat4_61a13781:

    # robin "Those are things I can't really do right now though..."
    robin "हालाँकि ये ऐसी चीज़ें हैं जो मैं अभी नहीं कर सकता..."

# game/storybeat.rpy:1320
translate hindi story_beat4_328ae532:

    # robin "Want to just talk instead? Maybe that will help me calm down a little."
    robin "इसके बजाय सिर्फ बात करना चाहते हैं? शायद इससे मुझे थोड़ा शांत होने में मदद मिलेगी।"

# game/storybeat.rpy:1322
translate hindi story_beat4_b2e7892c:

    # pro "Sure, what do you want to talk about?"
    pro "ज़रूर, आप किस बारे में बात करना चाहते हैं?"

# game/storybeat.rpy:1323
translate hindi story_beat4_b6b06181:

    # robin "Well, we could talk about anything I guess."
    robin "ख़ैर, मुझे लगता है कि हम किसी भी चीज़ पर बात कर सकते हैं।"

# game/storybeat.rpy:1324
translate hindi story_beat4_12dd3317:

    # pro "How about... our future plans?"
    pro "हमारी भविष्य की योजनाएँ कैसी हैं?"

# game/storybeat.rpy:1325
translate hindi story_beat4_87bb497f:

    # robin "Our future plans?"
    robin "हमारी भविष्य की योजनाएँ?"

# game/storybeat.rpy:1326
translate hindi story_beat4_9575172e:

    # pro "Yeah, like where we see ourselves in a year or two."
    pro "हाँ, जैसा कि हम खुद को एक या दो साल में देखते हैं।"

# game/storybeat.rpy:1327
translate hindi story_beat4_2f4c5d63:

    # pro "I can go first, if you want."
    pro "यदि तुम चाहो तो मैं पहले जा सकता हूँ।"

# game/storybeat.rpy:1328
translate hindi story_beat4_531cbf7d_1:

    # robin "Okay..."
    robin "ठीक है..."

# game/storybeat.rpy:1329
translate hindi story_beat4_b5d3b805:

    # pro "Well, as you know, I'm an indie game developer."
    pro "खैर, जैसा कि आप जानते हैं, मैं एक इंडी गेम डेवलपर हूं।"

# game/storybeat.rpy:1330
translate hindi story_beat4_f07ef3b5:

    # pro "I'm hoping to have the first version of my project released by the end of this year."
    pro "मुझे उम्मीद है कि इस साल के अंत तक मेरे प्रोजेक्ट का पहला संस्करण रिलीज़ हो जाएगा।"

# game/storybeat.rpy:1331
translate hindi story_beat4_2fa922a3:

    # pro "If all goes well, I can hopefully afford to rent out a studio where I can hire a team to help me make my games!"
    pro "अगर सब कुछ ठीक रहा, तो मुझे उम्मीद है कि मैं एक स्टूडियो किराए पर ले सकूंगा जहां मैं अपने गेम बनाने में मदद के लिए एक टीम नियुक्त कर सकूंगा!"

# game/storybeat.rpy:1333
translate hindi story_beat4_4bb03c6d:

    # robin "Wow, that's really ambitious!"
    robin "वाह, यह सचमुच महत्वाकांक्षी है!"

# game/storybeat.rpy:1334
translate hindi story_beat4_c2cd1b55:

    # pro "Yeah, but I've been working on this game for a long time so it's exciting to see it come to fruition."
    pro "हाँ, लेकिन मैं इस खेल पर काफी समय से काम कर रहा हूँ इसलिए इसे साकार होते देखना रोमांचक है।"

# game/storybeat.rpy:1335
translate hindi story_beat4_ca3b979d:

    # robin "That's so cool, I'm excited for you."
    robin "यह बहुत अच्छा है, मैं आपके लिए उत्साहित हूं।"

# game/storybeat.rpy:1336
translate hindi story_beat4_7e4d92a1:

    # pro "Thanks. So yeah, that's what I plan on doing."
    pro "धन्यवाद। तो हाँ, मैं यही करने की योजना बना रहा हूँ।"

# game/storybeat.rpy:1339
translate hindi story_beat4_b9d977a5:

    # robin "Alright, my turn."
    robin "ठीक है, मेरी बारी."

# game/storybeat.rpy:1340
translate hindi story_beat4_d63ff168:

    # robin "Well, I'm not exactly sure how to say this but..."
    robin "खैर, मैं बिल्कुल निश्चित नहीं हूं कि यह कैसे कहूं लेकिन..."

# game/storybeat.rpy:1341
translate hindi story_beat4_a12a96d4:

    # pro "It's okay, take your time."
    pro "यह ठीक है, अपना समय लें।"

# game/storybeat.rpy:1342
translate hindi story_beat4_79554dbb:

    # "I think Robin {color=#918fff}trusts{/color} me enough to confide in me."
    "मुझे लगता है कि रॉबिन मुझ पर इतना {color=#918fff}भरोसा{/color} करता है कि वह मुझ पर भरोसा कर सके।"

# game/storybeat.rpy:1343
translate hindi story_beat4_36f9974b:

    # robin "I want to find someone..."
    robin "मैं किसी को ढूंढना चाहता हूं..."

# game/storybeat.rpy:1344
translate hindi story_beat4_b3ddb68b:

    # robin "Someone who will love me for me."
    robin "कोई है जो मेरे लिए मुझसे प्यार करेगा."

# game/storybeat.rpy:1345
translate hindi story_beat4_a67d8108:

    # pro "Robin..."
    pro "रोबिन..."

# game/storybeat.rpy:1346
translate hindi story_beat4_160fe2a1:

    # robin "Maybe that's a little too far ahead for me to be thinking about, but..."
    robin "हो सकता है कि मेरे लिए इस बारे में सोचना थोड़ा आगे की बात हो, लेकिन..."

# game/storybeat.rpy:1347
translate hindi story_beat4_a1839a3e:

    # robin "It's always been a dream of mine to find someone, find a partner."
    robin "मेरा हमेशा से एक सपना रहा है कि मैं किसी को ढूंढूं, कोई साथी ढूंढूं।"

# game/storybeat.rpy:1348
translate hindi story_beat4_f205592d:

    # robin "Someone who really loves me and isn't just using me..."
    robin "कोई है जो मुझसे सच्चा प्यार करता है और सिर्फ मेरा इस्तेमाल नहीं कर रहा..."

# game/storybeat.rpy:1349
translate hindi story_beat4_a30fb4c2:

    # robin "Since I'm a streamer, I rarely leave the house..."
    robin "चूंकि मैं सपने देखता हूं, इसलिए मैं घर से कम ही निकलता हूं..."

# game/storybeat.rpy:1350
translate hindi story_beat4_dbc99b84:

    # robin "It's hard to meet people."
    robin "लोगों से मिलना मुश्किल है."

# game/storybeat.rpy:1351
translate hindi story_beat4_91ce40d6:

    # robin "Being sexualized all the time online also hasn't been good for my self-worth issues..."
    robin "ऑनलाइन हर समय कामुकता का शिकार होना भी मेरे आत्मसम्मान के मुद्दों के लिए अच्छा नहीं है..."

# game/storybeat.rpy:1354
translate hindi story_beat4_a972e603:

    # robin "It comes with the job, I guess."
    robin "मुझे लगता है, यह नौकरी के साथ आता है।"

# game/storybeat.rpy:1355
translate hindi story_beat4_6ffbb649:

    # robin "But it's still hard to deal with."
    robin "लेकिन इससे निपटना अभी भी कठिन है।"

# game/storybeat.rpy:1356
translate hindi story_beat4_4c3c3006:

    # pro "People online are horny idiots, don't let them get to you."
    pro "ऑनलाइन लोग कामुक बेवकूफ होते हैं, उन्हें अपने पास न आने दें।"

# game/storybeat.rpy:1357
translate hindi story_beat4_e5bde556:

    # robin "I try not to, but it's hard."
    robin "मैं ऐसा न करने का प्रयास करता हूं, लेकिन यह कठिन है।"

# game/storybeat.rpy:1358
translate hindi story_beat4_2097a78b:

    # robin "I just want to find someone who sees me for me."
    robin "मैं बस किसी ऐसे व्यक्ति को ढूंढना चाहता हूं जो मुझे मेरे लिए देखे।"

# game/storybeat.rpy:1361
translate hindi story_beat4_3e312a5b:

    # robin "I don't know... they just make me feel like I'm not worth anything."
    robin "मैं नहीं जानता... वे मुझे बस ऐसा महसूस कराते हैं जैसे मैं किसी लायक नहीं हूं।"

# game/storybeat.rpy:1362
translate hindi story_beat4_2d902c07:

    # robin "Like I'm just a piece of meat to them."
    robin "जैसे मैं उनके लिए सिर्फ मांस का एक टुकड़ा हूं।"

# game/storybeat.rpy:1363
translate hindi story_beat4_606646c1:

    # pro "Wow, that's really fucked up."
    pro "वाह, यह सचमुच गड़बड़ है।"

# game/storybeat.rpy:1364
translate hindi story_beat4_fbe6a5e9:

    # robin "Yeah..."
    robin "हाँ..."

# game/storybeat.rpy:1366
translate hindi story_beat4_00875e63:

    # robin "A career on the internet has always been my dream, but now that it's become a reality..."
    robin "इंटरनेट पर करियर बनाना हमेशा से मेरा सपना रहा है, लेकिन अब यह हकीकत बन गया है..."

# game/storybeat.rpy:1367
translate hindi story_beat4_e54b5eed:

    # robin "I guess I'm just kind of lost."
    robin "मुझे लगता है कि मैं एक तरह से खो गया हूं।"

# game/storybeat.rpy:1368
translate hindi story_beat4_d1b429f7:

    # robin "I don't know what I want to do anymore."
    robin "मुझे नहीं पता कि मैं अब क्या करना चाहता हूं।"

# game/storybeat.rpy:1369
translate hindi story_beat4_11c213ee:

    # pro "Hey, if you ever want to talk about anything like this..."
    pro "अरे, अगर आप कभी इस तरह की किसी चीज़ के बारे में बात करना चाहें..."

# game/storybeat.rpy:1370
translate hindi story_beat4_1e05d98d:

    # pro "I'm always here for you, okay?"
    pro "मैं हमेशा तुम्हारे लिए यहाँ हूँ, ठीक है?"

# game/storybeat.rpy:1371
translate hindi story_beat4_e1baa4f9:

    # robin "Th-thanks. It means a lot to me."
    robin "थ-धन्यवाद. यह मेरे लिए बहुत मायने रखता है।"

# game/storybeat.rpy:1372
translate hindi story_beat4_918aae24:

    # pro "You don't need to have your entire future figured out you know..."
    pro "आपको अपना पूरा भविष्य तय करने की ज़रूरत नहीं है, आप जानते हैं..."

# game/storybeat.rpy:1373
translate hindi story_beat4_a507a988:

    # pro "Sometimes things just happen unexpectedly."
    pro "कभी-कभी चीजें अप्रत्याशित रूप से घटित होती हैं।"

# game/storybeat.rpy:1374
translate hindi story_beat4_e92b6384:

    # pro "Like us, we were complete strangers when you first moved in."
    pro "जब आप पहली बार यहां आए थे तो हमारी तरह हम भी बिल्कुल अजनबी थे।"

# game/storybeat.rpy:1375
translate hindi story_beat4_7464c56d:

    # pro "Now, you're one of the closest friends I have."
    pro "अब, तुम मेरे सबसे करीबी दोस्तों में से एक हो।"

# game/storybeat.rpy:1376
translate hindi story_beat4_68d7b9aa:

    # robin "Yeah, that's true."
    robin "हां, यह सही है।"

# game/storybeat.rpy:1378
translate hindi story_beat4_970ac64e:

    # robin "I'm glad we became friends."
    robin "मुझे ख़ुशी है कि हम दोस्त बन गये।"

# game/storybeat.rpy:1379
translate hindi story_beat4_4a8af8d0:

    # robin "You make me feel so... comfortable."
    robin "आप मुझे बहुत... आरामदायक महसूस कराते हैं।"

# game/storybeat.rpy:1380
translate hindi story_beat4_e7c88bc3:

    # robin "I don't know how you do it."
    robin "मैं नहीं जानता कि आप यह कैसे करते हैं."

# game/storybeat.rpy:1381
translate hindi story_beat4_e82f048d:

    # pro "It's a gift."
    pro "यह एक उपहार है."

# game/storybeat.rpy:1382
translate hindi story_beat4_fad03f8a:

    # "We laugh together, and for a moment the fear of the dark subsides."
    "हम एक साथ हंसते हैं और एक पल के लिए अंधेरे का डर कम हो जाता है।"

# game/storybeat.rpy:1385
translate hindi story_beat4_776782d0:

    # robin "Can I... ask you for something?"
    robin "क्या मैं आपसे कुछ मांग सकता हूँ?"

# game/storybeat.rpy:1386
translate hindi story_beat4_087f9b10:

    # pro "Of course, what is it?"
    pro "बेशक, यह क्या है?"

# game/storybeat.rpy:1387
translate hindi story_beat4_0f0aad54:

    # robin "If you wouldn't mind, can I sleep in your room tonight?"
    robin "यदि आप बुरा न मानें तो क्या मैं आज रात आपके कमरे में सो सकता हूँ?"

# game/storybeat.rpy:1388
translate hindi story_beat4_d5239721:

    # robin "If the power doesn't come back on, of course!"
    robin "यदि बिजली वापस नहीं आती, तो अवश्य!"

# game/storybeat.rpy:1391
translate hindi story_beat4_3fb05efa:

    # "His face flushes with embarrassment. It's adorable."
    "उसका चेहरा शर्मिंदगी से तमतमा उठता है। ये बहुत प्यारा है।"

# game/storybeat.rpy:1392
translate hindi story_beat4_653a0356:

    # pro "Sure, you can sleep in my room with me."
    pro "ज़रूर, तुम मेरे साथ मेरे कमरे में सो सकते हो।"

# game/storybeat.rpy:1393
translate hindi story_beat4_03b2370e:

    # robin "Are you sure it isn't weird?"
    robin "क्या आप निश्चित हैं कि यह अजीब नहीं है?"

# game/storybeat.rpy:1394
translate hindi story_beat4_bf6fade1:

    # pro "Not at all!"
    pro "बिल्कुल नहीं!"

# game/storybeat.rpy:1395
translate hindi story_beat4_d1d174a4:

    # pro "I just want you to feel safe."
    pro "मैं बस यही चाहता हूं कि आप सुरक्षित महसूस करें।"

# game/storybeat.rpy:1397
translate hindi story_beat4_c791b29e:

    # robin "Right... thank you. That means a lot to me."
    robin "ठीक है... धन्यवाद. इसका मतलब मेरे लिए बुहत सारे।"

# game/storybeat.rpy:1398
translate hindi story_beat4_ff1acfe7:

    # robin "You're the best."
    robin "आप सर्वश्रेष्ठ हैं।"

# game/storybeat.rpy:1399
translate hindi story_beat4_a6855880:

    # robin "Anyway, let's try and pass the time until the power comes back on!"
    robin "वैसे भी, जब तक बिजली वापस नहीं आती, आइए समय गुजारने का प्रयास करें!"

# game/storybeat.rpy:1401
translate hindi story_beat4_88861444:

    # "We the next few hours the night chatting and joking around."
    "हम अगले कुछ घंटों तक रात भर बातें करते रहे और मज़ाक करते रहे।"

# game/storybeat.rpy:1402
translate hindi story_beat4_e6c427fb:

