    robin "इसे भूल जाओ, चिंता मत करो..."

# game/storybeat.rpy:1047
translate hindi story_beat3_4dd3ce4b:

    # "What was he going to say?"
    "वह क्या कहने वाला था?"

# game/storybeat.rpy:1048
translate hindi story_beat3_a0a2bd06:

    # pro "Um, okay."
    pro "मैं ठीक हूं।"

# game/storybeat.rpy:1049
translate hindi story_beat3_ab4c7c06:

    # pro "Well, I'm glad you're feeling better."
    pro "खैर, मुझे खुशी है कि आप बेहतर महसूस कर रहे हैं।"

# game/storybeat.rpy:1054
translate hindi story_beat3_df54e5ca:

    # "We stare up at the sky and watch the clouds slowly move by."
    "हम आकाश की ओर देखते हैं और बादलों को धीरे-धीरे आते हुए देखते हैं।"

# game/storybeat.rpy:1055
translate hindi story_beat3_51e745d5:

    # pro "Hey Robin, can I ask you a personal question?"
    pro "हे रॉबिन, क्या मैं आपसे एक व्यक्तिगत प्रश्न पूछ सकता हूँ?"

