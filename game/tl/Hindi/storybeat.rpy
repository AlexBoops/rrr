    robin "उह, निश्चित रूप से।"

# game/storybeat.rpy:1057
translate hindi story_beat3_59d0db9d:

    # pro "What was the real reason you left your old place and moved way out here?"
    pro "आपके द्वारा अपना पुराना स्थान छोड़कर यहाँ चले आने का वास्तविक कारण क्या था?"

# game/storybeat.rpy:1058
translate hindi story_beat3_fa7ea6e8:

    # robin "Oh..."
    robin "ओह..."

# game/storybeat.rpy:1059
translate hindi story_beat3_46c2f64a:

    # robin "Um... well..."
    robin "उम्म... अच्छा..."

# game/storybeat.rpy:1060
translate hindi story_beat3_af936a96:

    # pro "It's okay if you don't want to talk about it."
    pro "यदि आप इसके बारे में बात नहीं करना चाहते तो कोई बात नहीं।"

# game/storybeat.rpy:1061
translate hindi story_beat3_7bebb2b5:

    # robin "No, it's okay..."
    robin "नहीं, सब ठीक है..."

# game/storybeat.rpy:1062
translate hindi story_beat3_5ac21870:

    # robin "I've never told anyone about this, but I guess I should talk about it."
    robin "मैंने इस बारे में कभी किसी को नहीं बताया, लेकिन मुझे लगता है कि मुझे इस बारे में बात करनी चाहिए।"

# game/storybeat.rpy:1063
translate hindi story_beat3_d1d0f557:

